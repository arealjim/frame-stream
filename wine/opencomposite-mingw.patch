+# MinGW builds (OOVR_MSVC_AGGREGATE_RETURNS=1): MinGW GCC passes a method's hidden struct-return pointer before `this`,
+# MSVC after it, so a struct-returning method is declared with an explicit return pointer, as Wine's widl does
+# (WIDL_EXPLICIT_AGGREGATE_RETURNS). Application interfaces only: drivers call the other way.
+aggregate_returns = os.environ.get("OOVR_MSVC_AGGREGATE_RETURNS") == "1"
+aggregate_types = set()
+
+
+def explicit_aggregate_return(line: str) -> str:
+    if not aggregate_returns:
+        return line
+    m = re.match(r"(\s*virtual\s+)(\w+)\s+(\w+)\s*\(\s*(.*)$", line, re.S)
+    if not m or m.group(2) not in aggregate_types:
+        return line
+    pre, typ, name, rest = m.groups()
+    sep = " " if rest.startswith(")") else ", "
+    return f"{pre}{typ} *{name}( {typ} *_ret{sep}{rest}"
+
+
 def split_header(headerfile: TextIO, interface_checker: Callable = None,
                  out_dir: Path = output_dir / "interfaces", imports=None):
     """
@@ -286,7 +305,7 @@ def split_header(headerfile: TextIO, interface_checker: Callable = None,
         if niceline == "namespace vr":
             outbuff.write("%%REPLACE%NS%START%%\n")
         else:
-            outbuff.write(line)
+            outbuff.write(explicit_aggregate_return(line))
 
     # Write the last interface
     if targetfile:
@@ -315,8 +334,12 @@ for version in versions[::-1]:
     print("Reading: " + feed)
 
     with open(input_dir / feed, "r") as headerfile:
+        aggregate_types.update(re.findall(r"^(?:typedef )?struct (\w+)", headerfile.read(), re.M))
+        headerfile.seek(0)
         appapi_imports = split_header(headerfile)
 
+aggregate_returns = False  # driver interfaces keep their declarations
+
 # Does the same thing with driver versions.
 for version in driver_versions[::-1]:
     feed = "openvr-%s-driver.h" % version
