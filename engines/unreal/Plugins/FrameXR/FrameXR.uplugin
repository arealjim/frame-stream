{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1.0",
	"FriendlyName": "FrameXR",
	"Description": "Renders -vr games and VR Preview into a Steam Frame on macOS through the OXRSys OpenXR runtime (Metal).",
	"Category": "Virtual Reality",
	"CreatedBy": "frame-lab (adapted from tether-unreal, MIT)",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": false,
	"CanContainContent": false,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"SupportedTargetPlatforms": [
		"Mac"
	],
	"Modules": [
		{
			"Name": "FrameXR",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [
				"Mac"
			]
		}
	],
	"Plugins": [
		{
			"Name": "XRBase",
			"Enabled": true
		}
	]
}
