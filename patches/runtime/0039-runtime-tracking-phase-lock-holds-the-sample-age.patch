     submitToSentMs_.store(0.0f);
     clientSupportsPacingLock_.store(
         HasClientCapability(clientConnect, oxr::protocol::CLIENT_CAPABILITY_PACING_LOCK));
@@ -3007,6 +3011,8 @@ void StreamingServer::SendFrame(FrameSource frameSource,
                 const float prevFetch = sampleAgeAtFetchMs_.load();
                 sampleToSubmitMs_.store(prevSubmit > 0.0f ? prevSubmit * 0.9f + toSubmit * 0.1f : toSubmit);
                 sampleAgeAtFetchMs_.store(prevSubmit > 0.0f ? prevFetch * 0.9f + atFetch * 0.1f : atFetch);
+                sampleAgeAtFetchRawMs_.store(atFetch);
+                sampleAgeAtFetchCount_.fetch_add(1);
             }
         }
     }
diff --git a/runtime/src/StreamingServer.h b/runtime/src/StreamingServer.h
index eac55ad..ce7c61a 100644
--- a/runtime/src/StreamingServer.h
+++ b/runtime/src/StreamingServer.h
@@ -102,6 +102,11 @@ class StreamingServer
              - clientDecodeLatencyMs_.load() - clientCompositorLatencyMs_.load();
     }
 
+    // The newest frame's tracking-sample age at the app's pose fetch (ms, raw, not the EMA) and a count
+    // that moves once per frame scored, for the "tracking" rate lock (pacing_lock_on). Reset on connect.
+    float GetSampleAgeAtFetchRawMs() const { return sampleAgeAtFetchRawMs_.load(); }
+    uint32_t GetSampleAgeAtFetchCount() const { return sampleAgeAtFetchCount_.load(); }
+
     // Get the connected client info
     std::string GetClientName() const;
 
@@ -259,6 +264,8 @@ class StreamingServer
     // plus the network RTT (rttProbe_) and the client's displayed frame age (receive -> eye pass).
     std::atomic<float> sampleToSubmitMs_{0.0f};
     std::atomic<float> sampleAgeAtFetchMs_{0.0f};
+    std::atomic<float> sampleAgeAtFetchRawMs_{0.0f};
+    std::atomic<uint32_t> sampleAgeAtFetchCount_{0};
     std::atomic<float> submitToSentMs_{0.0f};
     std::atomic<float> submitToSendStartMs_{0.0f};  // the encode share of submitToSentMs_
     std::atomic<int64_t> lastMeasuredLatencyLogNs_{0};
diff --git a/tests/TestConfig.cpp b/tests/TestConfig.cpp
index 382ea89..4bbf188 100644
--- a/tests/TestConfig.cpp
+++ b/tests/TestConfig.cpp
@@ -338,6 +338,22 @@ TEST_CASE("Config parser: the rate lock is off by default and clamps when set",
     CHECK(ParseConfigToml(high).pacingLockWaitMs == 30.0f);
 }
 
+TEST_CASE("Config parser: the rate lock holds the queue wait unless told to hold the tracking age", "[config][pacing]")
+{
+    CHECK(ConfigValues{}.pacingLockOn == "queue");
+    CHECK(ConfigValues{}.pacingLockAgeMs == 3.0f);
+    std::istringstream tracking("[streaming]\npacing_lock_on = \"tracking\"\npacing_lock_age_ms = 2.5\n");
+    const ConfigValues t = ParseConfigToml(tracking);
+    CHECK(t.pacingLockOn == "tracking");
+    CHECK(t.pacingLockAgeMs == 2.5f);
+    std::istringstream odd("[streaming]\npacing_lock_on = \"sideways\"\npacing_lock_age_ms = 40\n");
+    const ConfigValues o = ParseConfigToml(odd);
+    CHECK(o.pacingLockOn == "queue");
+    CHECK(o.pacingLockAgeMs == 10.0f);
+    std::istringstream low("[streaming]\npacing_lock_age_ms = 0\n");
+    CHECK(ParseConfigToml(low).pacingLockAgeMs == 0.5f);
+}
+
 TEST_CASE("Config parser reads rtt_probe, rtt_assumed_ms and video_send_port", "[config]")
