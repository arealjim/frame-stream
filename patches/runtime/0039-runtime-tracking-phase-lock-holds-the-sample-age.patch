+++ b/runtime/src/StreamingServer.cpp
@@ -1814,6 +1814,8 @@ void StreamingServer::HandleClientConnect(const oxr::protocol::ClientConnect& cl
     rttProbe_.SetTarget(ShouldProbeRtt() ? std::string(ipStr) : std::string());
     sampleToSubmitMs_.store(0.0f);
     sampleAgeAtFetchMs_.store(0.0f);
