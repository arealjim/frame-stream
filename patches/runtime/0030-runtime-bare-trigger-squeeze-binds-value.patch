From 91761335e50efdd67c91f211dafa8608239a29e6 Mon Sep 17 00:00:00 2001
From: arealjim <6187715+arealjim@users.noreply.github.com>
Date: Sun, 25 Oct 2026 19:57:55 +0000
Subject: [PATCH 30/32] runtime: a bare .../input/trigger or .../input/squeeze
 binds its /value

Per the OpenXR spec a binding path that names only the identifier means the
component's default; for these analog components that is /value. UEVR binds
them bare, so the triggers and grips read 0 for ever and Sifu never saw LB.
Both places that split a binding path apply it: the validation parse and
ComponentFromBindingPath, which the state lookup uses (with only the first,
an injected grip read 0.00 active=true; with both, grip and trigger read 1.00).

OXRSYS_ACTION_TRACE=1 logs each boolean or float action state the app reads
whenever its value or isActive changes (a debug aid; its cache is not
thread-safe).

Found and measured in a worn test of Sifu under UEVR, 2026-10-25/26.

---
 runtime/src/EntryPoint.cpp | 40 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 39 insertions(+), 1 deletion(-)

diff --git a/runtime/src/EntryPoint.cpp b/runtime/src/EntryPoint.cpp
index 8c9408f..8fafb21 100644
--- a/runtime/src/EntryPoint.cpp
+++ b/runtime/src/EntryPoint.cpp
@@ -24,6 +24,7 @@
 #include <glm/glm.hpp>
 #include <glm/gtc/quaternion.hpp>
 #include <cstring>
+#include <cstdlib>
 #include <dlfcn.h>
 #include <exception>
 #include <memory>
@@ -1547,6 +1548,13 @@ static bool IsValidBindingPathForProfile(const Instance* instance,
             if (componentPath != nullptr)
             {
                 *componentPath = path.substr(inputPos + std::strlen(inputMarker));
+                // A bare identifier (.../input/trigger) names the component's default: per the OpenXR spec the
+                // runtime picks /value for an analog-only one. UEVR binds trigger and squeeze this way, and
+                // without this both read 0 for ever (Sifu, 2026-10-25: LB and the triggers never reached the game).
+                if (*componentPath == "trigger" || *componentPath == "squeeze")
+                {
+                    *componentPath += "/value";
+                }
             }
             return true;
         }
@@ -1925,7 +1933,14 @@ static std::string ComponentFromBindingPath(const std::string& path)
     auto inputPos = path.find("/input/");
     if (inputPos != std::string::npos)
     {
-        return path.substr(inputPos + 7); // skip "/input/"
+        std::string component = path.substr(inputPos + 7); // skip "/input/"
+        // A bare identifier resolves to the analog value (OpenXR spec); UEVR binds trigger and squeeze bare, and
+        // this is the path the state lookup uses (the parse in validation alone left both reading 0).
+        if (component == "trigger" || component == "squeeze")
+        {
+            component += "/value";
+        }
+        return component;
     }
     return "";
 }
@@ -2494,6 +2509,27 @@ static XRAPI_ATTR XrResult XRAPI_CALL OxrSyncActions(
     return XR_SUCCESS;
 }
 
+// OXRSYS_ACTION_TRACE=1: log each boolean/float action state the app reads whenever its value or isActive
+// changes, so a controller press can be followed to the exact action the app sees (UEVR's LB, 2026-10-26).
+static void TraceActionState(const ActionState* action, XrPath subactionPath, float value, bool active)
+{
+    static const bool enabled = std::getenv("OXRSYS_ACTION_TRACE") != nullptr;
+    if (!enabled || action == nullptr)
+    {
+        return;
+    }
+    static std::unordered_map<std::string, std::pair<float, bool>> last;
+    const std::string key = action->GetName() + "#" + std::to_string(static_cast<uint64_t>(subactionPath));
+    auto it = last.find(key);
+    if (it != last.end() && it->second.first == value && it->second.second == active)
+    {
+        return;
+    }
+    last[key] = {value, active};
+    spdlog::info("OXRSys: action-trace {} sub={} value={:.2f} active={}", action->GetName(),
+                 static_cast<uint64_t>(subactionPath), value, active);
+}
+
 static XRAPI_ATTR XrResult XRAPI_CALL OxrGetActionStateBoolean(
     XrSession session, const XrActionStateGetInfo* getInfo,
     XrActionStateBoolean* state)
@@ -2517,6 +2553,7 @@ static XRAPI_ATTR XrResult XRAPI_CALL OxrGetActionStateBoolean(
     state->changedSinceLastSync = data.boolChanged ? XR_TRUE : XR_FALSE;
     state->lastChangeTime = data.lastChangeTime;
     state->isActive = data.isActive ? XR_TRUE : XR_FALSE;
+    TraceActionState(action, getInfo->subactionPath, data.boolValue ? 1.0f : 0.0f, data.isActive);
     return XR_SUCCESS;
 }
 
@@ -2543,6 +2580,7 @@ static XRAPI_ATTR XrResult XRAPI_CALL OxrGetActionStateFloat(
     state->changedSinceLastSync = data.floatChanged ? XR_TRUE : XR_FALSE;
     state->lastChangeTime = data.lastChangeTime;
     state->isActive = data.isActive ? XR_TRUE : XR_FALSE;
+    TraceActionState(action, getInfo->subactionPath, data.floatValue, data.isActive);
     return XR_SUCCESS;
 }
 
