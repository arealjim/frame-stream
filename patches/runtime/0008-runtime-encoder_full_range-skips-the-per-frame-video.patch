 runtime/oxrsys-runtime.toml |  6 ++++++
 runtime/src/Config.cpp      | 11 ++++++++---
 runtime/src/Config.h        |  7 +++++++
 runtime/src/VideoEncoder.mm | 10 +++++++++-
 5 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/CHANGES.md b/CHANGES.md
index 017e806..4d9aeba 100644
--- a/CHANGES.md
+++ b/CHANGES.md
@@ -46,6 +46,10 @@ ### Added
 
 ### Changed
 
+- New config `encoder_full_range` (default false): feed the low-latency / software VideoToolbox session the
+  BGRA surface directly instead of the per-frame BT.709 video-range conversion (about 1 ms of submit per
+  frame). The stream is then full range and signals it in the VUI; only for clients that honour the signalled
+  range.
 - Low-latency sessions are no longer mislabelled as software. With low-latency rate
   control VideoToolbox serves the session from its real-time hardware encoder
   (`…videoencoder.hevc.rtvc`), whose session returns `kVTPropertyNotSupportedErr` for
diff --git a/runtime/oxrsys-runtime.toml b/runtime/oxrsys-runtime.toml
index b9400f5..5a43cba 100644
--- a/runtime/oxrsys-runtime.toml
+++ b/runtime/oxrsys-runtime.toml
@@ -53,6 +53,12 @@ encoder_preset = "balanced"
 # to ~8.0 ms at 2272x1264 H.265 (M5 Pro, 2026-10-17). Set false to compare.
 encoder_low_latency = true
 
+# Skip the per-frame BT.709 video-range conversion in front of the low-latency (or software)
+# encoder session (about 1 ms of submit per frame): the stream is then FULL range and its VUI
+# says so. Only for clients that honour the signalled range (Steam Frame client, 2026-10-17);
+# a client that assumes limited range shows lifted blacks and clipped highlights.
+encoder_full_range = false
+
 # Encode HEVC Main10 for H.265 clients that advertise 10-bit decode support.
 # H.264 and clients without the capability continue to receive 8-bit video.
 encoder_10bit = false
