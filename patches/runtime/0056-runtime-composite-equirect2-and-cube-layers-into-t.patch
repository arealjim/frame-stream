+TEST_CASE("A finite equirect sphere is seen from where the eye is", "[overlay][metal]")
+{
+    @autoreleasepool
+    {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        OverlayCompositor compositor;
+        const XrFovf fov = {-kPi / 4, kPi / 4, kPi / 4, -kPi / 4};
+        id<MTLTexture> eye = MakeTexture(device, MTLPixelFormatBGRA8Unorm, kEye, kEye,
+                                         std::vector<Bgra>(kEye * kEye, Bgra{0, 0, 0, 255}));
+        id<MTLTexture> image = HemispheresImage(device);
+
+        // Radius 2 centred 1 m to the right. Ahead hits the sphere 30 degrees left of its centre (red); NDC 0.4
+        // (21.8 degrees right of ahead) still hits 5.9 degrees left (red; green if it were infinite); NDC 0.6
+        // hits 5.6 degrees right (green). Row 120 is below the horizon, so no blue.
+        Draw(queue, compositor, eye, {Equirect(image, fov, At(1, 0, 0), 2.0f, 2 * kPi, kPi / 2, -kPi / 2)}, 1);
+        CHECK(Is(ReadPixel(eye, 100, 120), {0, 0, 255, 255}));
+        CHECK(Is(ReadPixel(eye, 140, 120), {0, 0, 255, 255}));
+        CHECK(Is(ReadPixel(eye, 160, 120), {0, 255, 0, 255}));
+
+        [eye release];
+        [image release];
+        [queue release];
+    }
+}
