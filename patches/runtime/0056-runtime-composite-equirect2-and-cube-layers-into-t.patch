+    o.radius = radius;
+    o.centralAngle = central;
+    o.upperVerticalAngle = upper;
+    o.lowerVerticalAngle = lower;
+    SetLayerFromClip(o);
+    return o;
+}
+
+// One colour per face in Metal's (and Vulkan's) slice order +X -X +Y -Y +Z -Z, as BGRA.
+const Bgra kFaceColours[6] = {{0, 0, 255, 255},   {0, 255, 0, 255},     {255, 0, 0, 255},
+                              {0, 255, 255, 255}, {255, 255, 255, 255}, {255, 0, 255, 255}};
+
+id<MTLTexture> FacesCube(id<MTLDevice> device, uint32_t size = 4)
+{
+    MTLTextureDescriptor* d = [MTLTextureDescriptor textureCubeDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                    size:size
+                                                                               mipmapped:NO];
+    d.usage = MTLTextureUsageShaderRead;
+    d.storageMode = MTLStorageModeShared;
+    id<MTLTexture> cube = [device newTextureWithDescriptor:d];
+    for (uint32_t face = 0; face < 6; ++face)
+    {
+        std::vector<Bgra> pixels(size * size, kFaceColours[face]);
+        [cube replaceRegion:MTLRegionMake2D(0, 0, size, size)
+                mipmapLevel:0
+                      slice:face
+                  withBytes:pixels.data()
+                bytesPerRow:size * 4
+              bytesPerImage:size * size * 4];
+    }
+    return cube;
+}
+
+bool Is(const Bgra& p, const Bgra& want)
+{
+    return std::abs(int(p.r) - int(want.r)) < 8 && std::abs(int(p.g) - int(want.g)) < 8 &&
+           std::abs(int(p.b) - int(want.b)) < 8;
+}
