+TEST_CASE("An infinite equirect puts longitude 0 ahead and its top row up", "[overlay][metal]")
+{
+    @autoreleasepool
+    {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        OverlayCompositor compositor;
+        const XrFovf fov = {-kPi / 4, kPi / 4, kPi / 4, -kPi / 4};
+        id<MTLTexture> eye = MakeTexture(device, MTLPixelFormatBGRA8Unorm, kEye, kEye,
+                                         std::vector<Bgra>(kEye * kEye, Bgra{0, 0, 0, 255}));
+        id<MTLTexture> image = HemispheresImage(device);
+
+        // The layer 5 m away: an infinite sphere ignores where it is, only how it is turned.
+        Draw(queue, compositor, eye, {Equirect(image, fov, At(3, 1, -4), 0.0f, 2 * kPi, kPi / 2, -kPi / 2)}, 1);
+        CHECK(Is(ReadPixel(eye, 150, 50), {255, 255, 0, 255}));  // right and up: green + blue
+        CHECK(Is(ReadPixel(eye, 50, 50), {255, 0, 255, 255}));   // left and up: red + blue
+        CHECK(Is(ReadPixel(eye, 150, 150), {0, 255, 0, 255}));   // right and down: green
+        CHECK(Is(ReadPixel(eye, 50, 150), {0, 0, 255, 255}));    // left and down: red
+
+        [eye release];
+        [image release];
+        [queue release];
+    }
+}
