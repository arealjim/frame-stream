+TEST_CASE("An equirect window covers only its angles", "[overlay][metal]")
+{
+    @autoreleasepool
+    {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        OverlayCompositor compositor;
+        // 60 degree half-fov, as the cylinder test: 45 degrees off-axis lands at NDC 0.577.
+        const XrFovf fov = {-kPi / 3, kPi / 3, kPi / 3, -kPi / 3};
+        id<MTLTexture> eye = MakeTexture(device, MTLPixelFormatBGRA8Unorm, kEye, kEye,
+                                         std::vector<Bgra>(kEye * kEye, Bgra{0, 0, 0, 255}));
+        id<MTLTexture> white = MakeTexture(device, MTLPixelFormatBGRA8Unorm, 1, 1, {Bgra{255, 255, 255, 255}});
+
+        // 90 degrees wide, 22.5 up and down: NDC tan(22.5)/tan(60) = 0.239, 24 px, on the centre column.
+        Draw(queue, compositor, eye, {Equirect(white, fov, Identity(), 0.0f, kPi / 2, kPi / 8, -kPi / 8)}, 1);
+        CHECK(ReadPixel(eye, 100, 100).r == 255);
+        CHECK(ReadPixel(eye, 100 + 54, 100).r == 255);
+        CHECK(ReadPixel(eye, 100 + 61, 100).r == 0);
+        CHECK(ReadPixel(eye, 100 - 54, 100).r == 255);
+        CHECK(ReadPixel(eye, 100 - 61, 100).r == 0);
+        CHECK(ReadPixel(eye, 100, 100 - 21).r == 255);
+        CHECK(ReadPixel(eye, 100, 100 - 27).r == 0);
+        CHECK(ReadPixel(eye, 100, 100 + 21).r == 255);
+        CHECK(ReadPixel(eye, 100, 100 + 27).r == 0);
+
+        [eye release];
+        [white release];
+        [queue release];
+    }
+}
