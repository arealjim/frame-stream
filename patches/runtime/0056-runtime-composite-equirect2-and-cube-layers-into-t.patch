+// Equirect (XR_KHR_composition_layer_equirect2) and cube layers are ray-cast: for each eye pixel the
+// shader unprojects through layerFromClip = inverse(OverlayClipFromLayer) to a ray in layer-local
+// space. These mirror the shader so the mapping is unit-testable.
+
+// The eye's position and the ray through normalized device coordinate (x, y), in layer-local space.
+// Clip (x, y, near, 1) is the view-space point at z = -1; clip (0, 0, near, 0) is the eye itself.
+inline void OverlayRayFromClip(const glm::mat4& layerFromClip, float ndcX, float ndcY,
+                               glm::vec3& origin, glm::vec3& direction, float nearZ = kOverlayNearClip)
+{
+    const glm::vec4 eye = layerFromClip * glm::vec4(0.0f, 0.0f, nearZ, 0.0f);
+    const glm::vec4 point = layerFromClip * glm::vec4(ndcX, ndcY, nearZ, 1.0f);
+    origin = glm::vec3(eye) / eye.w;
+    direction = glm::normalize(glm::vec3(point) / point.w - origin);
+}
+
+// radius 0 or +inf: the sphere is infinitely far, so only the ray's direction picks the texel.
+inline bool IsInfiniteEquirectRadius(float radius)
+{
+    return radius == 0.0f || std::isinf(radius);
+}
+
+// The direction from the sphere's centre to where the ray leaves a sphere of the given radius around
+// the layer pose (the far hit, so a viewer inside sees the inside; outside, the far wall). False if
+// the ray misses or the sphere is behind it.
+inline bool EquirectSphereDirection(const glm::vec3& origin, const glm::vec3& direction, float radius,
+                                    glm::vec3& fromCentre)
+{
+    if (IsInfiniteEquirectRadius(radius))
+    {
+        fromCentre = direction;
+        return true;
+    }
+    const float b = glm::dot(origin, direction);
+    const float h = b * b - (glm::dot(origin, origin) - radius * radius);
+    if (h < 0.0f)
+    {
+        return false;
+    }
+    const float t = -b + std::sqrt(h);
+    if (t <= 0.0f)
+    {
+        return false;
+    }
+    fromCentre = glm::normalize(origin + t * direction);
+    return true;
+}
+
+// Image coordinates (s left to right, t top to bottom, both 0..1 over the layer's subImage) of a
+// direction from the sphere's centre, per the equirect2 spec: longitude 0 at -Z, growing toward +X,
+// the image spanning centralHorizontalAngle symmetrically about it; latitude from upperVerticalAngle
+// (top row) down to lowerVerticalAngle (bottom row). False outside that range: nothing is drawn.
+inline bool EquirectImageCoords(const glm::vec3& fromCentre, float centralHorizontalAngle,
+                                float upperVerticalAngle, float lowerVerticalAngle, float& s, float& t)
+{
+    const float longitude = std::atan2(fromCentre.x, -fromCentre.z);
+    const float latitude = std::asin(std::clamp(fromCentre.y, -1.0f, 1.0f));
+    if (std::fabs(longitude) > 0.5f * centralHorizontalAngle || latitude > upperVerticalAngle ||
+        latitude < lowerVerticalAngle)
+    {
+        return false;
+    }
+    s = longitude / centralHorizontalAngle + 0.5f;
+    t = (upperVerticalAngle - latitude) / (upperVerticalAngle - lowerVerticalAngle);
+    return true;
+}
+
+inline bool IsDrawableEquirect(float radius, float centralHorizontalAngle, float upperVerticalAngle,
+                               float lowerVerticalAngle)
+{
+    return !std::isnan(radius) && radius >= 0.0f &&
+           std::isfinite(centralHorizontalAngle) && centralHorizontalAngle > 0.0f &&
+           std::isfinite(upperVerticalAngle) && std::isfinite(lowerVerticalAngle) &&
+           upperVerticalAngle > lowerVerticalAngle;
+}
+
 } // namespace oxrsys::runtime
