+TEST_CASE("A cube layer shows the face its direction picks, turned by its orientation", "[overlay][metal]")
+{
+    @autoreleasepool
+    {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        OverlayCompositor compositor;
+        // 60 degree half-fov: NDC 0.9 is 57 degrees off-axis, past the 45 degree face edge.
+        const XrFovf fov = {-kPi / 3, kPi / 3, kPi / 3, -kPi / 3};
+        id<MTLTexture> eye = MakeTexture(device, MTLPixelFormatBGRA8Unorm, kEye, kEye,
+                                         std::vector<Bgra>(kEye * kEye, Bgra{0, 0, 0, 255}));
+        id<MTLTexture> cube = FacesCube(device);
+
+        FrameOverlayLayer layer = Overlay(cube, fov, Identity());
+        layer.shape = FrameOverlayLayer::Shape::Cube;
+        SetLayerFromClip(layer);
+        Draw(queue, compositor, eye, {layer}, 1);
+        CHECK(Is(ReadPixel(eye, 100, 100), kFaceColours[5])); // ahead: -Z
+        CHECK(Is(ReadPixel(eye, 195, 100), kFaceColours[0])); // right: +X
+        CHECK(Is(ReadPixel(eye, 5, 100), kFaceColours[1]));   // left: -X
+        CHECK(Is(ReadPixel(eye, 100, 5), kFaceColours[2]));   // up: +Y
+        CHECK(Is(ReadPixel(eye, 100, 195), kFaceColours[3])); // down: -Y
+
+        // Turned 90 degrees to the left about +Y, the cube's +X face is ahead; its position is ignored.
+        XrPosef turned = At(5, 5, 5);
+        turned.orientation = {0.0f, std::sin(kPi / 4), 0.0f, std::cos(kPi / 4)};
+        layer = Overlay(cube, fov, turned);
+        layer.shape = FrameOverlayLayer::Shape::Cube;
+        SetLayerFromClip(layer);
+        Draw(queue, compositor, eye, {layer}, 1);
+        CHECK(Is(ReadPixel(eye, 100, 100), kFaceColours[0]));
+
+        // A cube layer on a 2D image draws nothing (the swapchain was not a cube).
+        id<MTLTexture> flat = MakeTexture(device, MTLPixelFormatBGRA8Unorm, 1, 1, {Bgra{1, 2, 3, 255}});
+        layer = Overlay(flat, fov, Identity());
+        layer.shape = FrameOverlayLayer::Shape::Cube;
+        SetLayerFromClip(layer);
+        Draw(queue, compositor, eye, {layer}, 0);
+
+        [flat release];
+        [eye release];
+        [cube release];
+        [queue release];
+    }
+}
