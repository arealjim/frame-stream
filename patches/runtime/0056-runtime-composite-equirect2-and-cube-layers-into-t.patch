+    REQUIRE(EquirectImageCoords(right30, 2 * kPi, kPi / 2, -kPi / 2, s, t));
+    REQUIRE(s == Approx(0.5f + 30.0f / 360.0f));
+    REQUIRE(t == Approx(0.5f));
+    // Straight behind is the image's left/right edge; straight up its top row.
+    REQUIRE(EquirectImageCoords({0, 0, 1}, 2 * kPi, kPi / 2, -kPi / 2, s, t));
+    REQUIRE(std::fabs(s - 0.5f) == Approx(0.5f));
+    REQUIRE(EquirectImageCoords({0, 1, 0}, 2 * kPi, kPi / 2, -kPi / 2, s, t));
