+// GPU cost of an equirect and a cube layer on a Frame-sized eye (run with "[.overlay-bench]"):
+// a full-sphere 4096 x 2048 equirect and a 1024-texel cube, each covering the whole eye.
+TEST_CASE("Equirect and cube GPU time on a Frame-sized eye", "[.overlay-bench]")
+{
+    @autoreleasepool
+    {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        OverlayCompositor compositor;
+        constexpr uint32_t kFrameEye = 2048;
+        const XrFovf fov = {-kPi / 4, kPi / 4, kPi / 4, -kPi / 4};
+        MTLTextureDescriptor* d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                     width:kFrameEye
+                                                                                    height:kFrameEye
+                                                                                 mipmapped:NO];
+        d.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        d.storageMode = MTLStorageModePrivate;
+        id<MTLTexture> eye = [device newTextureWithDescriptor:d];
+        d.width = 4096;
+        d.height = 2048;
+        id<MTLTexture> panorama = [device newTextureWithDescriptor:d];
+        MTLTextureDescriptor* c = [MTLTextureDescriptor textureCubeDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                        size:1024
+                                                                                   mipmapped:NO];
+        c.usage = MTLTextureUsageShaderRead;
+        c.storageMode = MTLStorageModePrivate;
+        id<MTLTexture> cube = [device newTextureWithDescriptor:c];
+
+        for (bool under : {false, true})
+        for (int kind : {0, 1})
+        {
+            FrameOverlayLayer layer = kind == 0
+                ? Equirect(panorama, fov, Identity(), 0.0f, 2 * kPi, kPi / 2, -kPi / 2)
+                : Overlay(cube, fov, Identity());
+            if (kind == 1)
+            {
+                layer.shape = FrameOverlayLayer::Shape::Cube;
+                SetLayerFromClip(layer);
+            }
+            layer.sourceAlpha = true;
+            layer.underlay = under;
+            std::vector<double> ms;
+            for (int i = 0; i < 300; ++i)
+            {
+                id<MTLCommandBuffer> cb = [queue commandBuffer];
+                compositor.Draw((void*)cb, (void*)eye, 0, {layer});
+                [cb commit];
+                [cb waitUntilCompleted];
+                if (i >= 20)
+                {
+                    ms.push_back((cb.GPUEndTime - cb.GPUStartTime) * 1000.0);
+                }
+            }
+            std::sort(ms.begin(), ms.end());
+            printf("overlay bench: %s %s over the whole %u px eye, GPU p50 %.3f ms p95 %.3f ms\n",
+                   under ? "underlay" : "overlay ", kind == 0 ? "equirect 4096x2048" : "cube 1024         ",
+                   kFrameEye, ms[ms.size() / 2], ms[ms.size() * 95 / 100]);
+        }
+        [eye release];
+        [panorama release];
+        [cube release];
+        [queue release];
+    }
+}
