+// 64 x 32 full-sphere test image: left half (longitude < 0) red, right half green; the top half adds blue.
+id<MTLTexture> HemispheresImage(id<MTLDevice> device)
+{
+    std::vector<Bgra> pixels(64 * 32);
+    for (uint32_t y = 0; y < 32; ++y)
+    {
+        for (uint32_t x = 0; x < 64; ++x)
+        {
+            pixels[y * 64 + x] =
+                Bgra{uint8_t(y < 16 ? 255 : 0), uint8_t(x < 32 ? 0 : 255), uint8_t(x < 32 ? 255 : 0), 255};
