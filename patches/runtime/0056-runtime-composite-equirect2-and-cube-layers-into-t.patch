+XrResult Session::ValidateEquirect2Layer(const XrCompositionLayerEquirect2KHR& layer) const
+{
+    auto* space = Runtime::Get().FromHandle<Space>(reinterpret_cast<uint64_t>(layer.space));
+    if (space == nullptr || space->GetSession() != this)
+    {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    if (!IsValidPose(layer.pose))
+    {
+        return XR_ERROR_POSE_INVALID;
+    }
+    const float halfPi = 0.5f * static_cast<float>(M_PI);
+    if (std::isnan(layer.radius) || layer.radius < 0.0f ||
+        !std::isfinite(layer.centralHorizontalAngle) || layer.centralHorizontalAngle < 0.0f ||
+        layer.centralHorizontalAngle > 2.0f * static_cast<float>(M_PI) ||
+        !std::isfinite(layer.upperVerticalAngle) || layer.upperVerticalAngle < -halfPi ||
+        layer.upperVerticalAngle > halfPi ||
+        !std::isfinite(layer.lowerVerticalAngle) || layer.lowerVerticalAngle < -halfPi ||
+        layer.lowerVerticalAngle > halfPi)
+    {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+
+    return ValidateSwapchainSubImage(layer.subImage);
+}
+
+XrResult Session::ValidateCubeLayer(const XrCompositionLayerCubeKHR& layer) const
+{
+    auto* space = Runtime::Get().FromHandle<Space>(reinterpret_cast<uint64_t>(layer.space));
+    if (space == nullptr || space->GetSession() != this)
+    {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    XrPosef pose = {};
+    pose.orientation = layer.orientation;
+    if (!IsValidPose(pose))
+    {
+        return XR_ERROR_POSE_INVALID;
+    }
+    auto* swapchain = Runtime::Get().FromHandle<Swapchain>(reinterpret_cast<uint64_t>(layer.swapchain));
+    if (swapchain == nullptr || !OwnsSwapchain(swapchain))
+    {
+        return XR_ERROR_HANDLE_INVALID;
+    }
+    if (!swapchain->HasReleasedImage())
+    {
+        return XR_ERROR_LAYER_INVALID;
+    }
+    if (layer.imageArrayIndex >= swapchain->GetArraySize())
+    {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    return XR_SUCCESS;
+}
