+// The eye pixel's ray in layer-local space (CompositionOverlay.h OverlayRayFromClip).
+static float3 layer_ray(float2 ndc, constant OverlayUniforms& u, thread float3& origin)
+{
+    const float4 eye = u.layerFromClip * float4(0.0, 0.0, u.nearZ, 0.0);
+    const float4 onNear = u.layerFromClip * float4(ndc, u.nearZ, 1.0);
