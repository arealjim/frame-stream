From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: arealjim <6187715+arealjim@users.noreply.github.com>
Date: Mon, 26 Oct 2026 15:40:41 +0000
Subject: [PATCH] runtime: drain an autorelease pool per encoded frame, so
 drops before encode cannot stall the encoder

The runtime is built without ARC and the encode thread has no autorelease
pool, so the command buffer that EncodeInternal gets from
[queue commandBuffer] (autoreleased) lived until the thread exited. A
committed buffer completes and stops counting against the queue. One
abandoned by a drop before encode (an invalid foveated source size or
format, a crop failure, an encoder that would not create) never does, and
once the queue's default 64 were outstanding the next commandBuffer call
blocked the encode thread forever: the stream froze and never recovered,
even when valid frames came back.

Encode and EncodeStereo now wrap EncodeInternal in @autoreleasepool.

New test: 100 frames dropped before encode, then a valid frame, which must
be submitted within 10 s. On main it times out, blocked in
_dispatch_semaphore_wait_slow under [queue commandBuffer]; with this
change it passes.

---
 CHANGES.md                       |  7 ++++
 runtime/src/VideoEncoder.mm      | 23 ++++++++++--
 tests/TestVideoToolboxEncoder.mm | 64 ++++++++++++++++++++++++++++++++
 3 files changed, 90 insertions(+), 4 deletions(-)

diff --git a/CHANGES.md b/CHANGES.md
index cc392cd..3dff9c9 100644
--- a/CHANGES.md
+++ b/CHANGES.md
@@ -116,6 +116,13 @@ ### Changed
 
 ### Fixed
 
+- Fixed the video encoder freezing for good after 64 frames dropped before encode. The runtime is
+  built without ARC and the encode thread had no autorelease pool, so each frame's autoreleased
+  Metal command buffer lived until the thread exited. A frame dropped after its command buffer was
+  made (an invalid foveated source size or format, a crop failure, an encoder that would not
+  create) left one that was never committed, and once 64 were outstanding the next
+  [queue commandBuffer] blocked the encode thread forever. Encode and EncodeStereo now drain a pool
+  per frame.
 - Fixed Vulkan apps that render through an sRGB view of a UNORM swapchain image, such as Godot 4,
   failing at `xrCreateSwapchain` with `XR_ERROR_FEATURE_UNSUPPORTED`. Vulkan swapchains now accept
   `XR_SWAPCHAIN_USAGE_MUTABLE_FORMAT_BIT` and create images with `VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT`.
diff --git a/runtime/src/VideoEncoder.mm b/runtime/src/VideoEncoder.mm
index 39bf472..f2dfaee 100644
--- a/runtime/src/VideoEncoder.mm
+++ b/runtime/src/VideoEncoder.mm
@@ -1739,8 +1739,13 @@ bool VideoEncoder::Encode(FrameImageSource imageSource, int64_t timestampNs, OnN
 {
     FrameSource frameSource = {};
     frameSource.left = std::move(imageSource);
-    return EncodeInternal(std::move(frameSource), false, timestampNs,
-                          std::move(callback), std::move(frameCallback));
+    bool submitted = false;
+    @autoreleasepool
+    {
+        submitted = EncodeInternal(std::move(frameSource), false, timestampNs,
+                                   std::move(callback), std::move(frameCallback));
+    }
+    return submitted;
 }
 
 bool VideoEncoder::FlushPendingFrames(std::chrono::milliseconds timeout)
@@ -1781,10 +1786,20 @@ bool VideoEncoder::FlushPendingFrames(std::chrono::milliseconds timeout)
 bool VideoEncoder::EncodeStereo(FrameSource frameSource, int64_t timestampNs, OnNalUnitCallback callback,
                                  OnFrameEncodedCallback frameCallback)
 {
-    return EncodeInternal(std::move(frameSource), true, timestampNs,
-                          std::move(callback), std::move(frameCallback));
+    bool submitted = false;
+    @autoreleasepool
+    {
+        submitted = EncodeInternal(std::move(frameSource), true, timestampNs,
+                                   std::move(callback), std::move(frameCallback));
+    }
+    return submitted;
 }
 
+// Encode and EncodeStereo drain an autorelease pool around each frame. The runtime is built
+// without ARC and its encode thread has no pool of its own, so the autoreleased command buffer
+// from [queue commandBuffer] lived until the thread exited. A committed one completes and stops
+// counting against the queue; one abandoned by a drop before encode never does, and after the
+// queue's 64 the next commandBuffer call blocked the encoder for good.
 bool VideoEncoder::EncodeInternal(FrameSource frameSource, bool stereo,
                                    int64_t timestampNs, OnNalUnitCallback callback,
                                    OnFrameEncodedCallback frameCallback)
diff --git a/tests/TestVideoToolboxEncoder.mm b/tests/TestVideoToolboxEncoder.mm
index 815cf5f..81147a5 100644
--- a/tests/TestVideoToolboxEncoder.mm
+++ b/tests/TestVideoToolboxEncoder.mm
@@ -13,6 +13,7 @@
 #include <condition_variable>
 #include <csignal>
 #include <cstdint>
+#include <future>
 #include <memory>
 #include <mutex>
 #include <set>
@@ -224,6 +225,69 @@ TEST_CASE("Foveated encoding converts sRGB Metal sources",
                    true);
 }
 
+TEST_CASE("A run of frames dropped before encode does not stall the next frame",
+          "[video][encoder][videotoolbox][foveation]")
+{
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    REQUIRE(device != nil);
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    REQUIRE(queue != nil);
+    GraphicsContext graphics = GraphicsContext::Metal((__bridge void*)device,
+                                                       (__bridge void*)queue);
+
+    auto encoder = std::make_unique<VideoEncoder>();
+    VideoEncoder::FoveationSettings settings = {};
+    settings.enabled = true;
+    settings.targetEyeWidth = 64;
+    settings.targetEyeHeight = 64;
+    settings.eyeWidthRatio = 1.0f;
+    settings.eyeHeightRatio = 1.0f;
+    settings.centerSizeX = 0.5f;
+    settings.centerSizeY = 0.5f;
+    settings.edgeRatioX = 2.0f;
+    settings.edgeRatioY = 2.0f;
+    encoder->SetFoveationSettings(settings);
+    REQUIRE(encoder->Initialize(128, 64, 60, 8, graphics, oxr::protocol::VideoCodec::H264));
+
+    // Left and right eyes of different sizes are refused by the foveated path, after the frame's
+    // command buffer was made: more of them than a Metal queue's default 64 command buffers, then a
+    // good frame. All of it runs on a thread we can stop waiting on.
+    constexpr uint32_t kDrops = 100;
+    auto done = std::make_shared<std::promise<bool>>();
+    std::future<bool> result = done->get_future();
+    VideoEncoder* raw = encoder.get();
+    std::thread([raw, device, done] {
+        bool allDropped = true;
+        for (uint32_t i = 0; i < kDrops; ++i)
+        {
+            FrameSource frame = {};
+            frame.left = MakeSource(device, 128, 128, MTLPixelFormatBGRA8Unorm);
+            frame.right = MakeSource(device, 64, 64, MTLPixelFormatBGRA8Unorm);
+            allDropped = !raw->EncodeStereo(std::move(frame), 1'000'000 + i,
+                                            [](const uint8_t*, size_t, bool, int64_t) {},
+                                            [](const VideoEncoder::FrameMetrics&) {}) && allDropped;
+        }
+        FrameSource frame = {};
+        frame.left = MakeSource(device, 64, 64, MTLPixelFormatBGRA8Unorm);
+        frame.right = MakeSource(device, 64, 64, MTLPixelFormatBGRA8Unorm);
+        const bool submitted = raw->EncodeStereo(std::move(frame), 2'000'000,
+                                                 [](const uint8_t*, size_t, bool, int64_t) {},
+                                                 [](const VideoEncoder::FrameMetrics&) {});
+        done->set_value(allDropped && submitted);
+    }).detach();
+    if (result.wait_for(std::chrono::seconds(10)) != std::future_status::ready)
+    {
+        // The encoder is stuck inside EncodeStereo; leave it (and its device) alive rather than
+        // destroy it under that thread.
+        encoder.release();
+        FAIL("EncodeStereo did not return within 10 s: " << kDrops << " drops before encode, then a good frame");
+    }
+    CHECK(result.get());
+    encoder->Shutdown();
+    [queue release];
+    [device release];
+}
+
 TEST_CASE("VideoToolbox shutdown drains submitted frame-source ownership",
           "[video][encoder][videotoolbox][lifecycle]")
 {
