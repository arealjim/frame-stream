From a1b0c038f4deee874a0259c21a917e0941a75fcc Mon Sep 17 00:00:00 2001
From: arealjim <6187715+arealjim@users.noreply.github.com>
Date: Sun, 18 Oct 2026 13:59:18 +0000
Subject: [PATCH 13/23] runtime: encoder_min_qp lets the low-latency encoder
 spend its bitrate

The low-latency (rtvc) VideoToolbox session floors frame QP at 16 and stops
there, so past a scene-dependent size it leaves the bitrate unspent: on the
bench smooth scene at 2560x1120 it sends 38.2 Mbps whether asked for 50 or 150
(measured 2026-10-18, M5 Pro, sparse 15 Hz submits). Live, a simpler scene sent
7 Mbps at 150. MinAllowedFrameQP is the only property that moves it: 12 gives
49.8 Mbps at 50 (callback p50 10.2 vs 10.2 ms in back-to-back runs, 9.6 to 10.1
in the sweep), 14 gives 45.2, 18 and 20 cut bits. ConstantBitRate, Quality,
PrioritizeEncodingSpeedOverQuality and SpatialAdaptiveQPLevel are refused by the
rtvc session (-12900); MaxAllowedFrameQP, DataRateLimits removed or tight and
BaseLayerBitRateFraction change nothing; ExpectedFrameRate 0 stops all output.

New config encoder_min_qp, default 0 = the encoder floor (current behaviour),
clamped to 0..51, applied to the in-process session with a log line, refused
loudly. Config test covers default, value and clamp. The encoder bench gains
--pattern texture|scene|smooth so bytes per frame mean something.

---
 CHANGES.md                  |  5 +++++
 runtime/oxrsys-runtime.toml |  6 ++++++
 runtime/src/Config.cpp      |  4 ++++
 runtime/src/Config.h        |  6 ++++++
 runtime/src/VideoEncoder.mm | 19 ++++++++++++++++
 tests/TestConfig.cpp        | 20 +++++++++++++++++
 tools/EncoderBench.mm       | 43 ++++++++++++++++++++++++++++++++++---
 7 files changed, 100 insertions(+), 3 deletions(-)

diff --git a/CHANGES.md b/CHANGES.md
index 37a20d3..7faaaa2 100644
--- a/CHANGES.md
+++ b/CHANGES.md
@@ -6,6 +6,11 @@ ## 1.3.0 - TBD
 
 ### Added
 
+- Added config encoder_min_qp (default 0 = VideoToolbox's own floor): the minimum frame QP of the
+  in-process encoder session. The low-latency (rtvc) session floors QP at 16 and stops spending
+  bits there whatever the bitrate; 12 lets it reach the target (bench, 2560x1120 at 50 Mbps:
+  38.2 -> 49.8 Mbps actual, callback p50 +0.5 ms). The encoder bench gains --pattern
+  texture|scene|smooth.
 - The streaming "encode queue" log line ends with frameBytes(min/med/max)=a/b/c small=k/n: encoded
   bytes per frame over the window and how many of its n frames were under 20 % of the median (a
   duplicate frame reaching the encoder shows up there).
diff --git a/runtime/oxrsys-runtime.toml b/runtime/oxrsys-runtime.toml
index f7cc713..50db0ee 100644
--- a/runtime/oxrsys-runtime.toml
+++ b/runtime/oxrsys-runtime.toml
@@ -61,6 +61,12 @@ pacing_thread = "default"
 # to ~8.0 ms at 2272x1264 H.265 (M5 Pro, 2026-10-17). Set false to compare.
 encoder_low_latency = true
 
+# Lowest QP the in-process encoder may use (MinAllowedFrameQP); 0 keeps VideoToolbox's floor.
+# The low-latency session floors at QP 16 and then leaves bitrate unspent on simple scenes;
+# 12 lets it spend up to the target (2560x1120 at 50 Mbps: 38 -> 50 Mbps actual, +0.5 ms
+# callback; M5 Pro, 2026-10-18). More bits per frame: check the link can carry them.
+encoder_min_qp = 0
+
 # Skip the per-frame BT.709 video-range conversion in front of the low-latency (or software)
 # encoder session (about 1 ms of submit per frame): the stream is then FULL range and its VUI
 # says so. Only for clients that honour the signalled range (Steam Frame client, 2026-10-17);
diff --git a/runtime/src/Config.cpp b/runtime/src/Config.cpp
index e51c7f8..cec86c7 100644
--- a/runtime/src/Config.cpp
+++ b/runtime/src/Config.cpp
@@ -416,6 +416,10 @@ ConfigValues ParseConfigToml(std::istream& input, const ConfigValues& defaults)
             {
                 values.encoderLowLatency = ParseBool(value);
             }
+            else if (key == "encoder_min_qp")
+            {
+                values.encoderMinQp = static_cast<uint32_t>(std::max(0, std::min(51, std::stoi(value))));
+            }
             else if (key == "encoder_full_range")
             {
                 values.encoderFullRange = ParseBool(value);
diff --git a/runtime/src/Config.h b/runtime/src/Config.h
index f2985e5..b21c99e 100644
--- a/runtime/src/Config.h
+++ b/runtime/src/Config.h
@@ -29,6 +29,12 @@ struct ConfigValues
     // no periodic IDR (keyframes come from ForceKeyFrame, i.e. client requests).
     // Measured 2026-10-17, M5 Pro, 2272x1264 HEVC @72: encode callback 12.6 -> 8.0 ms.
     bool encoderLowLatency = true;
+    // encoder_min_qp: kVTCompressionPropertyKey_MinAllowedFrameQP on the in-process session,
+    // 0 = leave VideoToolbox's own floor. The low-latency (rtvc) session floors QP at 16 and
+    // then stops spending bits whatever the bitrate; 12 lets it reach the target on detailed
+    // scenes. Measured 2026-10-18, M5 Pro, 2560x1120 HEVC, bench "smooth" scene at 50 Mbps:
+    // 38.2 -> 49.8 Mbps actual, callback p50 9.6 -> 10.1 ms.
+    uint32_t encoderMinQp = 0;
     // pacing_spin_ms: WaitFrame sleeps until (deadline - this) and spins the rest. 0 = sleep to the deadline.
     float pacingSpinMs = 0.0f;
     // pacing_thread: "default" | "qos" (USER_INTERACTIVE QoS on the app thread that calls WaitFrame)
diff --git a/runtime/src/VideoEncoder.mm b/runtime/src/VideoEncoder.mm
index ce6aa3f..726edd7 100644
--- a/runtime/src/VideoEncoder.mm
+++ b/runtime/src/VideoEncoder.mm
@@ -1136,6 +1136,25 @@ bool VideoEncoder::Initialize(uint32_t width, uint32_t height, uint32_t fps,
         kVTCompressionPropertyKey_MaxFrameDelayCount, delayRef);
     CFRelease(delayRef);
 
+    // A QP floor below VideoToolbox's own lets the low-latency session spend the
+    // bitrate it is given (Config.h encoder_min_qp); 0 leaves the encoder's floor.
+    if (config.encoderMinQp > 0)
+    {
+        int minQp = (int)config.encoderMinQp;
+        CFNumberRef minQpRef = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &minQp);
+        const OSStatus minQpStatus = VTSessionSetProperty(compressionSession,
+            kVTCompressionPropertyKey_MinAllowedFrameQP, minQpRef);
+        CFRelease(minQpRef);
+        if (minQpStatus == noErr)
+        {
+            spdlog::info("VideoEncoder: minimum frame QP {} (encoder_min_qp)", minQp);
+        }
+        else
+        {
+            spdlog::warn("VideoEncoder: encoder_min_qp {} refused by this session ({})", minQp, minQpStatus);
+        }
+    }
+
     VTCompressionSessionPrepareToEncodeFrames(compressionSession);
     {
         std::lock_guard<std::mutex> sessionLock(videoToolboxSessionMutex_);
diff --git a/tests/TestConfig.cpp b/tests/TestConfig.cpp
index 9a115a1..e58e482 100644
--- a/tests/TestConfig.cpp
+++ b/tests/TestConfig.cpp
@@ -181,6 +181,26 @@ encoder_low_latency = false
     CHECK(ParseConfigToml(off).encoderLowLatency == false);
 }
 
+TEST_CASE("Config parser reads encoder_min_qp, 0 by default, clamped to the HEVC range", "[config]")
+{
+    CHECK(ConfigValues{}.encoderMinQp == 0);
+    std::istringstream twelve(R"TOML(
+[streaming]
+encoder_min_qp = 12
+)TOML");
+    CHECK(ParseConfigToml(twelve).encoderMinQp == 12);
+    std::istringstream high(R"TOML(
+[streaming]
+encoder_min_qp = 80
+)TOML");
+    CHECK(ParseConfigToml(high).encoderMinQp == 51);
+    std::istringstream negative(R"TOML(
+[streaming]
+encoder_min_qp = -3
+)TOML");
+    CHECK(ParseConfigToml(negative).encoderMinQp == 0);
+}
+
 TEST_CASE("Config parser keeps encoder_helper tri-state with an automatic default", "[config]")
 {
     // Default: the runtime decides from the measured hardware-encoder
