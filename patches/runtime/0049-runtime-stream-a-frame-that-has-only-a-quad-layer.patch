+// A frame with no projection layer (a loading screen or a menu drawn on one quad)
+// would otherwise stream nothing. Project the quad's corners into each eye's field of view and
+// hand the encoder the quad's image plus where it lands, so each eye draws it at its own place:
+// a flat panel at the quad's true distance, not a head-locked full-view picture. The bounding box
+// of the projected corners is used, so a quad seen at a steep angle keeps no keystone.
+void Session::BuildQuadFrameSource(const XrCompositionLayerQuad& quad, XrTime displayTime,
+                                   FrameSource& frameSource)
+{
+    auto* swapchain = Runtime::Get().FromHandle<Swapchain>(reinterpret_cast<uint64_t>(quad.subImage.swapchain));
+    if (swapchain == nullptr)
+    {
+        return;
+    }
+    FrameImageSource image = swapchain->GetLastReleasedFrameImageSource(quad.subImage.imageArrayIndex);
+    if (!image.IsValid())
+    {
+        return;
+    }
+    image.sourceX = static_cast<uint32_t>(quad.subImage.imageRect.offset.x);
+    image.sourceY = static_cast<uint32_t>(quad.subImage.imageRect.offset.y);
+    image.sourceWidth = static_cast<uint32_t>(quad.subImage.imageRect.extent.width);
+    image.sourceHeight = static_cast<uint32_t>(quad.subImage.imageRect.extent.height);
+
+    // Place the quad with the head pose this frame will be stamped with (the one the app located for
+    // displayTime), not a fresh locate: calling LocateViews here would read a pose ~10 ms newer and also
+    // write it into locatedPoses_, so the placement and the stamp would disagree and the panel would swim.
+    if (!lastRenderHasPose_)
+    {
+        return;
+    }
+    XrPosef headPose = lastRenderHeadPose_;
+    {
+        std::lock_guard<std::mutex> lock(locatedPoseMutex_);
+        for (const auto& lp : locatedPoses_)
+        {
+            if (lp.displayTime == displayTime)
+            {
+                headPose = lp.pose;
+            }
+        }
+    }
+    // The eyes' offsets from the head (IPD, canting) and their FOVs, from the current views; then the
+    // eyes re-seated on the stamped head and expressed in the quad's space.
+    XrView views[2] = {{XR_TYPE_VIEW}, {XR_TYPE_VIEW}};
+    inputManager_->GetEyeViews(views, 2);
+    const XrPosef currentHead = inputManager_->GetHeadPose();
+    const glm::quat curRotInv = glm::inverse(ToGlmQuat(currentHead.orientation));
+    const glm::vec3 curPos = ToGlmVec(currentHead.position);
+    const glm::quat headRot = ToGlmQuat(headPose.orientation);
+    const glm::vec3 headPos = ToGlmVec(headPose.position);
+    auto* quadSpace = Runtime::Get().FromHandle<Space>(reinterpret_cast<uint64_t>(quad.space));
+    if (quadSpace == nullptr)
+    {
+        return;
+    }
+    const XrPosef basePose = ReferenceSpaceWorldPose(quadSpace, *inputManager_);
+    {
+        static auto lastQuadLog = std::chrono::steady_clock::time_point{};
+        const auto now = std::chrono::steady_clock::now();
+        if (now - lastQuadLog >= std::chrono::seconds(2))
+        {
+            lastQuadLog = now;
+            spdlog::info("OXRSys: quad pose space type={} ref={} pos=({:.2f},{:.2f},{:.2f}) rot=({:.3f},{:.3f},{:.3f},{:.3f}) "
+                         "head rot=({:.3f},{:.3f},{:.3f},{:.3f})",
+                         (int)quadSpace->GetType(), (int)quadSpace->GetReferenceSpaceType(),
+                         quad.pose.position.x, quad.pose.position.y, quad.pose.position.z,
+                         quad.pose.orientation.x, quad.pose.orientation.y, quad.pose.orientation.z,
+                         quad.pose.orientation.w, headPose.orientation.x, headPose.orientation.y,
+                         headPose.orientation.z, headPose.orientation.w);
+        }
+    }
+    const glm::quat baseRotInv = glm::inverse(ToGlmQuat(basePose.orientation));
+    const glm::vec3 basePos = ToGlmVec(basePose.position);
+    for (XrView& view : views)
+    {
+        const glm::quat eyeRotInHead = curRotInv * ToGlmQuat(view.pose.orientation);
+        const glm::vec3 eyePosInHead = curRotInv * (ToGlmVec(view.pose.position) - curPos);
+        const glm::quat eyeRot = headRot * eyeRotInHead;
+        const glm::vec3 eyePos = headPos + headRot * eyePosInHead;
+        view.pose.orientation = ToXrQuat(baseRotInv * eyeRot);
+        view.pose.position = ToXrVec(baseRotInv * (eyePos - basePos));
+    }
+
+    // The eye texture: the recommended eye size, the size an app renders each eye at.
+    const uint32_t eyeW = image.imageWidth != 0 ? image.imageWidth : image.sourceWidth;
+    const uint32_t eyeH = image.imageHeight != 0 ? image.imageHeight : image.sourceHeight;
+
+    const glm::quat quadRot = ToGlmQuat(quad.pose.orientation);
+    const glm::vec3 quadPos = ToGlmVec(quad.pose.position);
+    const float hw = quad.size.width * 0.5f;
+    const float hh = quad.size.height * 0.5f;
+    const glm::vec3 corners[4] = {{-hw, -hh, 0.0f}, {hw, -hh, 0.0f}, {hw, hh, 0.0f}, {-hw, hh, 0.0f}};
+
+    for (int eye = 0; eye < 2; ++eye)
+    {
+        FrameImageSource placed = image;
+        placed.placeInEye = true;
+        placed.eyeWidth = eyeW;
+        placed.eyeHeight = eyeH;
+        const glm::quat eyeRotInv = glm::inverse(ToGlmQuat(views[eye].pose.orientation));
+        const glm::vec3 eyePos = ToGlmVec(views[eye].pose.position);
+        const float tl = std::tan(views[eye].fov.angleLeft);
+        const float tr = std::tan(views[eye].fov.angleRight);
+        const float td = std::tan(views[eye].fov.angleDown);
+        const float tu = std::tan(views[eye].fov.angleUp);
+        {
+            // image top-left is the quad's (-w/2, +h/2); x runs right, y runs down the image
+            const glm::vec3 c0 = eyeRotInv * (quadPos + quadRot * glm::vec3(-hw, hh, 0.0f) - eyePos);
+            const glm::vec3 ex = eyeRotInv * (quadRot * glm::vec3(2.0f * hw, 0.0f, 0.0f));
+            const glm::vec3 ey = eyeRotInv * (quadRot * glm::vec3(0.0f, -2.0f * hh, 0.0f));
+            for (int k = 0; k < 3; ++k)
+            {
+                placed.quadCorner[k] = c0[k];
+                placed.quadEdgeX[k] = ex[k];
+                placed.quadEdgeY[k] = ey[k];
+            }
+            placed.eyeTan[0] = tl; placed.eyeTan[1] = tr; placed.eyeTan[2] = tu; placed.eyeTan[3] = td;
+        }
+        float u0 = 1e9f, u1 = -1e9f, v0 = 1e9f, v1 = -1e9f;
+        bool inFront = true;
+        for (const glm::vec3& c : corners)
+        {
+            const glm::vec3 inEye = eyeRotInv * (quadPos + quadRot * c - eyePos);
+            if (inEye.z > -0.01f)
+            {
+                inFront = false;
+                break;
+            }
+            const float u = (inEye.x / -inEye.z - tl) / (tr - tl);
+            const float v = (tu - inEye.y / -inEye.z) / (tu - td);
+            u0 = std::min(u0, u); u1 = std::max(u1, u);
+            v0 = std::min(v0, v); v1 = std::max(v1, v);
+        }
+        if (inFront && u1 > u0 && v1 > v0)
+        {
+            placed.placeX = u0;
+            placed.placeY = v0;
+            placed.placeW = u1 - u0;
+            placed.placeH = v1 - v0;
+        }
+        else
+        {
+            // a corner behind the eye: no bounding box, but the ray cast still draws what is in front
+            placed.placeX = 0.0f;
+            placed.placeY = 0.0f;
+            placed.placeW = 1.0f;
+            placed.placeH = 1.0f;
+        }
+        if (eye == 0)
+        {
+            frameSource.left = std::move(placed);
+        }
+        else
+        {
+            frameSource.right = std::move(placed);
+        }
+    }
+
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true))
+    {
+        spdlog::info("OXRSys: streaming a quad-only frame: quad {:.2f}x{:.2f} m at ({:.2f},{:.2f},{:.2f}), "
+                     "source {}x{}, eye {}x{}, left eye rect {:.3f},{:.3f} {:.3f}x{:.3f}, right {:.3f},{:.3f} {:.3f}x{:.3f}",
+                     quad.size.width, quad.size.height, quad.pose.position.x, quad.pose.position.y,
+                     quad.pose.position.z, image.sourceWidth, image.sourceHeight, eyeW, eyeH,
+                     frameSource.left.placeX, frameSource.left.placeY, frameSource.left.placeW,
+                     frameSource.left.placeH, frameSource.right.placeX, frameSource.right.placeY,
+                     frameSource.right.placeW, frameSource.right.placeH);
+    }
+}
+
