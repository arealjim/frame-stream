+// A quad layer drawn into a black eye texture at the rectangle its corners project to (see
+// Session::BuildQuadFrameSource). A box of taps x taps samples per pixel keeps text readable when
+// the panel is drawn smaller than its source.
+constexpr const char* kQuadPlaceMetalSource = R"METAL(
+#include <metal_stdlib>
+using namespace metal;
+
+struct QuadPlaceUniforms
+{
+    float2 eyeSize;
+    float2 srcSize;
+    float4 place;
+    uint taps;
+    uint debugTint;
+    uint pad0;
+    uint pad1;
+    float4 corner;
+    float4 edgeX;
+    float4 edgeY;
+    float4 eyeTan;
+};
+
+vertex float4 quad_place_vs(uint vid [[vertex_id]])
+{
+    float2 p = float2((vid << 1) & 2, vid & 2);
+    return float4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+
+fragment float4 quad_place_fs(float4 pos [[position]],
+                              texture2d<float> src [[texture(0)]],
+                              constant QuadPlaceUniforms& u [[buffer(0)]])
+{
+    constexpr sampler s(filter::linear, address::clamp_to_edge);
+    // cast this pixel's ray from the eye onto the quad's plane (eye space, -Z forward)
+    float2 e = pos.xy / u.eyeSize;
+    float3 d = float3(mix(u.eyeTan.x, u.eyeTan.y, e.x), mix(u.eyeTan.z, u.eyeTan.w, e.y), -1.0);
+    float3 n = cross(u.edgeX.xyz, u.edgeY.xyz);
+    float denom = dot(d, n);
+    float lambda = abs(denom) > 1e-8 ? dot(u.corner.xyz, n) / denom : -1.0;
+    float3 r = lambda * d - u.corner.xyz;
+    float2 q = float2(dot(r, u.edgeX.xyz) / dot(u.edgeX.xyz, u.edgeX.xyz),
+                      dot(r, u.edgeY.xyz) / dot(u.edgeY.xyz, u.edgeY.xyz));
+    float2 step = abs(dfdx(q)) + abs(dfdy(q));
+    if (lambda <= 0.0 || any(q < 0.0) || any(q > 1.0))
+    {
+        return float4(0.0, 0.0, 0.0, 1.0);
+    }
+    float4 acc = float4(0.0);
+    for (uint j = 0; j < u.taps; ++j)
+    {
+        for (uint i = 0; i < u.taps; ++i)
+        {
+            float2 o = (float2(i, j) + 0.5) / float(u.taps) - 0.5;
+            acc += src.sample(s, q + o * step);
+        }
+    }
+    float3 c = acc.rgb / float(u.taps * u.taps);
+    if (u.debugTint != 0)
+    {
+        c = c * 0.5 + float3(0.5, 0.0, 0.0);
+    }
+    return float4(c, 1.0);
+}
+)METAL";
+
+struct QuadPlaceUniforms
+{
+    simd_float2 eyeSize;
+    simd_float2 srcSize;
+    simd_float4 place;
+    uint32_t taps;
+    uint32_t debugTint;
+    uint32_t pad[2];
+    simd_float4 corner;
+    simd_float4 edgeX;
+    simd_float4 edgeY;
+    simd_float4 eyeTan;
+};
+
+id<MTLRenderPipelineState> QuadPlacePipeline(id<MTLDevice> device, MTLPixelFormat format)
+{
+    static std::mutex mutex;
+    static std::vector<std::pair<MTLPixelFormat, id<MTLRenderPipelineState>>> cache;
+    std::lock_guard<std::mutex> lock(mutex);
+    for (const auto& entry : cache)
+    {
+        if (entry.first == format)
+        {
+            return entry.second;
+        }
+    }
+    NSError* error = nil;
+    id<MTLLibrary> library =
+        [device newLibraryWithSource:[NSString stringWithUTF8String:kQuadPlaceMetalSource] options:nil error:&error];
+    if (library == nil)
+    {
+        spdlog::error("VideoEncoder: failed to compile the quad placement shader: {}",
+                      error != nil ? error.localizedDescription.UTF8String : "unknown error");
+        return nil;
+    }
+    id<MTLFunction> vs = [library newFunctionWithName:@"quad_place_vs"];
+    id<MTLFunction> fs = [library newFunctionWithName:@"quad_place_fs"];
+    MTLRenderPipelineDescriptor* desc = [[MTLRenderPipelineDescriptor alloc] init];
+    desc.vertexFunction = vs;
