diff --git a/runtime/src/RttProbe.cpp b/runtime/src/RttProbe.cpp
new file mode 100644
index 0000000..5ab9bf8
--- /dev/null
+++ b/runtime/src/RttProbe.cpp
@@ -0,0 +1,383 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#include "RttProbe.h"
+
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cerrno>
+#include <cstring>
+#include <vector>
+
+#if defined(__APPLE__) || defined(__linux__)
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#define OXRSYS_RTT_PROBE_SUPPORTED 1
+#endif
+
+namespace
+{
+int64_t NowNs()
+{
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+uint16_t InternetChecksum(const uint8_t* data, size_t size)
+{
+    uint32_t sum = 0;
+    for (size_t i = 0; i + 1 < size; i += 2)
+    {
+        sum += static_cast<uint32_t>((data[i] << 8) | data[i + 1]);
+    }
+    if (size & 1)
+    {
+        sum += static_cast<uint32_t>(data[size - 1] << 8);
+    }
+    while (sum >> 16)
+    {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    return static_cast<uint16_t>(~sum);
+}
+} // namespace
+
+RttProbe::~RttProbe()
+{
+    Shutdown();
+}
+
+void RttProbe::SetTarget(const std::string& ipv4)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (ipv4 == target_)
+    {
+        return;
+    }
+    target_ = ipv4;
+    targetGeneration_++;
+    samplesMs_.clear();
+    lost_ = 0;
+    sent_ = 0;
+    sendFailures_ = 0;
+    lastSendErrno_ = 0;
+#ifdef OXRSYS_RTT_PROBE_SUPPORTED
+    if (!target_.empty() && !thread_.joinable() && !stop_)
+    {
+        thread_ = std::thread(&RttProbe::ThreadMain, this);
+    }
+#endif
+    cv_.notify_all();
+}
+
+void RttProbe::Shutdown()
+{
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stop_ = true;
+        target_.clear();
+        cv_.notify_all();
+    }
+    if (thread_.joinable())
+    {
+        thread_.join();
+    }
+}
+
+RttProbe::Summary RttProbe::GetSummary() const
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    Summary summary;
+    summary.lost = lost_;
+    summary.sent = sent_;
+    summary.sendFailures = sendFailures_;
+    summary.lastSendErrno = lastSendErrno_;
+    summary.samples = static_cast<uint32_t>(samplesMs_.size());
+    if (samplesMs_.size() < 3)
+    {
+        return summary;
+    }
+    std::vector<float> sorted(samplesMs_.begin(), samplesMs_.end());
+    std::sort(sorted.begin(), sorted.end());
+    summary.valid = true;
+    summary.medianMs = sorted[sorted.size() / 2];
+    summary.minMs = sorted.front();
+    summary.maxMs = sorted.back();
+    return summary;
+}
+
+namespace
+{
+#ifdef OXRSYS_RTT_PROBE_SUPPORTED
+struct ProbeResult
+{
+    bool sent = false;
+    int sendErrno = 0;
+    float rttMs = -1.0f;
+    int recvErrno = 0; // UDP: what recv said instead of ECONNREFUSED (0 = timed out)
+};
+
+// Wait up to the deadline for something readable (or an error) on a non-blocking socket.
+bool WaitReadable(int sock, int64_t deadlineNs)
+{
+    const int64_t remainingMs = (deadlineNs - NowNs()) / 1000000;
+    if (remainingMs <= 0)
+    {
+        return false;
+    }
+    pollfd pfd = {sock, POLLIN, 0};
+    return poll(&pfd, 1, static_cast<int>(remainingMs)) > 0;
+}
+
+ProbeResult ProbeIcmp(int sock, const sockaddr_in& addr, uint16_t ident, uint16_t sequence,
+                      int timeoutMs)
+{
+    ProbeResult result;
+    uint8_t packet[64] = {};
+    packet[0] = 8; // echo request
+    packet[4] = static_cast<uint8_t>(ident >> 8);
+    packet[5] = static_cast<uint8_t>(ident & 0xff);
+    packet[6] = static_cast<uint8_t>(sequence >> 8);
+    packet[7] = static_cast<uint8_t>(sequence & 0xff);
+    const int64_t sentNs = NowNs();
+    memcpy(packet + 8, &sentNs, sizeof(sentNs));
+    const uint16_t checksum = InternetChecksum(packet, sizeof(packet));
+    packet[2] = static_cast<uint8_t>(checksum >> 8);
+    packet[3] = static_cast<uint8_t>(checksum & 0xff);
+    result.sent = sendto(sock, packet, sizeof(packet), 0, reinterpret_cast<const sockaddr*>(&addr),
+                         sizeof(addr)) == static_cast<ssize_t>(sizeof(packet));
+    result.sendErrno = result.sent ? 0 : errno;
+
+    const int64_t deadlineNs = sentNs + int64_t(timeoutMs) * 1000000;
+    while (result.sent && result.rttMs < 0.0f && WaitReadable(sock, deadlineNs))
+    {
+        uint8_t reply[512];
+        const ssize_t got = recv(sock, reply, sizeof(reply), MSG_DONTWAIT);
+        const int64_t gotNs = NowNs();
+        if (got <= 0)
+        {
+            if (got < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+            {
+                continue;
+            }
+            break;
+        }
+        // macOS hands a datagram ICMP socket the IP header too; Linux does not.
+        size_t offset = 0;
+        if (got >= 20 && (reply[0] >> 4) == 4)
+        {
+            offset = static_cast<size_t>(reply[0] & 0x0f) * 4;
+        }
+        if (static_cast<size_t>(got) < offset + 16 || reply[offset] != 0)
+        {
+            continue; // not an echo reply
+        }
+        const uint16_t replySeq = static_cast<uint16_t>((reply[offset + 6] << 8) | reply[offset + 7]);
+        int64_t echoedNs = 0;
+        memcpy(&echoedNs, reply + offset + 8, sizeof(echoedNs));
+        if (replySeq == sequence && echoedNs == sentNs)
+        {
+            result.rttMs = static_cast<float>(gotNs - sentNs) / 1.0e6f;
+        }
+    }
+    return result;
+}
+
+// One byte to a closed UDP port: the client's kernel answers port-unreachable, which a connected
+// socket reports as ECONNREFUSED. Linux rate-limits that answer to about one a second per peer
+// (icmp_ratelimit 1000 ms, burst 6), so this runs at 1 Hz. One socket for the whole run (no
+// descriptor churn inside the host process), SO_NOSIGPIPE so no error on it can raise a signal.
+int OpenUdpProbeSocket(const sockaddr_in& addr, int& errOut)
+{
+    int sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (sock < 0)
+    {
+        errOut = errno;
+        return -1;
+    }
+#ifdef SO_NOSIGPIPE
+    int one = 1;
+    setsockopt(sock, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#endif
+    fcntl(sock, F_SETFL, fcntl(sock, F_GETFL, 0) | O_NONBLOCK);
+    if (connect(sock, reinterpret_cast<const sockaddr*>(&addr), sizeof(addr)) != 0)
+    {
+        errOut = errno;
+        close(sock);
+        return -1;
+    }
+    return sock;
+}
+
+ProbeResult ProbeUdpUnreachable(int sock, int timeoutMs)
+{
+    ProbeResult result;
+    // Drain anything pending (a late refusal from the previous probe) before timing this one.
+    uint8_t scratch[64];
+    for (int i = 0; i < 4 && recv(sock, scratch, sizeof(scratch), MSG_DONTWAIT) != -1; ++i)
+    {
+    }
+    int pending = 0;
+    socklen_t len = sizeof(pending);
+    getsockopt(sock, SOL_SOCKET, SO_ERROR, &pending, &len);
+
+    const uint8_t byte = 0;
+    const int64_t sentNs = NowNs();
+    result.sent = send(sock, &byte, 1, 0) == 1;
+    result.sendErrno = result.sent ? 0 : errno;
+    const int64_t deadlineNs = sentNs + int64_t(timeoutMs) * 1000000;
+    while (result.sent && result.rttMs < 0.0f && WaitReadable(sock, deadlineNs))
+    {
+        const ssize_t got = recv(sock, scratch, sizeof(scratch), MSG_DONTWAIT);
+        const int64_t gotNs = NowNs();
+        if (got < 0 && errno == ECONNREFUSED)
+        {
+            result.rttMs = static_cast<float>(gotNs - sentNs) / 1.0e6f;
+        }
+        else if (got < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+        {
+            continue;
+        }
+        else
+        {
+            result.recvErrno = got < 0 ? errno : -1;
+            break; // data (the port is open) or another error: no measurement
+        }
+    }
+    return result;
+}
+#endif
+} // namespace
+
+void RttProbe::ThreadMain()
+{
+#ifdef OXRSYS_RTT_PROBE_SUPPORTED
+    // ICMP echo first; a process the OS will not let send ICMP (measured 2026-10-18: inside
+    // Godot on macOS 27 every echo fails "No route to host" while its UDP flows) falls back to
+    // UDP port-unreachable after three refusals.
+    int icmpSock = socket(AF_INET, SOCK_DGRAM, IPPROTO_ICMP);
+    if (icmpSock >= 0)
+    {
+        fcntl(icmpSock, F_SETFL, fcntl(icmpSock, F_GETFL, 0) | O_NONBLOCK);
+    }
+    bool useUdp = icmpSock < 0;
+    int udpSock = -1;
+    std::string udpTarget;
+    uint32_t icmpRefusals = 0;
+    const uint16_t ident = static_cast<uint16_t>(getpid() & 0xffff);
+    uint16_t sequence = 0;
+    spdlog::info("RttProbe: measuring RTT to the streaming client by {}",
+                 useUdp ? "UDP port-unreachable (1 Hz)" : "ICMP echo (4 Hz)");
+
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (!stop_)
+    {
+        if (target_.empty())
+        {
+            cv_.wait(lock, [this] { return stop_ || !target_.empty(); });
+            continue;
+        }
+        const std::string target = target_;
+        const uint64_t generation = targetGeneration_;
+        lock.unlock();
+
+        sockaddr_in addr = {};
+        addr.sin_family = AF_INET;
+        ProbeResult result;
+        const bool addrOk = inet_pton(AF_INET, target.c_str(), &addr.sin_addr) == 1;
+        if (addrOk && !useUdp)
+        {
+            result = ProbeIcmp(icmpSock, addr, ident, ++sequence, kReplyTimeoutMs);
+            if (!result.sent && ++icmpRefusals >= 3)
+            {
+                useUdp = true;
+                spdlog::info("RttProbe: ICMP echo refused ({}); measuring by UDP port-unreachable "
+                             "to {}:{} at 1 Hz instead", strerror(result.sendErrno), target,
+                             kUdpProbePort);
+            }
+        }
+        else if (addrOk)
+        {
+            if (udpSock >= 0 && udpTarget != target)
+            {
+                close(udpSock);
+                udpSock = -1;
+            }
+            if (udpSock < 0)
+            {
+                addr.sin_port = htons(kUdpProbePort);
+                udpSock = OpenUdpProbeSocket(addr, result.sendErrno);
+                udpTarget = target;
+            }
+            if (udpSock >= 0)
+            {
+                result = ProbeUdpUnreachable(udpSock, kReplyTimeoutMs);
+                if (!result.sent || result.rttMs < 0.0f)
+                {
+                    // macOS can latch a connected UDP socket into EPIPE after an unanswered
+                    // probe; a fresh socket next time costs nothing at 1 Hz.
+                    close(udpSock);
+                    udpSock = -1;
+                }
+            }
+        }
+
+        lock.lock();
+        if (generation == targetGeneration_ && !stop_)
+        {
+            if (result.sent)
+            {
+                sent_++;
+            }
+            else
+            {
+                sendFailures_++;
+                lastSendErrno_ = result.sendErrno;
+                if (sendFailures_ == 1 || sendFailures_ % 100 == 0)
+                {
+                    spdlog::warn("RttProbe: probe to {} not sent ({} failures, last: {})", target,
+                                 sendFailures_, strerror(result.sendErrno));
+                }
+            }
+            if (result.rttMs >= 0.0f)
+            {
+                if (samplesMs_.empty() && lost_ == 0)
+                {
+                    spdlog::info("RttProbe: first reply from {} in {:.2f} ms", target, result.rttMs);
+                }
+                samplesMs_.push_back(result.rttMs);
+                while (samplesMs_.size() > kWindow)
+                {
+                    samplesMs_.pop_front();
+                }
+            }
+            else if (result.sent)
+            {
+                lost_++;
+                if (useUdp && (lost_ == 1 || lost_ % 100 == 0))
+                {
+                    spdlog::warn("RttProbe: UDP probe to {} unanswered ({} lost, recv said: {})", target,
+                                 lost_, result.recvErrno > 0 ? strerror(result.recvErrno)
+                                        : result.recvErrno < 0 ? "data" : "timeout");
+                }
+            }
+        }
+        cv_.wait_for(lock, std::chrono::milliseconds(useUdp ? kUdpIntervalMs : kIntervalMs),
+                     [this, generation] { return stop_ || generation != targetGeneration_; });
+    }
+    lock.unlock();
+    if (icmpSock >= 0)
+    {
+        close(icmpSock);
+    }
+    if (udpSock >= 0)
+    {
+        close(udpSock);
+    }
+#endif
+}
diff --git a/runtime/src/RttProbe.h b/runtime/src/RttProbe.h
new file mode 100644
index 0000000..d9e29bd
--- /dev/null
+++ b/runtime/src/RttProbe.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+
+/**
+ * Round-trip time to the streaming client, measured with ICMP echo.
+ *
+ * The streaming protocol carries no ping/pong and no clock sync (the tracking timestamp is the
+ * client's XrTime, the video timestamps are the server's steady clock), so the server cannot
+ * see the network's share of sample->display latency from its own traffic. An unprivileged ICMP
+ * datagram socket (macOS allows SOCK_DGRAM/IPPROTO_ICMP without root) answers it with no client
+ * change: the headset's kernel replies, a few times a second, 64 bytes each way. What it
+ * measures is uplink + downlink one-way delay for a small packet - exactly the sum that a tracking
+ * sample (up) and the frame rendered from it (down) both pay. It does not include the airtime of a
+ * frame's burst behind its first packet, nor client userspace scheduling.
+ *
+ * Where the process may not send ICMP, it falls back to one UDP byte to a closed port (9) on the
+ * client: the client kernel's port-unreachable answer comes back as ECONNREFUSED, the same
+ * small-packet round trip.
+ */
+class RttProbe
+{
+public:
+    RttProbe() = default;
+    ~RttProbe();
+
+    RttProbe(const RttProbe&) = delete;
+    RttProbe& operator=(const RttProbe&) = delete;
+
+    // Probe this IPv4 address; an empty string idles the probe and forgets the samples.
+    void SetTarget(const std::string& ipv4);
+    void Shutdown();
+
+    struct Summary
+    {
+        bool valid = false;
+        float medianMs = 0.0f;
+        float minMs = 0.0f;
+        float maxMs = 0.0f;
+        uint32_t samples = 0;
+        uint32_t lost = 0;   // since the target was set
+        uint32_t sent = 0;
+        uint32_t sendFailures = 0;
+        int lastSendErrno = 0;
+    };
+    Summary GetSummary() const;
+
+private:
+    void ThreadMain();
+
+    mutable std::mutex mutex_;
+    std::condition_variable cv_;
+    std::thread thread_;
+    bool stop_ = false;
+    std::string target_;
+    uint64_t targetGeneration_ = 0;
+    std::deque<float> samplesMs_;
+    uint32_t lost_ = 0;
+    uint32_t sent_ = 0;
+    uint32_t sendFailures_ = 0;
+    int lastSendErrno_ = 0;
+
+    static constexpr size_t kWindow = 17;      // ~4 s at 4 Hz; the median of it is used
+    static constexpr int kIntervalMs = 250;
+    static constexpr int kReplyTimeoutMs = 200;
+    static constexpr int kUdpIntervalMs = 1000;
+    static constexpr uint16_t kUdpProbePort = 9;   // discard: closed on the Steam Frame
+};
