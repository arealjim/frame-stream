+
+void TrackingReceiver::ScorePendingPredictionsLocked(const HistorySample& previous,
+                                                      const HistorySample& current)
+{
+    const int64_t t0 = previous.packet.timestampNs;
+    const int64_t t1 = current.packet.timestampNs;
+    if (t0 <= 0 || t1 <= t0)
+    {
+        return;
+    }
+    // A target older than the history this pair spans was missed (a gap); drop it unscored.
+    while (!pendingPredictions_.empty() && pendingPredictions_.front().targetTimestampNs < t0)
+    {
+        pendingPredictions_.pop_front();
+    }
+    while (!pendingPredictions_.empty() && pendingPredictions_.front().targetTimestampNs <= t1)
+    {
+        const PendingPrediction& p = pendingPredictions_.front();
+        const float u = static_cast<float>(p.targetTimestampNs - t0) / static_cast<float>(t1 - t0);
+        const glm::quat q0 = LoadQuat(previous.packet.headOrientation);
+        glm::quat q1 = LoadQuat(current.packet.headOrientation);
+        if (glm::dot(q0, q1) < 0.0f) q1 = -q1;
+        const glm::quat truth = glm::normalize(glm::slerp(q0, q1, u));
+        const glm::vec3 truthPos = glm::mix(LoadVec3(previous.packet.headPosition),
+                                            LoadVec3(current.packet.headPosition), u);
+        auto angleDeg = [](const glm::quat& a, const glm::quat& b) {
+            const float d = std::min(1.0f, std::abs(glm::dot(a, b)));
+            return glm::degrees(2.0f * std::acos(d));
+        };
+        scoredRotErrDeg_.push_back(angleDeg(LoadQuat(p.predicted), truth));
+        scoredUnpredictedRotDeg_.push_back(angleDeg(LoadQuat(p.sample), truth));
+        scoredPosErrMmSum_ += glm::length(LoadVec3(p.predictedPos) - truthPos) * 1000.0;
+        scoredUnpredictedPosMmSum_ += glm::length(LoadVec3(p.samplePos) - truthPos) * 1000.0;
+        pendingPredictions_.pop_front();
+    }
+    if (scoredRotErrDeg_.size() > 4096)
+    {
+        scoredRotErrDeg_.clear();
+        scoredUnpredictedRotDeg_.clear();
+        scoredPosErrMmSum_ = 0.0;
+        scoredUnpredictedPosMmSum_ = 0.0;
+    }
+}
