@@ -228,6 +228,9 @@ class VideoEncoder
     bool tenBit_ = false;
     bool forceSoftwareForTesting_ = false;
     bool inProcessSessionHardware_ = false;
+    // True only for a session that writes video range from the BGRA surface unaided
+    // (the classic ave hardware encoder); otherwise frames are converted first.
+    bool inProcessSessionKeepsVideoRange_ = false;
 
     // Which process encodes, and why — decided once in Initialize() from an
     // actual VideoToolbox hardware-encoder query plus the encoder_helper
diff --git a/runtime/src/VideoEncoder.mm b/runtime/src/VideoEncoder.mm
index d24c0e5..dc912bc 100644
--- a/runtime/src/VideoEncoder.mm
+++ b/runtime/src/VideoEncoder.mm
@@ -17,6 +17,8 @@
 
 #import <spdlog/spdlog.h>
 
+#include "EncoderSessionKind.h"
+
 #include <algorithm>
 #include <chrono>
 #include <cmath>
@@ -1144,21 +1146,47 @@ bool VideoEncoder::Initialize(uint32_t width, uint32_t height, uint32_t fps,
     // RequireHardware=NO meant a Rosetta host ran the software HEVC encoder with
     // nothing in the log to say so; a line here makes that impossible.
     {
-        bool sessionUsesHardware = false;
         CFBooleanRef hardwareRef = nullptr;
-        if (VTSessionCopyProperty(compressionSession,
-                                  kVTCompressionPropertyKey_UsingHardwareAcceleratedVideoEncoder,
-                                  kCFAllocatorDefault, &hardwareRef) == noErr &&
-            hardwareRef != nullptr)
+        const OSStatus hardwareQuery = VTSessionCopyProperty(compressionSession,
+            kVTCompressionPropertyKey_UsingHardwareAcceleratedVideoEncoder,
+            kCFAllocatorDefault, &hardwareRef);
+        const bool hardwareQueryAnswered = hardwareQuery == noErr && hardwareRef != nullptr;
+        bool hardwareQueryValue = false;
+        if (hardwareRef != nullptr)
         {
-            sessionUsesHardware = CFBooleanGetValue(hardwareRef);
+            hardwareQueryValue = CFBooleanGetValue(hardwareRef);
             CFRelease(hardwareRef);
         }
+        std::string encoderId;
+        CFStringRef encoderIdRef = nullptr;
+        if (VTSessionCopyProperty(compressionSession, kVTCompressionPropertyKey_EncoderID,
+                                  kCFAllocatorDefault, &encoderIdRef) == noErr &&
+            encoderIdRef != nullptr)
+        {
+            if (const char* utf8 = [(__bridge NSString*)encoderIdRef UTF8String])
+            {
+                encoderId = utf8;
+            }
+            CFRelease(encoderIdRef);
+        }
+        // The low-latency (rtvc) hardware session answers the hardware query with
+        // kVTPropertyNotSupportedErr; the encoder id settles it (EncoderSessionKind.h).
+        const oxrsys::EncoderSessionKind sessionKind =
+            oxrsys::ClassifyEncoderSession(hardwareQueryAnswered, hardwareQueryValue, encoderId);
+        const bool sessionUsesHardware = sessionKind == oxrsys::EncoderSessionKind::Hardware;
+        inProcessSessionKeepsVideoRange_ =
+            oxrsys::SessionWritesVideoRangeFromBGRA(sessionKind, encoderId);
+        if (!hardwareQueryAnswered)
+        {
+            spdlog::info("VideoEncoder: hardware query unsupported on this session (status {}), "
+                         "classified from encoder id '{}'",
+                         hardwareQuery, encoderId.empty() ? "?" : encoderId);
+        }
         inProcessSessionHardware_ = sessionUsesHardware;
         if (sessionUsesHardware)
         {
-            spdlog::info("VideoEncoder: in-process {} session is hardware-accelerated",
-                         VideoCodecName(codec_));
+            spdlog::info("VideoEncoder: in-process {} session is hardware-accelerated ({})",
+                         VideoCodecName(codec_), encoderId.empty() ? "?" : encoderId);
         }
         else if (encodePath_.useHelper)
         {
@@ -1180,7 +1208,7 @@ bool VideoEncoder::Initialize(uint32_t width, uint32_t height, uint32_t fps,
     // and this session takes over mid-stream. Hand it an explicitly video-range
     // 4:2:0 conversion of each frame instead; see EncoderSessionColor.h. Set up
     // now, not on helper death, so the fallback never allocates on the frame path.
-    if (!inProcessSessionHardware_ && !CreateVideoRangeConversion(width, height))
+    if (!inProcessSessionKeepsVideoRange_ && !CreateVideoRangeConversion(width, height))
     {
         spdlog::warn("VideoEncoder: could not set up the video-range conversion for the software "
                      "{} session - its stream may signal full range",
@@ -1235,8 +1263,9 @@ bool VideoEncoder::CreateVideoRangeConversion(uint32_t width, uint32_t height)
     }
     videoToolbox_.videoRangeTransfer = transfer;
     videoToolbox_.videoRangePool = pool;
-    spdlog::info("VideoEncoder: software {} session is fed a BT.709 video-range 4:2:0 conversion "
-                 "of each frame, keeping the stream limited-range",
+    spdlog::info("VideoEncoder: {} {} session is fed a BT.709 video-range 4:2:0 conversion "
+                 "of each frame, keeping the stream limited-range (about 1 ms of submit per frame)",
+                 inProcessSessionHardware_ ? "low-latency hardware" : "software",
                  VideoCodecName(codec_));
     return true;
 }
diff --git a/tests/TestEncoderSessionKind.cpp b/tests/TestEncoderSessionKind.cpp
new file mode 100644
index 0000000..803da50
--- /dev/null
+++ b/tests/TestEncoderSessionKind.cpp
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "EncoderSessionKind.h"
+
+using oxrsys::ClassifyEncoderSession;
+using oxrsys::EncoderSessionKind;
+using oxrsys::SessionWritesVideoRangeFromBGRA;
+
+TEST_CASE("Encoder session kind: the hardware property wins when it answers", "[encoder-session]")
+{
+    CHECK(ClassifyEncoderSession(true, true, "com.apple.videotoolbox.videoencoder.ave.hevc") ==
+          EncoderSessionKind::Hardware);
+    CHECK(ClassifyEncoderSession(true, false, "com.apple.videotoolbox.videoencoder.hevc") ==
+          EncoderSessionKind::Software);
+    // Even an id that looks like hardware does not override an explicit "no".
+    CHECK(ClassifyEncoderSession(true, false, "com.apple.videotoolbox.videoencoder.ave.hevc") ==
+          EncoderSessionKind::Software);
+}
+
+TEST_CASE("Encoder session kind: low-latency rtvc session is hardware although the property fails",
+          "[encoder-session]")
+{
+    // Measured 2026-10-17: EnableLowLatencyRateControl -> encoder id hevc.rtvc, and the
+    // UsingHardwareAcceleratedVideoEncoder query returns kVTPropertyNotSupportedErr.
+    CHECK(ClassifyEncoderSession(false, false, "com.apple.videotoolbox.videoencoder.hevc.rtvc") ==
+          EncoderSessionKind::Hardware);
+    CHECK(ClassifyEncoderSession(false, false, "com.apple.videotoolbox.videoencoder.ave.avc") ==
+          EncoderSessionKind::Hardware);
+}
+
+TEST_CASE("Encoder session kind: no answer and a software id is software; no id at all is unknown",
+          "[encoder-session]")
+{
+    CHECK(ClassifyEncoderSession(false, false, "com.apple.videotoolbox.videoencoder.h264.gva") ==
+          EncoderSessionKind::Software);
+    CHECK(ClassifyEncoderSession(false, false, "") == EncoderSessionKind::Unknown);
+}
+
+TEST_CASE("Encoder session kind: only the classic ave hardware encoder keeps video range from BGRA",
+          "[encoder-session]")
+{
+    CHECK(SessionWritesVideoRangeFromBGRA(EncoderSessionKind::Hardware,
+                                          "com.apple.videotoolbox.videoencoder.ave.hevc"));
+    CHECK(SessionWritesVideoRangeFromBGRA(EncoderSessionKind::Hardware,
+                                          "com.apple.videotoolbox.videoencoder.ave.avc"));
+    // The low-latency rtvc session is hardware but writes full range for BGRA: convert.
+    CHECK_FALSE(SessionWritesVideoRangeFromBGRA(EncoderSessionKind::Hardware,
+                                                "com.apple.videotoolbox.videoencoder.hevc.rtvc"));
+    CHECK_FALSE(SessionWritesVideoRangeFromBGRA(EncoderSessionKind::Software,
+                                                "com.apple.videotoolbox.videoencoder.hevc"));
+    CHECK_FALSE(SessionWritesVideoRangeFromBGRA(EncoderSessionKind::Unknown, ""));
+}
