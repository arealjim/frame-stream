+// The depth aspect as vkCmdCopyImageToBuffer writes it: D24 formats pack into 32-bit words.
+bool DepthTexelLayout(VkFormat format, uint32_t& bytesPerTexel, oxrsys::depthgrid::TexelKind& kind)
+{
+    switch (format)
+    {
+    case VK_FORMAT_D16_UNORM:
+        bytesPerTexel = 2;
+        kind = oxrsys::depthgrid::TexelKind::Unorm16;
+        return true;
+    case VK_FORMAT_D24_UNORM_S8_UINT:
+    case VK_FORMAT_X8_D24_UNORM_PACK32:
+        bytesPerTexel = 4;
+        kind = oxrsys::depthgrid::TexelKind::Unorm24;
+        return true;
+    case VK_FORMAT_D32_SFLOAT:
+    case VK_FORMAT_D32_SFLOAT_S8_UINT:
+        bytesPerTexel = 4;
+        kind = oxrsys::depthgrid::TexelKind::Float32;
+        return true;
+    default:
+        return false;
+    }
+}
