+// ─── Depth grid (positional reprojection) ────────────────────────────────
+// The app's submitted depth (XR_KHR_composition_layer_depth), reduced to a grid x grid inverse-depth image per eye,
+// sent only to a client that set CLIENT_CAPABILITY_DEPTH_GRID. Value q (0-255) = round(255 * nearMm / z), clamped:
+// 255 = at or nearer than nearMm, 0 = infinitely far. Rows run top to bottom in the eye's image space, the same space
+// as that eye's colour (before foveation). Wi-Fi: a VideoPacketHeader with VIDEO_FLAG_RENDER_POSE and totalPackets 0
+// whose payload starts with this header (a render pose is 28 bytes and has no magic); USB: TcpRecordType::DepthGrid.
+constexpr uint32_t DEPTH_GRID_MAGIC = 0x44475244; // "DRGD" little-endian
+constexpr uint32_t DEPTH_GRID_MAX_SIZE = 128;
+
+struct DepthGridHeader
+{
+    uint32_t magic = DEPTH_GRID_MAGIC;
+    uint32_t frameIndex = 0;  // the server's frame counter at capture (diagnostic; the client uses the newest)
+    uint8_t eye = 0;          // 0 left, 1 right
+    uint8_t grid = 0;         // columns = rows of the full grid
+    uint8_t row0 = 0;         // first row in this chunk
+    uint8_t rows = 0;         // rows in this chunk; payload after the header is rows * grid bytes
+    uint16_t nearMm = 250;    // the distance q = 255 stands for
+    uint16_t reserved = 0;
+};
+
 struct AudioPacketHeader
 {
     int64_t presentationTimeNs = 0;
