+// XR_KHR_composition_layer_depth on a projection view: the depth swapchain's release-time row
+// capture plus its mapping, for positional reprojection on the client. Depth the runtime cannot use
+// (no capture, bad rect or range) is ignored rather than failing the app's frame.
+void Session::CollectProjectionDepth(const XrCompositionLayerProjectionView& view,
+                                     FrameDepthSource& depth) const
+{
+    depth = {};
+    for (auto* next = reinterpret_cast<const XrBaseInStructure*>(view.next); next != nullptr;
+         next = next->next)
+    {
+        if (next->type != XR_TYPE_COMPOSITION_LAYER_DEPTH_INFO_KHR)
+        {
+            continue;
+        }
+        const auto& info = *reinterpret_cast<const XrCompositionLayerDepthInfoKHR*>(next);
+        auto* swapchain =
+            Runtime::Get().FromHandle<Swapchain>(reinterpret_cast<uint64_t>(info.subImage.swapchain));
+        const XrRect2Di& rect = info.subImage.imageRect;
+        if (swapchain == nullptr || rect.offset.x < 0 || rect.offset.y < 0 ||
+            rect.extent.width <= 0 || rect.extent.height <= 0)
+        {
+            return;
+        }
+        depth.rows = swapchain->GetLastReleasedDepthRows(info.subImage.imageArrayIndex);
+        depth.rectX = static_cast<uint32_t>(rect.offset.x);
+        depth.rectY = static_cast<uint32_t>(rect.offset.y);
+        depth.rectWidth = static_cast<uint32_t>(rect.extent.width);
+        depth.rectHeight = static_cast<uint32_t>(rect.extent.height);
+        depth.range = {info.minDepth, info.maxDepth, info.nearZ, info.farZ};
+        static std::atomic_bool loggedFirstDepth{false};
+        if (!loggedFirstDepth.exchange(true))
+        {
+            spdlog::info("OXRSys: app submits depth: {}x{} at {},{} layer {} min={} max={} nearZ={} farZ={} rows={}",
+                         rect.extent.width, rect.extent.height, rect.offset.x, rect.offset.y,
+                         info.subImage.imageArrayIndex, info.minDepth, info.maxDepth, info.nearZ,
+                         info.farZ, depth.rows.IsValid() ? "captured" : "none");
+        }
+        return;
+    }
+}
+
 XrResult Session::ValidateQuadLayer(const XrCompositionLayerQuad& layer) const
 {
     auto* space = Runtime::Get().FromHandle<Space>(reinterpret_cast<uint64_t>(layer.space));
