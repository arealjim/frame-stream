+void StreamingServer::ReduceFrameDepth(const FrameSource& source, uint32_t grid,
+                                       EncodedVideoFrame& out)
+{
+    // The depth copy was submitted at the depth image's release, before the colour image's, so it
+    // is normally done by now; never hold the encoder for long on it.
+    constexpr uint64_t kDepthWaitNs = 4'000'000;
+    constexpr float kNearM = 0.25f; // DepthGridHeader::nearMm default
+    const int64_t startNs = SteadyClockNowNs();
+    bool any = false;
+    for (int eye = 0; eye < 2; ++eye)
+    {
+        const FrameDepthSource& depth = source.depth[eye];
+        oxrsys::depthgrid::RowsView rows;
+        if (depth.IsValid() && depth.rows.waitRows(kDepthWaitNs, rows) &&
+            oxrsys::depthgrid::Reduce(rows, depth.rectX, depth.rectY, depth.rectWidth,
+                                      depth.rectHeight, depth.range, grid, kNearM, out.depth[eye]))
+        {
+            any = true;
+        }
+        else
+        {
+            out.depth[eye].clear();
+        }
+    }
+    out.depthGrid = any ? grid : 0;
+
+    const int64_t nowNs = SteadyClockNowNs();
+    const double ms = static_cast<double>(nowNs - startNs) / 1.0e6;
+    if (any)
+    {
+        ++depthGridFrames_;
+        depthGridMsSum_ += ms;
+        depthGridMsMax_ = std::max(depthGridMsMax_, ms);
+    }
+    else
+    {
+        ++depthGridMisses_;
+    }
+    if (nowNs - depthGridLogNs_ >= 1'000'000'000)
+    {
+        spdlog::info("StreamingServer: depth grid {}x{} frames={} misses={} reduce avg={:.2f}ms max={:.2f}ms",
+                     grid, grid, depthGridFrames_, depthGridMisses_,
+                     depthGridFrames_ ? depthGridMsSum_ / depthGridFrames_ : 0.0, depthGridMsMax_);
+        depthGridFrames_ = 0;
+        depthGridMisses_ = 0;
+        depthGridMsSum_ = 0.0;
+        depthGridMsMax_ = 0.0;
+        depthGridLogNs_ = nowNs;
+    }
+}
+
+void StreamingServer::SendDepthGrid(const EncodedVideoFrame& frame)
+{
+    std::string clientIp;
+    SocketHandle videoSocket = oxrsys::runtime_socket::InvalidSocket;
+    bool videoUsesTcp = false;
+    {
+        std::lock_guard<std::mutex> lock(packetDispatchState_->mutex);
+        if (!packetDispatchState_->acceptingPackets)
+        {
+            return;
+        }
+        clientIp = packetDispatchState_->clientIp;
+        videoSocket = packetDispatchState_->videoSocket;
+        videoUsesTcp = packetDispatchState_->videoUsesTcp;
+    }
+    if (!oxrsys::runtime_socket::IsValid(videoSocket) || (!videoUsesTcp && clientIp.empty()))
+    {
+        return;
+    }
+
+    const uint32_t grid = frame.depthGrid;
+    // Rows per datagram: the whole chunk under one MTU-sized payload.
+    const uint32_t rowsPerChunk = std::max<uint32_t>(
+        1, static_cast<uint32_t>((oxr::protocol::MAX_PACKET_PAYLOAD - sizeof(oxr::protocol::DepthGridHeader)) / grid));
+    sockaddr_in destAddr = {};
+    destAddr.sin_family = AF_INET;
+    destAddr.sin_port = htons(oxr::protocol::VIDEO_PORT);
+    if (!videoUsesTcp)
+    {
+        inet_pton(AF_INET, clientIp.c_str(), &destAddr.sin_addr);
+    }
+
+    std::vector<uint8_t> buf;
+    for (uint8_t eye = 0; eye < 2; ++eye)
+    {
+        const std::vector<uint8_t>& data = frame.depth[eye];
+        if (data.size() != static_cast<size_t>(grid) * grid)
+        {
+            continue;
+        }
+        if (videoUsesTcp)
+        {
+            // One record per eye: the TCP record carries the whole grid.
+            oxr::protocol::DepthGridHeader header = {};
+            header.frameIndex = frame.frameIndex;
+            header.eye = eye;
+            header.grid = static_cast<uint8_t>(grid);
+            header.row0 = 0;
+            header.rows = static_cast<uint8_t>(grid);
+            buf.resize(sizeof(header) + data.size());
+            memcpy(buf.data(), &header, sizeof(header));
+            memcpy(buf.data() + sizeof(header), data.data(), data.size());
+            std::lock_guard<std::mutex> sendLock(packetDispatchState_->sendMutex);
+            if (!SendTcpRecord(videoSocket, oxr::protocol::TcpRecordType::DepthGrid,
+                               buf.data(), buf.size()))
+            {
+                videoTcpSendFailures_.fetch_add(1);
+                MarkTcpVideoSendFailed(packetDispatchState_, videoSocket);
+                return;
+            }
+            continue;
+        }
+        for (uint32_t row0 = 0; row0 < grid; row0 += rowsPerChunk)
+        {
+            const uint32_t rows = std::min(rowsPerChunk, grid - row0);
+            oxr::protocol::DepthGridHeader header = {};
+            header.frameIndex = frame.frameIndex;
+            header.eye = eye;
+            header.grid = static_cast<uint8_t>(grid);
+            header.row0 = static_cast<uint8_t>(row0);
+            header.rows = static_cast<uint8_t>(rows);
+            // A render-pose-flagged datagram with no video packets: a client without the depth
+            // capability never gets one (the grid is only sent to a client that advertised it).
+            oxr::protocol::VideoPacketHeader packet = {};
+            packet.frameIndex = frame.frameIndex;
+            packet.packetIndex = 0;
+            packet.totalPackets = 0;
+            packet.payloadSize = static_cast<uint16_t>(sizeof(header) + rows * grid);
+            packet.flags = oxr::protocol::VIDEO_FLAG_RENDER_POSE;
+            packet.codec = static_cast<uint8_t>(frame.codec);
+            packet.presentationTimeNs = frame.timestampNs;
+            buf.resize(sizeof(packet) + sizeof(header) + rows * grid);
+            memcpy(buf.data(), &packet, sizeof(packet));
+            memcpy(buf.data() + sizeof(packet), &header, sizeof(header));
+            memcpy(buf.data() + sizeof(packet) + sizeof(header), data.data() + row0 * grid, rows * grid);
+            if (oxrsys::runtime_socket::SendTo(videoSocket, buf.data(), buf.size(), kBestEffortSendFlags,
+                                               (sockaddr*)&destAddr, sizeof(destAddr)) < 0)
+            {
+                videoUdpSendFailures_.fetch_add(1);
+            }
+        }
+    }
+}
