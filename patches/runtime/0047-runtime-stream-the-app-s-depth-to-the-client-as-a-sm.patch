diff --git a/runtime/src/DepthGrid.cpp b/runtime/src/DepthGrid.cpp
new file mode 100644
index 0000000..e25f106
--- /dev/null
+++ b/runtime/src/DepthGrid.cpp
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#include "DepthGrid.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace oxrsys::depthgrid
+{
+
+float InverseDistance(float depth, const DepthRange& range)
+{
+    const float span = range.maxDepth - range.minDepth;
+    if (!std::isfinite(depth) || !(span > 0.0f) || !(range.nearZ > 0.0f) || !(range.farZ > 0.0f) ||
+        range.nearZ == range.farZ)
+    {
+        return -1.0f;
+    }
+    const float n = std::clamp((depth - range.minDepth) / span, 0.0f, 1.0f);
+    // Perspective depth is linear in 1/z between the two planes; an infinite plane is 1/z = 0.
+    // Reversed Z puts the infinite plane at minDepth (nearZ = +inf).
+    const float invNear = std::isinf(range.nearZ) ? 0.0f : 1.0f / range.nearZ;
+    const float invFar = std::isinf(range.farZ) ? 0.0f : 1.0f / range.farZ;
+    return (1.0f - n) * invNear + n * invFar;
+}
+
+float ReadTexel(const RowsView& rows, uint32_t row, uint32_t x)
+{
+    const uint8_t* p = rows.data + (static_cast<size_t>(row) * rows.width + x) * rows.bytesPerTexel;
+    switch (rows.kind)
+    {
+    case TexelKind::Float32:
+    {
+        float v;
+        std::memcpy(&v, p, sizeof(v));
+        return v;
+    }
+    case TexelKind::Unorm16:
+    {
+        uint16_t v;
+        std::memcpy(&v, p, sizeof(v));
+        return static_cast<float>(v) / 65535.0f;
+    }
+    case TexelKind::Unorm24:
+    {
+        uint32_t v;
+        std::memcpy(&v, p, sizeof(v));
+        return static_cast<float>(v & 0x00ffffffu) / 16777215.0f;
+    }
+    }
+    return 0.0f;
+}
+
+bool Reduce(const RowsView& rows, uint32_t rectX, uint32_t rectY, uint32_t rectW, uint32_t rectH,
+            const DepthRange& range, uint32_t grid, float nearM, std::vector<uint8_t>& out)
+{
+    if (rows.data == nullptr || rows.width == 0 || rows.imageHeight == 0 || rows.capturedRows == 0 ||
+        grid == 0 || rectW == 0 || rectH == 0 || rectX + rectW > rows.width ||
+        rectY + rectH > rows.imageHeight || !(nearM > 0.0f) || InverseDistance(range.minDepth, range) < 0.0f)
+    {
+        return false;
+    }
+
+    std::vector<uint8_t> result(static_cast<size_t>(grid) * grid, 0);
+    for (uint32_t gy = 0; gy < grid; ++gy)
+    {
+        // The image row at this cell's centre, then the captured row nearest to it.
+        const double cy = rectY + (gy + 0.5) * rectH / grid;
+        uint32_t best = 0;
+        double bestDist = 1e30;
+        for (uint32_t i = 0; i < rows.capturedRows; ++i)
+        {
+            const double d = std::fabs(RowForCapture(i, rows.capturedRows, rows.imageHeight) + 0.5 - cy);
+            if (d < bestDist)
+            {
+                bestDist = d;
+                best = i;
+            }
+        }
+        for (uint32_t gx = 0; gx < grid; ++gx)
+        {
+            const uint32_t x0 = rectX + static_cast<uint32_t>(static_cast<uint64_t>(gx) * rectW / grid);
+            uint32_t x1 = rectX + static_cast<uint32_t>(static_cast<uint64_t>(gx + 1) * rectW / grid);
+            x1 = std::max(x1, x0 + 1);
+            float nearest = 0.0f; // 1/m; 0 = infinitely far
+            for (uint32_t x = x0; x < x1; ++x)
+            {
+                nearest = std::max(nearest, InverseDistance(ReadTexel(rows, best, x), range));
+            }
+            const float q = std::round(255.0f * nearM * nearest);
+            result[static_cast<size_t>(gy) * grid + gx] = static_cast<uint8_t>(std::clamp(q, 0.0f, 255.0f));
+        }
+    }
+    out = std::move(result);
+    return true;
+}
+
+} // namespace oxrsys::depthgrid
diff --git a/runtime/src/DepthGrid.h b/runtime/src/DepthGrid.h
new file mode 100644
index 0000000..c240c80
--- /dev/null
+++ b/runtime/src/DepthGrid.h
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#pragma once
+
+// Positional reprojection: the app's submitted depth (XR_KHR_composition_layer_depth) reduced to a
+// small inverse-depth grid per eye for a client whose compositor warps per pixel from depth.
+// The swapchain copies a few evenly spaced full-width rows of the released depth image to host
+// memory (one copy per release, no full readback); this file turns those rows into the grid.
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <vector>
+
+namespace oxrsys::depthgrid
+{
+
+enum class TexelKind : uint8_t
+{
+    Float32,   // VK_FORMAT_D32_SFLOAT, D32_SFLOAT_S8 (depth aspect), MTLPixelFormatDepth32Float
+    Unorm16,   // VK_FORMAT_D16_UNORM
+    Unorm24,   // VK_FORMAT_D24_UNORM_S8 / X8_D24 (depth aspect: low 24 bits of a 32-bit word)
+};
+
+// Captured rows of one array layer of a depth image. Row i holds image row RowForCapture(i, ...).
+struct RowsView
+{
+    const uint8_t* data = nullptr;
+    uint32_t width = 0;          // image width = texels per captured row
+    uint32_t imageHeight = 0;
+    uint32_t capturedRows = 0;
+    uint32_t bytesPerTexel = 4;
+    TexelKind kind = TexelKind::Float32;
+};
+
+// A release-time row capture still in flight. waitRows blocks up to timeoutNs for the GPU copy and
+// then points the view at host memory that stays valid while this source (its lifetime) is held.
+struct RowsSource
+{
+    std::shared_ptr<void> lifetime = {};
+    std::function<bool(uint64_t timeoutNs, RowsView& rows)> waitRows = {};
+
+    bool IsValid() const { return lifetime != nullptr && static_cast<bool>(waitRows); }
+};
+
+// XrCompositionLayerDepthInfoKHR's mapping from a depth value to distance.
+struct DepthRange
+{
+    float minDepth = 0.0f;
+    float maxDepth = 1.0f;
+    float nearZ = 0.1f;   // distance (m) at minDepth; may exceed farZ (reversed Z)
+    float farZ = 100.0f;  // distance (m) at maxDepth; may be +inf
+};
+
+// The image row the i-th captured row comes from (evenly spaced, cell centres).
+inline uint32_t RowForCapture(uint32_t i, uint32_t capturedRows, uint32_t imageHeight)
+{
+    if (capturedRows == 0 || imageHeight == 0)
+    {
+        return 0;
+    }
+    const uint64_t y = (2ull * i + 1ull) * imageHeight / (2ull * capturedRows);
+    return static_cast<uint32_t>(y < imageHeight ? y : imageHeight - 1);
+}
+
+// 1 / distance (1/m) for a raw depth value, or a negative number when it is not usable.
+float InverseDistance(float depth, const DepthRange& range);
+
+// Normalised depth of texel x in a captured row.
+float ReadTexel(const RowsView& rows, uint32_t row, uint32_t x);
+
+// grid x grid bytes, row-major top to bottom, q = round(255 * nearM / distance) clamped to 0..255,
+// over the sub-rectangle (x, y, w, h) of the image. Each cell takes the NEAREST depth found along
+// the captured row closest to its centre (a foreground edge keeps its own depth). Returns false
+// (out untouched) when the view, rect or range is unusable.
+bool Reduce(const RowsView& rows, uint32_t rectX, uint32_t rectY, uint32_t rectW, uint32_t rectH,
+            const DepthRange& range, uint32_t grid, float nearM, std::vector<uint8_t>& out);
+
+} // namespace oxrsys::depthgrid
