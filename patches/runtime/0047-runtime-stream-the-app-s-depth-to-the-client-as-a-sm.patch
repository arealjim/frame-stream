+bool Swapchain::InitVulkanDepthPool(uint32_t capturedRows)
+{
+    VkDevice device = reinterpret_cast<VkDevice>(vulkanContext_.device);
+    VkPhysicalDevice physicalDevice =
+        reinterpret_cast<VkPhysicalDevice>(vulkanContext_.physicalDevice);
+    uint32_t bytesPerTexel = 0;
+    oxrsys::depthgrid::TexelKind kind = oxrsys::depthgrid::TexelKind::Float32;
+    if (device == VK_NULL_HANDLE || physicalDevice == VK_NULL_HANDLE ||
+        vulkanDeviceFunctions_ == nullptr ||
+        !RequiredVulkanDepthRowFunctionsAvailable(*vulkanDeviceFunctions_) ||
+        !DepthTexelLayout(static_cast<VkFormat>(format_), bytesPerTexel, kind) ||
+        width_ == 0 || height_ == 0)
+    {
+        return false;
+    }
+    const VulkanDeviceFunctions& functions = *vulkanDeviceFunctions_;
+    capturedRows = std::min(capturedRows, height_);
+
+    auto pool = std::make_shared<VulkanDepthPool>(kVulkanSnapshotSlotCount);
+    pool->context = vulkanContext_;
+    pool->destroyCommandPool = functions.destroyCommandPool;
+    pool->destroyBuffer = functions.destroyBuffer;
+    pool->freeMemory = functions.freeMemory;
+    pool->destroyFence = functions.destroyFence;
+    pool->waitForFences = functions.waitForFences;
+    pool->capturedRows = capturedRows;
+    pool->width = width_;
+    pool->imageHeight = height_;
+    pool->bytesPerTexel = bytesPerTexel;
+    pool->kind = kind;
+    vulkanDepthPool_ = pool;
+
+    const VkDeviceSize layerBytes =
+        static_cast<VkDeviceSize>(capturedRows) * width_ * bytesPerTexel;
+    auto fail = [this]() {
+        DestroyVulkanDepthPoolResources();
+        vulkanDepthPool_.reset();
+        return false;
+    };
+    for (auto& slot : pool->slots)
+    {
+        VkBufferCreateInfo bufferInfo{};
+        bufferInfo.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+        bufferInfo.size = layerBytes * arraySize_;
+        bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+        bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        if (functions.createBuffer(device, &bufferInfo, nullptr, &slot.buffer) != VK_SUCCESS)
+        {
+            return fail();
+        }
+        VkMemoryRequirements requirements{};
+        functions.getBufferMemoryRequirements(device, slot.buffer, &requirements);
+        const uint32_t memoryType = FindMemoryType(
+            physicalDevice, requirements.memoryTypeBits,
+            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+        if (memoryType == std::numeric_limits<uint32_t>::max())
+        {
+            return fail();
+        }
+        VkMemoryAllocateInfo allocInfo{};
+        allocInfo.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+        allocInfo.allocationSize = requirements.size;
+        allocInfo.memoryTypeIndex = memoryType;
+        if (functions.allocateMemory(device, &allocInfo, nullptr, &slot.memory) != VK_SUCCESS ||
+            functions.bindBufferMemory(device, slot.buffer, slot.memory, 0) != VK_SUCCESS ||
+            functions.mapMemory(device, slot.memory, 0, VK_WHOLE_SIZE, 0, &slot.mapped) != VK_SUCCESS)
+        {
+            return fail();
+        }
+
+        VkCommandPoolCreateInfo poolInfo{};
+        poolInfo.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+        poolInfo.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+        poolInfo.queueFamilyIndex = vulkanContext_.queueFamilyIndex;
+        VkCommandBufferAllocateInfo commandInfo{};
+        commandInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+        commandInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        commandInfo.commandBufferCount = 1;
+        VkFenceCreateInfo fenceInfo{};
+        fenceInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+        fenceInfo.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        if (functions.createCommandPool(device, &poolInfo, nullptr, &slot.commandPool) != VK_SUCCESS)
+        {
+            return fail();
+        }
+        commandInfo.commandPool = slot.commandPool;
+        if (functions.allocateCommandBuffers(device, &commandInfo, &slot.commandBuffer) != VK_SUCCESS ||
+            functions.createFence(device, &fenceInfo, nullptr, &slot.fence) != VK_SUCCESS)
+        {
+            return fail();
+        }
+    }
+
+    lastVulkanDepthRows_.assign(arraySize_, {});
+    spdlog::info("OXRSys: depth rows for positional reprojection: {} rows x {} px x {} layers, {} B/texel",
+                 capturedRows, width_, arraySize_, bytesPerTexel);
+    return true;
+}
+
+void Swapchain::CaptureVulkanDepthRows(bool requested)
+{
+    const auto pool = vulkanDepthPool_;
+    {
+        std::scoped_lock lock(stateMutex_);
+        lastVulkanDepthRows_.assign(arraySize_, {});
+    }
+    if (!requested || pool == nullptr || vkImages_.empty() ||
+        pool->stopping.load(std::memory_order_acquire))
+    {
+        return;
+    }
+    VkDevice device = reinterpret_cast<VkDevice>(vulkanContext_.device);
+    VkImage image = reinterpret_cast<VkImage>(vkImages_[lastReleasedIndex_]);
+    const auto functions = vulkanDeviceFunctions_;
+    if (device == VK_NULL_HANDLE || image == VK_NULL_HANDLE || functions == nullptr)
+    {
+        return;
+    }
+    VkQueue queue = reinterpret_cast<VkQueue>(vulkanContext_.queue);
+    if (queue == VK_NULL_HANDLE && functions->getDeviceQueue != nullptr)
+    {
+        functions->getDeviceQueue(
+            device, vulkanContext_.queueFamilyIndex, vulkanContext_.queueIndex, &queue);
+    }
+    if (queue == VK_NULL_HANDLE)
+    {
+        return;
+    }
+
+    const SnapshotLeasePool::Lease lease = pool->leases.TryAcquire([&](size_t index) {
+        const auto& candidate = pool->slots[index];
+        return !candidate.fenceSubmitted ||
+               functions->getFenceStatus(device, candidate.fence) == VK_SUCCESS;
+    });
+    if (!lease)
+    {
+        return;
+    }
+    VulkanDepthSlot& slot = pool->slots[lease.index];
+    if (functions->resetFences(device, 1, &slot.fence) != VK_SUCCESS ||
+        functions->resetCommandPool(device, slot.commandPool, 0) != VK_SUCCESS)
+    {
+        slot.fenceSubmitted = false;
+        return;
+    }
+    slot.fenceSubmitted = false;
+
+    VkCommandBufferBeginInfo beginInfo{};
+    beginInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    if (functions->beginCommandBuffer(slot.commandBuffer, &beginInfo) != VK_SUCCESS)
+    {
+        return;
+    }
+
+    // A released depth image is in DEPTH_STENCIL_ATTACHMENT_OPTIMAL (XR_KHR_vulkan_enable).
+    const bool hasStencil = format_ == VK_FORMAT_D24_UNORM_S8_UINT ||
+                            format_ == VK_FORMAT_D32_SFLOAT_S8_UINT;
+    VkImageMemoryBarrier toTransfer{};
+    toTransfer.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    toTransfer.srcAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    toTransfer.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    toTransfer.oldLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    toTransfer.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    toTransfer.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toTransfer.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toTransfer.image = image;
+    toTransfer.subresourceRange.aspectMask =
+        VK_IMAGE_ASPECT_DEPTH_BIT | (hasStencil ? VK_IMAGE_ASPECT_STENCIL_BIT : 0);
+    toTransfer.subresourceRange.levelCount = 1;
+    toTransfer.subresourceRange.layerCount = arraySize_;
+    functions->cmdPipelineBarrier(
+        slot.commandBuffer,
+        VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &toTransfer);
+
+    std::vector<VkBufferImageCopy> regions;
+    regions.reserve(static_cast<size_t>(pool->capturedRows) * arraySize_);
+    const VkDeviceSize rowBytes = static_cast<VkDeviceSize>(pool->width) * pool->bytesPerTexel;
+    for (uint32_t layer = 0; layer < arraySize_; ++layer)
+    {
+        for (uint32_t i = 0; i < pool->capturedRows; ++i)
+        {
+            VkBufferImageCopy region{};
+            region.bufferOffset = (static_cast<VkDeviceSize>(layer) * pool->capturedRows + i) * rowBytes;
+            region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
+            region.imageSubresource.baseArrayLayer = layer;
+            region.imageSubresource.layerCount = 1;
+            region.imageOffset = {
+                0, static_cast<int32_t>(oxrsys::depthgrid::RowForCapture(i, pool->capturedRows, height_)), 0};
+            region.imageExtent = {width_, 1, 1};
+            regions.push_back(region);
+        }
+    }
+    functions->cmdCopyImageToBuffer(
+        slot.commandBuffer, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, slot.buffer,
+        static_cast<uint32_t>(regions.size()), regions.data());
+
+    VkImageMemoryBarrier back = toTransfer;
+    back.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    back.dstAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+                         VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    back.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    back.newLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    VkBufferMemoryBarrier toHost{};
+    toHost.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+    toHost.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    toHost.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    toHost.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toHost.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toHost.buffer = slot.buffer;
+    toHost.size = VK_WHOLE_SIZE;
+    functions->cmdPipelineBarrier(
+        slot.commandBuffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+        0, 0, nullptr, 1, &toHost, 1, &back);
+
+    if (functions->endCommandBuffer(slot.commandBuffer) != VK_SUCCESS)
+    {
+        return;
+    }
+    VkSubmitInfo submitInfo{};
+    submitInfo.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+    submitInfo.commandBufferCount = 1;
+    submitInfo.pCommandBuffers = &slot.commandBuffer;
+    if (functions->queueSubmit(queue, 1, &submitInfo, slot.fence) != VK_SUCCESS)
+    {
+        return;
+    }
+    slot.fenceSubmitted = true;
+
+    std::vector<oxrsys::depthgrid::RowsSource> sources(arraySize_);
+    for (uint32_t layer = 0; layer < arraySize_; ++layer)
+    {
+        sources[layer].lifetime = lease.lifetime;
+        sources[layer].waitRows = [pool, slotIndex = lease.index, layer](
+                                      uint64_t timeoutNs, oxrsys::depthgrid::RowsView& rows) {
+            if (pool->stopping.load(std::memory_order_acquire) || slotIndex >= pool->slots.size())
+            {
+                return false;
+            }
+            const auto& depthSlot = pool->slots[slotIndex];
+            VkDevice slotDevice = reinterpret_cast<VkDevice>(pool->context.device);
+            if (slotDevice == VK_NULL_HANDLE || !depthSlot.fenceSubmitted ||
+                depthSlot.mapped == nullptr || pool->waitForFences == nullptr ||
+                pool->waitForFences(slotDevice, 1, &depthSlot.fence, VK_TRUE, timeoutNs) != VK_SUCCESS)
+            {
+                return false;
+            }
+            rows.data = static_cast<const uint8_t*>(depthSlot.mapped) +
+                        static_cast<size_t>(layer) * pool->capturedRows * pool->width * pool->bytesPerTexel;
+            rows.width = pool->width;
+            rows.imageHeight = pool->imageHeight;
+            rows.capturedRows = pool->capturedRows;
+            rows.bytesPerTexel = pool->bytesPerTexel;
+            rows.kind = pool->kind;
+            return true;
+        };
+    }
+    std::scoped_lock lock(stateMutex_);
+    lastVulkanDepthRows_ = std::move(sources);
+}
+
+bool Swapchain::DrainVulkanDepthPool(std::chrono::nanoseconds timeout)
+{
+    const auto pool = vulkanDepthPool_;
+    if (pool == nullptr)
+    {
+        return true;
+    }
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    pool->stopping.store(true, std::memory_order_release);
+    if (!pool->leases.StopAndWaitForLeases(timeout))
+    {
+        return false;
+    }
+    std::vector<VkFence> submitted;
+    for (const auto& slot : pool->slots)
+    {
+        if (slot.fenceSubmitted && slot.fence != VK_NULL_HANDLE)
+        {
+            submitted.push_back(slot.fence);
+        }
+    }
+    if (submitted.empty())
+    {
+        return true;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const VkDevice device = reinterpret_cast<VkDevice>(pool->context.device);
+    if (now >= deadline || pool->waitForFences == nullptr || device == VK_NULL_HANDLE)
+    {
+        return false;
+    }
+    const uint64_t remainingNs = static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(deadline - now).count());
+    return pool->waitForFences(device, static_cast<uint32_t>(submitted.size()), submitted.data(),
+                               VK_TRUE, remainingNs) == VK_SUCCESS;
+}
+
+void Swapchain::DestroyVulkanDepthPoolResources()
+{
+    const auto pool = vulkanDepthPool_;
+    if (pool == nullptr)
+    {
+        return;
+    }
+    const VkDevice device = reinterpret_cast<VkDevice>(pool->context.device);
+    if (device == VK_NULL_HANDLE)
+    {
+        return;
+    }
+    for (auto& slot : pool->slots)
+    {
+        if (slot.fence != VK_NULL_HANDLE && pool->destroyFence != nullptr)
+        {
+            pool->destroyFence(device, slot.fence, nullptr);
+            slot.fence = VK_NULL_HANDLE;
+        }
+        if (slot.commandPool != VK_NULL_HANDLE && pool->destroyCommandPool != nullptr)
+        {
+            pool->destroyCommandPool(device, slot.commandPool, nullptr);
+            slot.commandPool = VK_NULL_HANDLE;
+            slot.commandBuffer = VK_NULL_HANDLE;
+        }
+        if (slot.buffer != VK_NULL_HANDLE && pool->destroyBuffer != nullptr)
+        {
+            pool->destroyBuffer(device, slot.buffer, nullptr);
+            slot.buffer = VK_NULL_HANDLE;
+        }
+        if (slot.memory != VK_NULL_HANDLE && pool->freeMemory != nullptr)
+        {
+            // Freeing mapped memory implicitly unmaps it.
+            pool->freeMemory(device, slot.memory, nullptr);
+            slot.memory = VK_NULL_HANDLE;
+            slot.mapped = nullptr;
+        }
+    }
+}
diff --git a/tests/TestDepthGrid.cpp b/tests/TestDepthGrid.cpp
new file mode 100644
index 0000000..5e050f6
--- /dev/null
+++ b/tests/TestDepthGrid.cpp
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "DepthGrid.h"
+
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+using namespace oxrsys::depthgrid;
+
+namespace
+{
+// Standard perspective depth (0 at nearZ, 1 at farZ) for a distance, written independently of the
+// code under test from the projection: d = (1/n - 1/z) / (1/n - 1/f).
+float StandardDepth(float z, float n, float f) { return (1.0f / n - 1.0f / z) / (1.0f / n - 1.0f / f); }
+
+std::vector<uint8_t> Rows(uint32_t width, uint32_t rows, const std::vector<float>& depthPerTexel)
+{
+    std::vector<uint8_t> data(static_cast<size_t>(width) * rows * 4);
+    std::memcpy(data.data(), depthPerTexel.data(), data.size());
+    return data;
+}
+} // namespace
+
+TEST_CASE("Depth grid: standard Z maps distance to q = 255 * near / z", "[depthgrid]")
+{
+    const DepthRange range{0.0f, 1.0f, 0.1f, 100.0f};
+    // 1 m and 2 m: q = 255 * 0.25 / z = 63.75 -> 64, 31.875 -> 32.
+    REQUIRE(std::lround(255.0f * 0.25f * InverseDistance(StandardDepth(1.0f, 0.1f, 100.0f), range)) == 64);
+    REQUIRE(std::lround(255.0f * 0.25f * InverseDistance(StandardDepth(2.0f, 0.1f, 100.0f), range)) == 32);
+    REQUIRE(std::fabs(InverseDistance(1.0f, range) - 0.01f) < 1e-6f); // far plane: 1/100
+}
+
+TEST_CASE("Depth grid: reversed and infinite Z give the same distances", "[depthgrid]")
+{
+    const float inf = std::numeric_limits<float>::infinity();
+    // Reversed infinite: d = near / z, minDepth (0) is at infinity.
+    const DepthRange reversed{0.0f, 1.0f, inf, 0.1f};
+    REQUIRE(std::fabs(InverseDistance(0.1f / 0.5f, reversed) - 2.0f) < 1e-4f);
+    REQUIRE(InverseDistance(0.0f, reversed) == 0.0f);
+    // Standard infinite: d = 1 - near / z.
+    const DepthRange standardInf{0.0f, 1.0f, 0.1f, inf};
+    REQUIRE(std::fabs(InverseDistance(1.0f - 0.1f / 4.0f, standardInf) - 0.25f) < 1e-4f);
+    // A sub-range: minDepth 0.5 .. maxDepth 1 holds the full near..far mapping.
+    const DepthRange half{0.5f, 1.0f, 0.1f, inf};
+    REQUIRE(std::fabs(InverseDistance(0.5f + 0.5f * (1.0f - 0.1f / 4.0f), half) - 0.25f) < 1e-4f);
+}
+
+TEST_CASE("Depth grid: unusable ranges are refused", "[depthgrid]")
+{
+    REQUIRE(InverseDistance(0.5f, DepthRange{1.0f, 1.0f, 0.1f, 100.0f}) < 0.0f);
+    REQUIRE(InverseDistance(0.5f, DepthRange{0.0f, 1.0f, 0.0f, 100.0f}) < 0.0f);
+    REQUIRE(InverseDistance(0.5f, DepthRange{0.0f, 1.0f, 1.0f, 1.0f}) < 0.0f);
+    std::vector<uint8_t> out;
+    RowsView none{};
+    REQUIRE_FALSE(Reduce(none, 0, 0, 1, 1, DepthRange{}, 4, 0.25f, out));
+}
+
+TEST_CASE("Depth grid: a cell keeps the nearest depth on its row, inside the sub-rect", "[depthgrid]")
+{
+    // 8 x 8 image, 4 captured rows (image rows 1, 3, 5, 7); everything at 2 m except one texel at
+    // 1 m on image row 5, column 6 (right half). Side-by-side: the right eye is x = 4..7.
+    const uint32_t w = 8, h = 8, cap = 4;
+    REQUIRE(RowForCapture(0, cap, h) == 1);
+    REQUIRE(RowForCapture(2, cap, h) == 5);
+    std::vector<float> d(w * cap, StandardDepth(2.0f, 0.1f, 100.0f));
+    d[2 * w + 6] = StandardDepth(1.0f, 0.1f, 100.0f);
+    const auto data = Rows(w, cap, d);
+    RowsView rows{data.data(), w, h, cap, 4, TexelKind::Float32};
+    std::vector<uint8_t> out;
+    REQUIRE(Reduce(rows, 4, 0, 4, 8, DepthRange{0.0f, 1.0f, 0.1f, 100.0f}, 2, 0.25f, out));
+    REQUIRE(out.size() == 4);
+    // Cell (row 1, col 1) of the right eye covers x 6..7; its centre y = 6 is nearest captured image
+    // row 5 (centre 5.5), so it sees the 1 m texel.
+    REQUIRE(out[0] == 32);
+    REQUIRE(out[1] == 32);
+    REQUIRE(out[2] == 32);
+    REQUIRE(out[3] == 64);
+    // The left eye never sees it.
+    REQUIRE(Reduce(rows, 0, 0, 4, 8, DepthRange{0.0f, 1.0f, 0.1f, 100.0f}, 2, 0.25f, out));
+    REQUIRE(out == std::vector<uint8_t>{32, 32, 32, 32});
+    // A rect outside the image is refused.
+    REQUIRE_FALSE(Reduce(rows, 5, 0, 4, 8, DepthRange{}, 2, 0.25f, out));
+}
+
+TEST_CASE("Depth grid: 16- and 24-bit texels", "[depthgrid]")
+{
+    std::vector<uint8_t> data(4);
+    const uint16_t half = 32768;
+    std::memcpy(data.data(), &half, 2);
+    RowsView rows16{data.data(), 2, 1, 1, 2, TexelKind::Unorm16};
+    REQUIRE(std::fabs(ReadTexel(rows16, 0, 0) - 0.5f) < 1e-4f);
+    const uint32_t d24 = 0xAB800000u; // stencil byte set, depth 0x800000
+    std::memcpy(data.data(), &d24, 4);
+    RowsView rows24{data.data(), 1, 1, 1, 4, TexelKind::Unorm24};
+    REQUIRE(std::fabs(ReadTexel(rows24, 0, 0) - 0.5f) < 1e-4f);
+}
