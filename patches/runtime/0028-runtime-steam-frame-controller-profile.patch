diff --git a/runtime/src/TrackingReceiver.cpp b/runtime/src/TrackingReceiver.cpp
index 0166b59..84a0529 100644
--- a/runtime/src/TrackingReceiver.cpp
+++ b/runtime/src/TrackingReceiver.cpp
@@ -215,6 +215,17 @@ void TrackingReceiver::Stop()
 static constexpr size_t kMinTrackingPacketSize =
     offsetof(oxr::protocol::TrackingPacket, leftControllerAimPos);
 
+// The Steam Frame client sent 1080 bytes before controllerProfile existed: gazeDirection, then four bytes of
+// struct padding where controllerProfile now sits. Only a packet that reaches the end of touchState carries them.
+static void ClearFieldsBeyond(oxr::protocol::TrackingPacket& packet, size_t received)
+{
+    if (received < offsetof(oxr::protocol::TrackingPacket, touchState) + sizeof(packet.touchState))
+    {
+        packet.controllerProfile = oxr::protocol::CONTROLLER_PROFILE_UNKNOWN;
+        packet.touchState = 0;
+    }
+}
+
 void TrackingReceiver::ReceiveThread()
 {
     uint8_t buffer[sizeof(oxr::protocol::TrackingPacket)];
@@ -232,6 +243,7 @@ void TrackingReceiver::ReceiveThread()
         oxr::protocol::TrackingPacket packet = {};
         size_t copyBytes = std::min(static_cast<size_t>(received), sizeof(packet));
         memcpy(&packet, buffer, copyBytes);
+        ClearFieldsBeyond(packet, copyBytes);
         StorePacket(packet, SteadyClockNowNs());
     }
 }
@@ -245,6 +257,7 @@ void TrackingReceiver::InjectPacket(const uint8_t* data, size_t size)
 
     oxr::protocol::TrackingPacket packet = {};
     memcpy(&packet, data, std::min(size, sizeof(packet)));
+    ClearFieldsBeyond(packet, size);
     StorePacket(packet, SteadyClockNowNs());
 }
 
