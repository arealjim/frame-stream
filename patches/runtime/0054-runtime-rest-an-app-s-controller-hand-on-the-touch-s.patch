 runtime/src/Config.h         |  6 ++++++
 runtime/src/HandTracker.cpp  |  6 +++++-
 runtime/src/InputManager.cpp | 29 +++++++++++++++++++------
 runtime/src/Session.cpp      | 17 +++++++++++++++
 runtime/src/Session.h        |  4 ++++
 tests/TestInputManager.cpp   | 41 ++++++++++++++++++++++++++++++++++++
 7 files changed, 104 insertions(+), 7 deletions(-)

