+
     const InputManager& inputManager = session_->GetInputManager();
 
     InputManager::Hand hand = (hand_ == XR_HAND_LEFT_EXT)
@@ -100,9 +110,28 @@ XrResult HandTracker::LocateHandJoints(XrSpace /*baseSpace*/, XrTime /*time*/,
         return XR_SUCCESS;
     }
 
+    XrPosef baseInWorld{};
+    if (!base->LocateInWorld(&baseInWorld))
+    {
+        // The joints cannot be expressed in an untracked space (a controller that is asleep).
+        locations->isActive = XR_FALSE;
+        ClearJointLocations(locations);
+        ClearJointVelocities(velocities);
+        return XR_SUCCESS;
+    }
+
     locations->isActive = XR_TRUE;
     inputManager.GetHandJointLocations(hand, locations->jointLocations, locations->jointCount);
+    oxr::ExpressHandJointsInSpace(baseInWorld, locations->jointLocations, locations->jointCount);
     ClearJointVelocities(velocities);
 
+    // One line every ~5 s per hand: the wrist in the caller's base space. Next to a grip space it is a few cm.
+    if (++locateLogCounter_ % 450 == 1)
+    {
+        const XrVector3f& wrist = locations->jointLocations[XR_HAND_JOINT_WRIST_EXT].pose.position;
+        spdlog::info("HandTracker: {} wrist in base space ({:.3f}, {:.3f}, {:.3f})",
+                     hand_ == XR_HAND_LEFT_EXT ? "left" : "right", wrist.x, wrist.y, wrist.z);
+    }
+
     return XR_SUCCESS;
 }
