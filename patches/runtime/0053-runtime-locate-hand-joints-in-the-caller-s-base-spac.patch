--- /dev/null
+++ b/runtime/src/HandJointSpace.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MPL-2.0
+#pragma once
+
+#include <openxr/openxr.h>
+#include <glm/glm.hpp>
+#include <glm/gtc/quaternion.hpp>
+#include <cstdint>
+
+namespace oxr
+{
+
+// Hand joints arrive from the client in the runtime's world space (the client's base space). An app locates
+// them in a base space of its choosing (XrHandJointsLocateInfoEXT::baseSpace), often a controller's grip
+// space: OpenComposite does, to build the OpenVR skeleton relative to the controller. Returning world poses to
+// such a caller puts the hand meters away from the controller, so express every joint in the base space.
+// baseInWorld is the base space's pose in world space, as Space::LocateInWorld gives it.
+inline void ExpressHandJointsInSpace(const XrPosef& baseInWorld, XrHandJointLocationEXT* joints, uint32_t jointCount)
+{
+    if (joints == nullptr)
+    {
+        return;
+    }
+
+    const glm::quat baseRotInv = glm::inverse(glm::quat(baseInWorld.orientation.w, baseInWorld.orientation.x,
+                                                        baseInWorld.orientation.y, baseInWorld.orientation.z));
+    const glm::vec3 basePos(baseInWorld.position.x, baseInWorld.position.y, baseInWorld.position.z);
+
+    for (uint32_t i = 0; i < jointCount; ++i)
+    {
+        XrPosef& pose = joints[i].pose;
+        const glm::vec3 pos = baseRotInv * (glm::vec3(pose.position.x, pose.position.y, pose.position.z) - basePos);
+        const glm::quat rot = baseRotInv * glm::quat(pose.orientation.w, pose.orientation.x,
+                                                     pose.orientation.y, pose.orientation.z);
+        pose.position = {pos.x, pos.y, pos.z};
+        pose.orientation = {rot.x, rot.y, rot.z, rot.w};
+    }
+}
+
+} // namespace oxr
