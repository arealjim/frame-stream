+++ b/runtime/src/SwapchainVulkan.cpp
@@ -22,6 +22,7 @@
 extern "C" void* OxrsysRetainMetalObjectForSwapchain(void* object);
 extern "C" void* OxrsysCreateMetalTextureSliceForSwapchain(
