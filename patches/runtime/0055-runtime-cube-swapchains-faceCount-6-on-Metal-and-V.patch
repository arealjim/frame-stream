         ? 1
         : SwapchainImageCount;
@@ -256,7 +258,7 @@ void Swapchain::InitVulkan(void* /*metalDevice*/, const VulkanGraphicsContext& v
     imageCI.format = static_cast<VkFormat>(format_);
