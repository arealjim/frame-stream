     // TRANSFER_SRC on depth: the release-time row capture for positional reprojection reads it.
@@ -271,6 +273,10 @@ void Swapchain::InitVulkan(void* /*metalDevice*/, const VulkanGraphicsContext& v
     {
         imageCI.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
     }
+    if (faceCount_ == 6)
