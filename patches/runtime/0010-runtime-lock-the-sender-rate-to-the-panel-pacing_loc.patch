     clientReprojectedFramesDelta_.store(report.reprojectedFrames);
     clientStaleFrameReusesDelta_.store(report.staleFrameReuses);
     clientRenderPoseFallbacksDelta_.store(report.renderPoseFallbacks);
diff --git a/runtime/src/StreamingServer.h b/runtime/src/StreamingServer.h
index b283746..3d5f635 100644
--- a/runtime/src/StreamingServer.h
+++ b/runtime/src/StreamingServer.h
@@ -84,6 +84,10 @@ class StreamingServer
     bool IsClientConnected() const { return state_.load() == State::Connected; }
     State GetState() const { return state_.load(); }
