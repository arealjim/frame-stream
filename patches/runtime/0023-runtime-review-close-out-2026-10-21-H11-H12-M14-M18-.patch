diff --git a/runtime/src/LatencyReportCheck.h b/runtime/src/LatencyReportCheck.h
new file mode 100644
index 0000000..02ebf91
--- /dev/null
+++ b/runtime/src/LatencyReportCheck.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#pragma once
+
+#include <oxrsys/protocol/Protocol.h>
+
+#include <cmath>
+
+namespace oxrsys
+{
+
+// A LatencyReport's floats are client-supplied and feed the rate lock's PI integral and the
+// prediction horizon through atomics. A NaN or infinity there is a NaN trim forever, and
+// (long long)NaN is undefined; a value beyond anything a pipeline can measure is a broken
+// client. Every field must be finite and inside [0, kMaxLatencyReportMs].
+constexpr float kMaxLatencyReportMs = 10000.0f;
+
+inline bool LatencyFieldIsSane(float ms)
+{
+    return std::isfinite(ms) && ms >= 0.0f && ms <= kMaxLatencyReportMs;
+}
+
+inline bool LatencyReportIsSane(const oxr::protocol::LatencyReport& report)
+{
+    return LatencyFieldIsSane(report.receiveToDecoderSubmitMs) &&
+           LatencyFieldIsSane(report.decodeLatencyMs) &&
+           LatencyFieldIsSane(report.compositorLatencyMs) &&
+           LatencyFieldIsSane(report.totalClientLatencyMs) &&
+           LatencyFieldIsSane(report.displayedFrameAgeMs);
+}
+
+} // namespace oxrsys
