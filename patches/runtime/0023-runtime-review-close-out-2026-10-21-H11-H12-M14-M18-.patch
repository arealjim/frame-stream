new file mode 100644
index 0000000..6f8253f
--- /dev/null
+++ b/tests/TestLatencyReportCheck.cpp
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "LatencyReportCheck.h"
+
+#include <limits>
+
+using oxrsys::LatencyReportIsSane;
+
+namespace
+{
+oxr::protocol::LatencyReport SaneReport()
+{
+    oxr::protocol::LatencyReport report;
+    report.receiveToDecoderSubmitMs = 0.4f;
+    report.decodeLatencyMs = 1.1f;
+    report.compositorLatencyMs = 2.0f;
+    report.totalClientLatencyMs = 9.5f;
+    report.displayedFrameAgeMs = 6.0f;
+    return report;
+}
+} // namespace
+
+TEST_CASE("Latency report check: a measured report passes", "[latency-report]")
+{
+    CHECK(LatencyReportIsSane(SaneReport()));
+    oxr::protocol::LatencyReport zeros;
+    zeros.receiveToDecoderSubmitMs = 0.0f;
+    zeros.decodeLatencyMs = 0.0f;
+    zeros.compositorLatencyMs = 0.0f;
+    zeros.totalClientLatencyMs = 0.0f;
+    CHECK(LatencyReportIsSane(zeros));   // a client that has not measured yet reports zeros
+}
+
+TEST_CASE("Latency report check: NaN and infinity in any field are refused", "[latency-report]")
+{
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    const float inf = std::numeric_limits<float>::infinity();
+    {
+        auto r = SaneReport(); r.displayedFrameAgeMs = nan;
+        CHECK_FALSE(LatencyReportIsSane(r));   // the field the rate lock integrates
+    }
+    {
+        auto r = SaneReport(); r.totalClientLatencyMs = inf;
+        CHECK_FALSE(LatencyReportIsSane(r));   // the field the prediction horizon smooths
+    }
+    {
+        auto r = SaneReport(); r.receiveToDecoderSubmitMs = -inf;
+        CHECK_FALSE(LatencyReportIsSane(r));
+    }
+    {
+        auto r = SaneReport(); r.decodeLatencyMs = nan;
+        CHECK_FALSE(LatencyReportIsSane(r));
+    }
+    {
+        auto r = SaneReport(); r.compositorLatencyMs = nan;
+        CHECK_FALSE(LatencyReportIsSane(r));
+    }
+}
+
+TEST_CASE("Latency report check: negative and absurd values are refused", "[latency-report]")
+{
+    {
+        auto r = SaneReport(); r.displayedFrameAgeMs = -0.5f;
+        CHECK_FALSE(LatencyReportIsSane(r));
+    }
+    {
+        auto r = SaneReport(); r.totalClientLatencyMs = 1.0e9f;
+        CHECK_FALSE(LatencyReportIsSane(r));
+    }
+    {
+        auto r = SaneReport(); r.displayedFrameAgeMs = oxrsys::kMaxLatencyReportMs;
+        CHECK(LatencyReportIsSane(r));   // the bound itself is allowed
+    }
+}
