+TEST_CASE("Client admission: same address, different device name is refused (NAT, loopback)",
+          "[client-admission]")
+{
+    // Two devices behind one NAT share an address; a USB client is recorded as 127.0.0.1,
+    // which a simulator on the same host also presents. The name tells them apart.
+    ClientAdmissionState state;
+    const auto decision = EvaluateClientAdmission(state, true, "127.0.0.1", "Steam Frame",
+                                                  "127.0.0.1", "OXRSys Simulator",
+                                                  1'000 * kMs, kLogIntervalNs);
+    CHECK_FALSE(decision.accept);
+    CHECK(decision.log);
+    // ... and the same candidate again inside the interval is refused quietly.
+    const auto again = EvaluateClientAdmission(state, true, "127.0.0.1", "Steam Frame",
+                                               "127.0.0.1", "OXRSys Simulator",
+                                               2'000 * kMs, kLogIntervalNs);
+    CHECK_FALSE(again.accept);
+    CHECK_FALSE(again.log);
+}
+
+TEST_CASE("Client admission: same address and same name reconnects", "[client-admission]")
+{
+    ClientAdmissionState state;
+    const auto decision = EvaluateClientAdmission(state, true, "10.0.0.13", "Steam Frame",
+                                                  "10.0.0.13", "Steam Frame",
+                                                  1'000 * kMs, kLogIntervalNs);
+    CHECK(decision.accept);
+}
+
+TEST_CASE("Client admission: an empty name on either side falls back to the address rule",
+          "[client-admission]")
+{
+    ClientAdmissionState state;
+    CHECK(EvaluateClientAdmission(state, true, "10.0.0.13", "", "10.0.0.13", "Steam Frame",
+                                  1'000 * kMs, kLogIntervalNs).accept);
+    CHECK(EvaluateClientAdmission(state, true, "10.0.0.13", "Steam Frame", "10.0.0.13", "",
+                                  1'000 * kMs, kLogIntervalNs).accept);
+    CHECK_FALSE(EvaluateClientAdmission(state, true, "10.0.0.13", "", "198.51.100.170", "",
+                                        1'000 * kMs, kLogIntervalNs).accept);
+}
+
+TEST_CASE("Client admission: a USB connect while a WiFi client streams is refused",
