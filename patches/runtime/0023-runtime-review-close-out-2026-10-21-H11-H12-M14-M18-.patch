diff --git a/runtime/src/ClientAdmission.h b/runtime/src/ClientAdmission.h
index 262e43f..8775caf 100644
--- a/runtime/src/ClientAdmission.h
+++ b/runtime/src/ClientAdmission.h
@@ -20,6 +20,15 @@
 // how a client resends a lost ClientConnect and how a restarted client (new source
 // port, same host) reconnects before the liveness watchdog has noticed the old one
 // is gone. The port is deliberately not compared.
+//
+// Since 2026-10-21 the device name is part of the identity too, where both sides
+// report one: two devices behind one NAT share an address, and a USB client is
+// recorded as 127.0.0.1, which a simulator on the same host also presents. A
+// candidate from the connected address with a DIFFERENT non-empty name is refused;
+// an empty name on either side falls back to the address-only rule. The USB
+// connect path runs through the same decision with "127.0.0.1" as its address.
+// The protocol has no server-to-client refusal message, so a refused client is only
+// logged here; it keeps retrying until the connected one leaves.
 namespace oxrsys
 {
 
@@ -43,24 +52,49 @@ struct ClientAdmissionState
 inline ClientAdmissionDecision EvaluateClientAdmission(ClientAdmissionState& state,
                                                        bool clientConnected,
                                                        const std::string& connectedIp,
+                                                       const std::string& connectedName,
                                                        const std::string& candidateIp,
+                                                       const std::string& candidateName,
                                                        int64_t nowNs,
                                                        int64_t logIntervalNs)
 {
     ClientAdmissionDecision decision;
-    if (!clientConnected || connectedIp.empty() || connectedIp == candidateIp)
+    if (!clientConnected || connectedIp.empty())
+    {
+        return decision;
+    }
+    const bool sameAddress = connectedIp == candidateIp;
+    const bool namesKnown = !connectedName.empty() && !candidateName.empty();
+    const bool sameName = !namesKnown || connectedName == candidateName;
+    if (sameAddress && sameName)
     {
         return decision;
     }
     decision.accept = false;
-    if (state.lastRefusedIp != candidateIp || state.lastRefusalLogNs == 0 ||
+    // The log key is the candidate's identity, so a second device behind the same
+    // address is logged on its own first refusal.
+    const std::string refusedKey = candidateIp + "/" + candidateName;
+    if (state.lastRefusedIp != refusedKey || state.lastRefusalLogNs == 0 ||
         nowNs - state.lastRefusalLogNs >= logIntervalNs)
     {
         decision.log = true;
-        state.lastRefusedIp = candidateIp;
+        state.lastRefusedIp = refusedKey;
         state.lastRefusalLogNs = nowNs;
     }
     return decision;
 }
 
+// Address-only form (the policy before 2026-10-21; kept for callers and tests that
+// have no device name).
+inline ClientAdmissionDecision EvaluateClientAdmission(ClientAdmissionState& state,
+                                                       bool clientConnected,
+                                                       const std::string& connectedIp,
+                                                       const std::string& candidateIp,
+                                                       int64_t nowNs,
+                                                       int64_t logIntervalNs)
+{
+    return EvaluateClientAdmission(state, clientConnected, connectedIp, std::string(),
+                                   candidateIp, std::string(), nowNs, logIntervalNs);
+}
+
 } // namespace oxrsys
