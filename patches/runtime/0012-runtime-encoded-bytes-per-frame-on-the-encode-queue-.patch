diff --git a/runtime/src/EncodedFrameStats.h b/runtime/src/EncodedFrameStats.h
new file mode 100644
index 0000000..cc6c1cb
--- /dev/null
+++ b/runtime/src/EncodedFrameStats.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+// Encoded size of each frame over one telemetry window, for the "encode queue"
+// log line. A frame far below the median is almost always one whose content did
+// not change - a duplicate the app or the compose handed the encoder twice - so
+// the line counts them: "small" is the number of frames under 20 % of the median.
+struct EncodedFrameBytesSummary
+{
+    size_t count = 0;
+    size_t min = 0;
+    size_t median = 0;
+    size_t max = 0;
+    size_t small = 0;
+};
+
+inline EncodedFrameBytesSummary SummarizeEncodedFrameBytes(std::vector<size_t> bytes)
+{
+    EncodedFrameBytesSummary summary = {};
+    if (bytes.empty())
+    {
+        return summary;
+    }
+    std::sort(bytes.begin(), bytes.end());
+    summary.count = bytes.size();
+    summary.min = bytes.front();
+    summary.max = bytes.back();
+    summary.median = bytes[(bytes.size() - 1) / 2];
+    // Integer form of bytes < 0.2 * median.
+    summary.small = static_cast<size_t>(std::count_if(bytes.begin(), bytes.end(),
+        [&](size_t value) { return value * 5 < summary.median; }));
+    return summary;
+}
