index a192ffc..626f34e 100644
--- a/runtime/src/Space.cpp
+++ b/runtime/src/Space.cpp
@@ -92,6 +92,11 @@ struct LocatedWorldPose
 {
     XrPosef pose{};
     bool active = true;
+    // How this space moves in world: a reference space fixed in the world (LOCAL, LOCAL_FLOOR,
+    // STAGE) is still; a controller-bound space moves with its hand; anything else (VIEW) has no
