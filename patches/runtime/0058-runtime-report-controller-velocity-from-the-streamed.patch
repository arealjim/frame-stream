             result.pose = inputManager.GetPoseComponentForProfile(
                 hand, ComponentFromBindingPath(poseBindingPath), poseProfilePath);
         }
         else
         {
             InputManager::Hand hand = HandFromPath(space->GetSubactionPath());
+            result.motion = LocatedWorldPose::Motion::Hand;
+            result.hand = hand;
             result.pose = inputManager.GetControllerPose(hand);
         }
     }
@@ -227,6 +237,34 @@ XrResult Space::LocateSpace(Space* baseSpace, XrTime time, XrSpaceLocation* loca
         velocity->velocityFlags = 0;
         velocity->linearVelocity = {0.0f, 0.0f, 0.0f};
         velocity->angularVelocity = {0.0f, 0.0f, 0.0f};
+
+        // Velocity of this space in world. A rigid hand: the grip's linear velocity plus the
+        // rotation's sweep of the lever arm from the grip to this space's origin (aim, an offset).
+        bool known = thisPose.active && basePose.active &&
+                     basePose.motion == LocatedWorldPose::Motion::Static;
+        glm::vec3 linear(0.0f);
+        glm::vec3 angular(0.0f);
+        if (known && thisPose.motion == LocatedWorldPose::Motion::Hand)
+        {
+            glm::vec3 gripPos(0.0f);
+            known = inputManager.GetControllerVelocity(thisPose.hand, linear, angular, gripPos);
+            if (known)
+            {
+                linear += glm::cross(angular, thisPos - gripPos);
+            }
+        }
+        else if (thisPose.motion != LocatedWorldPose::Motion::Static)
+        {
+            known = false;
+        }
+
+        if (known)
+        {
+            // XrSpaceVelocity is expressed in the base space, like the pose.
+            velocity->linearVelocity = ToXr(baseRotInv * linear);
+            velocity->angularVelocity = ToXr(baseRotInv * angular);
+            velocity->velocityFlags = XR_SPACE_VELOCITY_LINEAR_VALID_BIT | XR_SPACE_VELOCITY_ANGULAR_VALID_BIT;
+        }
     }
 
     return XR_SUCCESS;
