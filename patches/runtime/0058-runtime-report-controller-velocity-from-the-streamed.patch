+void InputManager::RecordControllerSample(Hand hand, int64_t timestampNs, const glm::vec3& pos,
+                                          const glm::quat& rot)
+{
+    auto& samples = controllerSamples_[HandIndex(hand)];
+    // A frame that re-reads the same packet adds nothing; a client without timestamps gives no velocity.
+    if (timestampNs <= 0 || (!samples.empty() && timestampNs <= samples.back().timestampNs))
+    {
+        return;
+    }
+    samples.push_back({timestampNs, pos, rot});
+    if (samples.size() > MaxControllerSamples)
+    {
+        samples.erase(samples.begin());
+    }
+
+    // A swing worth throwing with, at most four lines a second per hand: what the app is handed.
+    glm::vec3 linear(0.0f);
+    glm::vec3 angular(0.0f);
+    glm::vec3 grip(0.0f);
+    int64_t& lastLogNs = controllerVelocityLogNs_[HandIndex(hand)];
+    if (timestampNs - lastLogNs >= 250'000'000 && GetControllerVelocity(hand, linear, angular, grip) &&
+        glm::length(linear) >= 1.0f)
+    {
+        lastLogNs = timestampNs;
+        spdlog::info("InputManager: {} hand velocity {:.2f} m/s ({:.2f}, {:.2f}, {:.2f}), {:.1f} rad/s",
+                     hand == Hand::Left ? "left" : "right", glm::length(linear), linear.x, linear.y, linear.z,
+                     glm::length(angular));
+    }
+}
+
+bool InputManager::GetControllerVelocity(Hand hand, glm::vec3& linear, glm::vec3& angular,
+                                         glm::vec3& gripPosition) const
+{
+    const auto& samples = controllerSamples_[HandIndex(hand)];
+    if (samples.size() < 2)
+    {
+        return false;
+    }
+    const ControllerSample& newest = samples.back();
+    // The oldest sample still inside the window, and at least the one before the newest.
+    size_t oldestIndex = samples.size() - 2;
+    while (oldestIndex > 0 && newest.timestampNs - samples[oldestIndex - 1].timestampNs <= VelocityWindowNs)
+    {
+        --oldestIndex;
+    }
+    const ControllerSample& oldest = samples[oldestIndex];
+    const int64_t spanNs = newest.timestampNs - oldest.timestampNs;
+    if (spanNs <= 0 || spanNs > VelocityMaxSpanNs)
+    {
+        return false;
+    }
+    const float dt = static_cast<float>(spanNs) * 1.0e-9f;
+    linear = (newest.position - oldest.position) / dt;
+
+    // World-space angular velocity: the rotation that takes the old orientation to the new one.
+    glm::quat delta = glm::normalize(newest.rotation * glm::inverse(oldest.rotation));
+    if (delta.w < 0.0f)
+    {
+        delta = -delta;
+    }
+    const glm::vec3 axis(delta.x, delta.y, delta.z);
+    const float sinHalf = glm::length(axis);
+    if (sinHalf < 1.0e-6f)
+    {
+        angular = glm::vec3(0.0f);
+    }
+    else
+    {
+        const float angle = 2.0f * std::atan2(sinHalf, delta.w);
+        angular = axis / sinHalf * (angle / dt);
+    }
+    gripPosition = newest.position;
+    return true;
+}
+
