 runtime/src/InputManager.cpp | 85 ++++++++++++++++++++++++++++++++++++
 runtime/src/InputManager.h   | 25 +++++++++++
 runtime/src/Space.cpp        | 38 ++++++++++++++++
 tests/TestInputManager.cpp   | 69 +++++++++++++++++++++++++++++
 tests/TestRuntimeApi.cpp     | 30 ++++++++-----
 6 files changed, 245 insertions(+), 16 deletions(-)

