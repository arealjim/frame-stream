+                               glm::vec3& gripPosition) const;
+
     // Hand tracking joints (26 joints, world space relative to baseSpace)
     void GetHandJointLocations(Hand hand, XrHandJointLocationEXT* joints, uint32_t jointCount) const;
 
@@ -130,6 +139,22 @@ class InputManager
     XrPosef GetTrackedHandPose(Hand hand, const std::string& componentPath) const;
     float GetTrackedPinchValue(Hand hand) const;
     float GetTrackedGraspValue(Hand hand) const;
+    void RecordControllerSample(Hand hand, int64_t timestampNs, const glm::vec3& pos, const glm::quat& rot);
+
+    struct ControllerSample
+    {
+        int64_t timestampNs = 0;
+        glm::vec3 position{0.0f};
+        glm::quat rotation{1.0f, 0.0f, 0.0f, 0.0f};
+    };
+    // Recent tracked grip samples per hand, oldest first; cleared when the hand loses tracking.
+    std::array<std::vector<ControllerSample>, 2> controllerSamples_;
+    static constexpr size_t MaxControllerSamples = 16;
+    std::array<int64_t, 2> controllerVelocityLogNs_ = {0, 0};
+    // The velocity spans about this much of the newest samples: long enough to smooth a 72-90 Hz
+    // pose stream, short enough that a release still reads the swing rather than its wind-up.
+    static constexpr int64_t VelocityWindowNs = 40'000'000;
+    static constexpr int64_t VelocityMaxSpanNs = 100'000'000;
 
     TrackingReceiver* trackingReceiver_ = nullptr;
 
