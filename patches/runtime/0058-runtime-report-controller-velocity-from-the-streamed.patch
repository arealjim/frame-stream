+
+TEST_CASE("InputManager — controller velocity from streamed grip poses", "[input][velocity]")
+{
+    InputManager im;
+    TrackingReceiver receiver;
+    im.SetTrackingReceiver(&receiver);
+    im.SetStreamingClientName("Meta Quest 2");
+
+    // A throw: the right hand moves at (2, 1, -3) m/s while turning about +Y at 3 rad/s, sampled
+    // at 72 Hz. Expected values are the motion that generated the samples, not the estimator.
+    const glm::vec3 throwVelocity(2.0f, 1.0f, -3.0f);
+    const float yawRate = 3.0f;
+    const glm::vec3 start(0.30f, 1.20f, -0.40f);
+    const int64_t t0 = 5'000'000'000;
+    const int64_t stepNs = 13'888'889;
+    auto inject = [&](int i) {
+        const float t = static_cast<float>(i * stepNs) * 1.0e-9f;
+        const glm::vec3 pos = start + throwVelocity * t;
+        const glm::quat rot = glm::angleAxis(yawRate * t, glm::vec3(0.0f, 1.0f, 0.0f));
+        oxr::protocol::TrackingPacket packet = {};
+        packet.timestampNs = t0 + i * stepNs;
+        packet.headOrientation[3] = 1.0f;
+        packet.trackingFlags = oxr::protocol::TRACKING_FLAG_RIGHT_CONTROLLER_ACTIVE;
+        packet.rightControllerPos[0] = pos.x;
+        packet.rightControllerPos[1] = pos.y;
+        packet.rightControllerPos[2] = pos.z;
+        packet.rightControllerRot[0] = rot.x;
+        packet.rightControllerRot[1] = rot.y;
+        packet.rightControllerRot[2] = rot.z;
+        packet.rightControllerRot[3] = rot.w;
+        receiver.InjectPacket(reinterpret_cast<const uint8_t*>(&packet), sizeof(packet));
+        im.Update(0.0f);
+    };
+
+    glm::vec3 linear(0.0f);
+    glm::vec3 angular(0.0f);
+    glm::vec3 grip(0.0f);
+
+    inject(0);
+    CHECK_FALSE(im.GetControllerVelocity(InputManager::Hand::Right, linear, angular, grip));
+
+    // A frame that re-reads the same packet must not count as a still sample.
+    im.Update(0.0f);
+    inject(1);
+    REQUIRE(im.GetControllerVelocity(InputManager::Hand::Right, linear, angular, grip));
+    CHECK_THAT(linear.x, WithinAbs(2.0f, 0.01f));
+    CHECK_THAT(linear.z, WithinAbs(-3.0f, 0.01f));
+
+    for (int i = 2; i < 8; ++i)
+    {
+        inject(i);
+    }
+    REQUIRE(im.GetControllerVelocity(InputManager::Hand::Right, linear, angular, grip));
+    CHECK_THAT(linear.x, WithinAbs(2.0f, 0.01f));
+    CHECK_THAT(linear.y, WithinAbs(1.0f, 0.01f));
+    CHECK_THAT(linear.z, WithinAbs(-3.0f, 0.01f));
+    CHECK_THAT(angular.x, WithinAbs(0.0f, 0.01f));
+    CHECK_THAT(angular.y, WithinAbs(3.0f, 0.01f));
+    CHECK_THAT(angular.z, WithinAbs(0.0f, 0.01f));
+    CHECK_THAT(grip.x, WithinAbs(start.x + 2.0f * 7 * stepNs * 1.0e-9f, 0.001f));
+
+    // Losing tracking forgets the hand: no stale throw on the next pickup.
+    oxr::protocol::TrackingPacket lost = {};
+    lost.timestampNs = t0 + 8 * stepNs;
+    lost.headOrientation[3] = 1.0f;
+    receiver.InjectPacket(reinterpret_cast<const uint8_t*>(&lost), sizeof(lost));
+    im.Update(0.0f);
+    CHECK_FALSE(im.GetControllerVelocity(InputManager::Hand::Right, linear, angular, grip));
+}
