     {
@@ -1872,9 +1901,10 @@ void StreamingServer::HandleClientConnect(const oxr::protocol::ClientConnect& cl
                         ? ParseFoveationPreset(config.foveatedEncodingPreset)
                         : oxr::protocol::FoveationPreset::Off;
