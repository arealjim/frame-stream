diff --git a/runtime/src/ClientAdmission.h b/runtime/src/ClientAdmission.h
new file mode 100644
index 0000000..262e43f
--- /dev/null
+++ b/runtime/src/ClientAdmission.h
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// Pure admission decision for a WiFi ClientConnect, factored out of StreamingServer
+// so the second-client case is unit-testable without a live session.
+//
+// The control thread accepts any ClientConnect while WiFi is enabled, whatever the
+// server state. HandleClientConnect then resets the tracking history and rebuilds
+// the encoder for the newcomer, so a second client that connects while a headset is
+// streaming hijacks the session: the single TrackingReceiver interleaves two clocks
+// and the rendered head pose jumps (seen as violent shaking in the headset when the
+// desktop simulator auto-connected beside a real Steam Frame, 2026-10-17).
+//
+// Policy: while a client is connected, a ClientConnect from a DIFFERENT address is
+// refused. A ClientConnect from the same address is still accepted, because that is
+// how a client resends a lost ClientConnect and how a restarted client (new source
+// port, same host) reconnects before the liveness watchdog has noticed the old one
+// is gone. The port is deliberately not compared.
+namespace oxrsys
+{
+
+struct ClientAdmissionDecision
+{
+    bool accept = true;
+    // True when the refusal should be logged: the first refusal of a given address,
+    // then at most once per logIntervalNs for the same address, so a retrying
+    // client cannot flood the log.
+    bool log = false;
+};
+
+// Remembered between decisions: which address was last refused and when it was
+// last logged.
+struct ClientAdmissionState
+{
+    std::string lastRefusedIp;
+    int64_t lastRefusalLogNs = 0;
+};
+
+inline ClientAdmissionDecision EvaluateClientAdmission(ClientAdmissionState& state,
+                                                       bool clientConnected,
+                                                       const std::string& connectedIp,
+                                                       const std::string& candidateIp,
+                                                       int64_t nowNs,
+                                                       int64_t logIntervalNs)
+{
+    ClientAdmissionDecision decision;
+    if (!clientConnected || connectedIp.empty() || connectedIp == candidateIp)
+    {
+        return decision;
+    }
+    decision.accept = false;
+    if (state.lastRefusedIp != candidateIp || state.lastRefusalLogNs == 0 ||
+        nowNs - state.lastRefusalLogNs >= logIntervalNs)
+    {
+        decision.log = true;
+        state.lastRefusedIp = candidateIp;
+        state.lastRefusalLogNs = nowNs;
+    }
+    return decision;
+}
+
+} // namespace oxrsys
diff --git a/runtime/src/StreamingServer.cpp b/runtime/src/StreamingServer.cpp
index 1c503d4..6e2292e 100644
--- a/runtime/src/StreamingServer.cpp
+++ b/runtime/src/StreamingServer.cpp
@@ -51,6 +51,11 @@ constexpr int64_t kStreamConfigAckTimeoutNs =
         std::chrono::milliseconds(500)).count();
 constexpr uint32_t kStreamConfigMaxRetries = 2;
 // Treat a connected client as gone if it sends no tracking for this long (abrupt UDP kill).
+// A refused ClientConnect is logged at most this often per address: the desktop
+// simulator retries every second when it auto-connects.
+constexpr int64_t kClientAdmissionLogIntervalNs =
+    std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::seconds(5)).count();
 constexpr int64_t kClientLivenessTimeoutNs =
     std::chrono::duration_cast<std::chrono::nanoseconds>(
         std::chrono::seconds(3)).count();
@@ -1658,6 +1663,37 @@ void StreamingServer::EncodeThread()
 void StreamingServer::HandleClientConnect(const oxr::protocol::ClientConnect& clientConnect,
                                           const sockaddr_in& clientAddr)
 {
+    char ipStr[INET_ADDRSTRLEN];
+    inet_ntop(AF_INET, &clientAddr.sin_addr, ipStr, sizeof(ipStr));
+
+    // One client at a time. A ClientConnect from a second address while a client is
+    // streaming would reset its tracking history and rebuild its encoder underneath it,
+    // and two tracking clocks interleaved in one TrackingReceiver make the rendered head
+    // pose jump. The connected address may always reconnect (a resent ClientConnect, or a
+    // restart on a new port before the liveness watchdog has noticed).
+    {
+        std::string connectedIp;
+        std::string connectedName;
+        {
+            std::lock_guard<std::mutex> lock(clientMutex_);
+            connectedIp = clientIp_;
+            connectedName = clientName_;
+        }
+        const oxrsys::ClientAdmissionDecision admission = oxrsys::EvaluateClientAdmission(
+            clientAdmission_, state_.load() == State::Connected, connectedIp, ipStr,
+            SteadyClockNowNs(), kClientAdmissionLogIntervalNs);
+        if (!admission.accept)
+        {
+            if (admission.log)
+            {
+                spdlog::warn("StreamingServer: refusing ClientConnect from {} while '{}' ({}) is "
+                             "connected; disconnect it first",
+                             ipStr, connectedName, connectedIp);
+            }
+            return;
+        }
+    }
+
     // A new client brings a new clock; drop the previous client's tracking history so its
     // last timestamp cannot shadow every packet of this one (see TrackingReceiver::ResetHistory).
     if (trackingReceiver_)
@@ -1665,8 +1701,6 @@ void StreamingServer::HandleClientConnect(const oxr::protocol::ClientConnect& cl
         trackingReceiver_->ResetHistory();
     }
 
-    char ipStr[INET_ADDRSTRLEN];
-    inet_ntop(AF_INET, &clientAddr.sin_addr, ipStr, sizeof(ipStr));
     std::string clientName(clientConnect.deviceName,
         BoundedStringLength(clientConnect.deviceName, sizeof(clientConnect.deviceName)));
 
