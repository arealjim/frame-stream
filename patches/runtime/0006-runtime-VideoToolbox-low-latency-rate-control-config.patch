diff --git a/runtime/src/Config.h b/runtime/src/Config.h
index d74018a..e8ba995 100644
--- a/runtime/src/Config.h
+++ b/runtime/src/Config.h
@@ -24,6 +24,11 @@ struct ConfigValues
     std::string videoCodec = "h265"; // "h265", "h264", "auto"
     std::string encoderPreset = "balanced"; // "quality", "balanced", "speed"
     bool encoder10Bit = false;      // Encode HEVC Main10 for capable H.265 clients
+    // VideoToolbox low-latency rate control for the in-process hardware session
+    // (kVTVideoEncoderSpecification_EnableLowLatencyRateControl): no look-ahead,
+    // no periodic IDR (keyframes come from ForceKeyFrame, i.e. client requests).
+    // Measured 2026-10-17, M5 Pro, 2272x1264 HEVC @72: encode callback 12.6 -> 8.0 ms.
+    bool encoderLowLatency = true;
 
     // Out-of-process native-arm64 hardware encoder helper. When the runtime
     // dylib is loaded by an x86_64/Rosetta host it cannot reach VideoToolbox's
diff --git a/runtime/src/VideoEncoder.mm b/runtime/src/VideoEncoder.mm
index 78e0e48..d24c0e5 100644
--- a/runtime/src/VideoEncoder.mm
+++ b/runtime/src/VideoEncoder.mm
@@ -992,12 +992,22 @@ bool VideoEncoder::Initialize(uint32_t width, uint32_t height, uint32_t fps,
     // unconditional is what made a Rosetta host silently get the ~27-40ms/frame
     // software HEVC encoder; now that path is entered knowingly, logged, and
     // (when the helper covers the codec) only as the fallback behind it.
-    NSDictionary* encoderSpec = @{
+    NSMutableDictionary* encoderSpec = [@{
         (NSString*)kVTVideoEncoderSpecification_EnableHardwareAcceleratedVideoEncoder:
             forceSoftware ? @NO : @YES,
         (NSString*)kVTVideoEncoderSpecification_RequireHardwareAcceleratedVideoEncoder:
             hardwareInProcess ? @YES : @NO,
-    };
+    } mutableCopy];
+    // Low-latency rate control is a property of the hardware encoder: no
+    // look-ahead, no periodic IDR, output as soon as the frame is coded. The
+    // relaxed retry below drops it with the hardware requirement, so a session
+    // whose encoder cannot do it still comes up, loudly.
+    const bool lowLatencyRequested = initialConfig.encoderLowLatency && !forceSoftware;
+    if (lowLatencyRequested)
+    {
+        encoderSpec[(NSString*)kVTVideoEncoderSpecification_EnableLowLatencyRateControl] = @YES;
+    }
+    bool lowLatencyActive = lowLatencyRequested;
 
     VTCompressionSessionRef compressionSession = nullptr;
     OSStatus status = VTCompressionSessionCreate(
@@ -1017,8 +1027,10 @@ bool VideoEncoder::Initialize(uint32_t width, uint32_t height, uint32_t fps,
         // Retry without the requirement rather than failing the session: a slow
         // encoder beats no video. Loudly, because it should not happen.
         spdlog::warn("VideoEncoder: hardware-required compression session failed ({}) although a "
-                     "hardware {} encoder was reported - retrying without the requirement",
-                     status, VideoCodecName(codec_));
+                     "hardware {} encoder was reported - retrying without the requirement{}",
+                     status, VideoCodecName(codec_),
+                     lowLatencyRequested ? " (and without low-latency rate control)" : "");
+        lowLatencyActive = false;
         NSDictionary* relaxedSpec = @{
             (NSString*)kVTVideoEncoderSpecification_EnableHardwareAcceleratedVideoEncoder: @YES,
             (NSString*)kVTVideoEncoderSpecification_RequireHardwareAcceleratedVideoEncoder: @NO,
@@ -1188,8 +1200,9 @@ bool VideoEncoder::Initialize(uint32_t width, uint32_t height, uint32_t fps,
 
     initialized_ = true;
 
-    spdlog::info("VideoEncoder: Initialized {} encoder {}x{} @ {}fps, {}Mbps (slots={}, keyframe={}s, preset={})",
-                  VideoCodecName(codec_), width, height, fps, bitrateMbps, SlotCount, keyframeIntervalSec, preset);
+    spdlog::info("VideoEncoder: Initialized {} encoder {}x{} @ {}fps, {}Mbps (slots={}, keyframe={}s, preset={}, low_latency={})",
+                  VideoCodecName(codec_), width, height, fps, bitrateMbps, SlotCount, keyframeIntervalSec, preset,
+                  lowLatencyActive ? "on" : "off");
     return true;
 }
 
