 #include <iterator>
 #include <netinet/in.h>
 #include <netinet/tcp.h>
@@ -78,6 +80,23 @@ bool ReadTcpRecord(int socket, protocol::TcpRecordHeader& header, std::vector<ui
     return ReadAll(socket, payload.data(), payload.size());
 }
 
+// Review 2026-10-21 (H5): pose floats off the wire reach xrEndFrame; a NaN or a non-unit quaternion fails the
+// frame (XR_ERROR_POSE_INVALID) and the picture vanishes. Finite, |p| <= 100 m, |q| within 10 % of 1, then normalised.
+bool SanitizePose(float* p, float* q)
+{
+    for (int i = 0; i < 3; ++i) if (!std::isfinite(p[i]) || std::fabs(p[i]) > 100.0f) return false;
+    float n2 = 0.0f;
+    for (int i = 0; i < 4; ++i) { if (!std::isfinite(q[i])) return false; n2 += q[i] * q[i]; }
+    if (n2 < 0.81f || n2 > 1.21f) return false;
+    const float inv = 1.0f / std::sqrt(n2);
+    for (int i = 0; i < 4; ++i) q[i] *= inv;
+    return true;
+}
+
+// Review 2026-10-21 (H3/H4): a header is trusted for its sizes before this. 4096 packets is ~5.7 MB per NAL, far
+// above any frame at 50 Mbit/s; a totalPackets of 0 opened a frame nothing could complete and so a keyframe stall.
+constexpr uint32_t kMaxPacketsPerFrame = 4096;
+
 void ConfigureTcpSocket(int socket)
 {
     int nodelay = 1;
@@ -166,6 +185,15 @@ void NetworkReceiver::DiscoveryThread(OnServerFoundCallback callback)
         socklen_t addrLen = sizeof(senderAddr);
         ssize_t received = recvfrom(discoverySocket_, buffer, sizeof(buffer), 0,
                                      (sockaddr*)&senderAddr, &addrLen);
+        // Review 2026-10-21 (H6): with a pinned server (FRAME_CLIENT_SERVER) only its announce counts; the first
+        // announcer otherwise received the wearer's head and eye tracking and could feed the video.
+        if (received > 0 && haveDirectServer_ && senderAddr.sin_addr.s_addr != directServer_.sin_addr.s_addr)
+        {
+            static uint32_t ignored = 0; ignored++;
+            char who[INET_ADDRSTRLEN]; inet_ntop(AF_INET, &senderAddr.sin_addr, who, sizeof(who));
+            if (ignored <= 5 || ignored % 100 == 0) LOGE("Ignored announce from %s: server pinned (%u so far)", who, ignored);
+            continue;
+        }
         if (received >= (ssize_t)protocol::SERVER_ANNOUNCE_BASE_SIZE)
         {
             protocol::ServerAnnounce hello = {};
@@ -344,8 +372,11 @@ bool NetworkReceiver::StartReceivingTcp(uint16_t videoPort, OnNalUnitCallback ca
 void NetworkReceiver::StopDiscovery()
 {
     discovering_.store(false);
-    // Don't close socket or join thread here — may be called from the discovery thread itself
-    LOGI("Discovery stop requested");
+    // Review 2026-10-21 (H7): the caller's callback captures live only until this returns, so the thread must be
+    // gone by then. shutdown() wakes the recvfrom; the join is skipped only when called from the thread itself.
+    if (discoverySocket_ >= 0) shutdown(discoverySocket_, SHUT_RDWR);
+    if (discoveryThread_.joinable() && discoveryThread_.get_id() != std::this_thread::get_id()) discoveryThread_.join();
+    LOGI("Discovery stopped");
 }
 
