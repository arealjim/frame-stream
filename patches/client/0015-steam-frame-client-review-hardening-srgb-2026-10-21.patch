+        if (bad <= 5 || bad % 1000 == 0) LOGE("Dropped render pose with non-finite or non-unit values (frame %u, %u so far)", header.frameIndex, bad);
+        return;
+    }
     if (header.flags & protocol::VIDEO_FLAG_FOVEATION_CENTER)
     {
         pose.hasFoveationCenter = true;
@@ -512,6 +571,12 @@ void NetworkReceiver::StoreRenderPose(const protocol::TcpRenderPose& tcpPose)
     pose.presentationTimeUs = tcpPose.presentationTimeNs / 1000;
     memcpy(pose.position, tcpPose.position, sizeof(float) * 3);
