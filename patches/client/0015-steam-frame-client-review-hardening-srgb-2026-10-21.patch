+    const bool acceptAny = !haveVideoServer_ || (getenv("FRAME_CLIENT_ACCEPT_ANY_SOURCE") && atoi(getenv("FRAME_CLIENT_ACCEPT_ANY_SOURCE")) != 0);
+    uint32_t foreign = 0, malformed = 0;
     while (receiving_.load())
     {
         PunchVideoPath();
-        ssize_t received = recv(videoSocket_, buffer, sizeof(buffer), 0);
+        sockaddr_in from = {};
+        socklen_t fromLen = sizeof(from);
+        ssize_t received = recvfrom(videoSocket_, buffer, sizeof(buffer), 0, (sockaddr*)&from, &fromLen);
+        if (received > 0 && !acceptAny && from.sin_addr.s_addr != videoServer_.sin_addr.s_addr)
+        {
+            foreign++;
+            if (foreign <= 5 || foreign % 1000 == 0) { char who[INET_ADDRSTRLEN]; inet_ntop(AF_INET, &from.sin_addr, who, sizeof(who)); LOGE("Dropped video datagram from %s (not the server; %u so far)", who, foreign); }
+            continue;
+        }
         if (received < (ssize_t)sizeof(protocol::VideoPacketHeader))
         {
             // 1 ms receive timeout: let a parked NAL retransmit wait expire even when nothing arrives.
@@ -391,6 +434,16 @@ void NetworkReceiver::ReceiveThread(OnNalUnitCallback callback)
             continue;
         }
 
+        // Review 2026-10-21 (H3/H4): bound the header before the assembler sizes anything from it. Parity packets
+        // carry their group index in packetIndex, so only data packets get the index check.
+        if (header->totalPackets == 0 || header->totalPackets > kMaxPacketsPerFrame ||
+            header->payloadSize > protocol::MAX_PACKET_PAYLOAD ||
+            (!(header->flags & protocol::VIDEO_FLAG_FEC) && header->packetIndex >= header->totalPackets))
