+        if (bad <= 5 || bad % 1000 == 0) LOGE("Dropped TCP render pose with non-finite or non-unit values (frame %u, %u so far)", tcpPose.frameIndex, bad);
+        return;
+    }
     pose.hasFoveationCenter = tcpPose.hasFoveationCenter != 0;
     pose.foveationCenterX = tcpPose.foveationCenterX;
     pose.foveationCenterY = tcpPose.foveationCenterY;
@@ -650,6 +715,20 @@ void NetworkReceiver::Stop()
     discovering_.store(false);
     receiving_.store(false);
 
+    // Review 2026-10-21 (H8): close() does not wake a thread blocked in recv on Linux (the USB/TCP path has no
+    // timeout), and a closed fd number can be reused under the still-running thread. Wake, join, then close.
+    if (discoverySocket_ >= 0) shutdown(discoverySocket_, SHUT_RDWR);
+    if (videoSocket_ >= 0) shutdown(videoSocket_, SHUT_RDWR);
+
+    if (discoveryThread_.joinable())
+    {
+        discoveryThread_.join();
+    }
+    if (receiveThread_.joinable())
+    {
+        receiveThread_.join();
+    }
+
     if (discoverySocket_ >= 0)
     {
         close(discoverySocket_);
@@ -661,15 +740,6 @@ void NetworkReceiver::Stop()
         videoSocket_ = -1;
     }
 
-    if (discoveryThread_.joinable())
