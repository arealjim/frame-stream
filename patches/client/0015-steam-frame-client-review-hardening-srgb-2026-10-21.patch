diff --git a/clients/steam-frame/shaders/sample.frag b/clients/steam-frame/shaders/sample.frag
index c33d570..e287f43 100644
--- a/clients/steam-frame/shaders/sample.frag
+++ b/clients/steam-frame/shaders/sample.frag
@@ -19,8 +19,14 @@ layout(push_constant) uniform Push {
     int  nv12;           // 1 = binding 0 is luma, binding 1 chroma; convert here
     int  fullRange;      // 1 = the stream signals full range (encoder_full_range): no 16-235 scaling
     int  alphaKey;       // 1 = passthrough frame: alpha from a black key, as oxrsys's Quest client does
+    int  srgbTarget;     // 1 = the attachment is an sRGB format: the store re-encodes, so hand it LINEAR light
 } pc;
 
+// The video carries ordinary gamma-encoded (sRGB/BT.709) values: the server re-encodes linear to sRGB before
+// VideoToolbox (VideoEncoder.mm). An sRGB swapchain image applies linear->sRGB again on store, and the
+// compositor decodes it once, so without this the panel showed sRGB(sRGB(x)): lifted blacks, flat contrast.
+vec3 srgbToLinear(vec3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c)); }
+
 // Axis-aligned foveated-encoding forward map (matches oxrsys / ALVR AADT).
 // CPU mirror + accuracy test: tests/foveation_warp.h (keep the two in sync).
 float compressAxis(float eyeUv, float centerSize, float centerShift, float edgeRatio) {
@@ -96,5 +102,5 @@ void main() {
     vec3 c = sampleVideo(sourceUv);
     float a = 1.0;
     if (pc.alphaKey != 0) a = smoothstep(0.02, 0.10, max(c.r, max(c.g, c.b)));   // black = the app's transparent clear
-    outColor = vec4(c, a);
+    outColor = vec4(pc.srgbTarget != 0 ? srgbToLinear(c) : c, a);
 }
