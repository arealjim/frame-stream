 }
 
+void NetworkReceiver::StoreDepthGrid(const uint8_t* payload, size_t payloadSize)
+{
+    if (payloadSize < sizeof(protocol::DepthGridHeader)) return;
+    protocol::DepthGridHeader h;
+    memcpy(&h, payload, sizeof(h));
+    if (h.magic != protocol::DEPTH_GRID_MAGIC || h.eye > 1 || h.grid == 0 || h.grid > protocol::DEPTH_GRID_MAX_SIZE ||
+        h.rows == 0 || (uint32_t)h.row0 + h.rows > h.grid || payloadSize < sizeof(h) + (size_t)h.rows * h.grid)
+        return;
+    std::lock_guard<std::mutex> lock(depthGridMutex_);
+    DepthGrid& a = depthAssembling_[h.eye];
+    if (a.frameIndex != h.frameIndex || a.grid != h.grid || a.data.size() != (size_t)h.grid * h.grid) {
+        a.frameIndex = h.frameIndex; a.grid = h.grid; a.nearMm = h.nearMm ? h.nearMm : 250;
+        a.data.assign((size_t)h.grid * h.grid, 0); a.rowsHave = 0;
+    }
+    memcpy(a.data.data() + (size_t)h.row0 * h.grid, payload + sizeof(h), (size_t)h.rows * h.grid);
+    a.rowsHave += h.rows;
+    // Complete when every row has come (a lost chunk drops that eye's grid for this frame; the last one stands).
+    if (a.rowsHave >= a.grid) {
+        a.receivedNs = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+        a.valid = true;
+        depthLatest_[h.eye] = a;
+        a.rowsHave = 0; a.frameIndex = ~0u;
+        depthGridsReceived_.fetch_add(1);
+    }
+}
+
+bool NetworkReceiver::GetLatestDepthGrid(uint32_t eye, DepthGrid& out) const
+{
+    if (eye > 1) return false;
+    std::lock_guard<std::mutex> lock(depthGridMutex_);
+    if (!depthLatest_[eye].valid) return false;
+    out = depthLatest_[eye];
+    return true;
+}
+
 void NetworkReceiver::StoreRenderPose(const protocol::VideoPacketHeader& header,
                                       const uint8_t* payload, size_t payloadSize)
 {
@@ -787,6 +835,10 @@ void NetworkReceiver::Stop()
         latestRenderPose_ = {};
         renderPoses_.clear();
     }
+    {
+        std::lock_guard<std::mutex> lock(depthGridMutex_);
+        for (int e = 0; e < 2; e++) { depthLatest_[e] = {}; depthAssembling_[e] = {}; }
+    }
     connectionLostCallback_ = nullptr;
 
     LOGI("Network receiver stopped");
