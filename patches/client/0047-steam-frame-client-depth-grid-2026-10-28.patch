+// Depth layer for positional reprojection. The grid's value q is 255 * near / z (DepthGridHeader); it goes into a
+// grid x grid depth image per eye as standard Z over kDepthNear..kDepthFar, q = 0 being the far plane.
+static constexpr float kDepthNear = 0.1f, kDepthFar = 100.0f;
+static bool CreateDepthSwapchains(App& app, uint32_t grid)
+{
+    uint32_t count = 0;
+    xrEnumerateSwapchainFormats(app.session, 0, &count, nullptr);
+    std::vector<int64_t> formats(count);
+    xrEnumerateSwapchainFormats(app.session, count, &count, formats.data());
+    int64_t fmt = 0;
+    for (int64_t want : {(int64_t)VK_FORMAT_D32_SFLOAT, (int64_t)VK_FORMAT_D16_UNORM})
+        for (int64_t f : formats) if (!fmt && f == want) fmt = f;
+    if (!fmt) { LOG_ERROR("depth grid: no D32F/D16 swapchain format offered; off"); return false; }
+    const uint32_t bpp = fmt == VK_FORMAT_D32_SFLOAT ? 4 : 2;
+    for (uint32_t eye = 0; eye < VIEW_COUNT; eye++) {
+        Swapchain& d = app.depthSwapchains[eye];
+        d.format = fmt; d.width = grid; d.height = grid;
+        XrSwapchainCreateInfo ci = {XR_TYPE_SWAPCHAIN_CREATE_INFO};
+        ci.usageFlags = XR_SWAPCHAIN_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_TRANSFER_DST_BIT;
+        ci.format = fmt; ci.sampleCount = 1; ci.width = grid; ci.height = grid;
+        ci.faceCount = 1; ci.arraySize = 1; ci.mipCount = 1;
+        if (XR_FAILED(xrCreateSwapchain(app.session, &ci, &d.handle))) {
+            LOG_ERROR("depth grid: xrCreateSwapchain(depth %ux%u) failed; off", grid, grid); return false;
+        }
+        uint32_t n = 0;
+        xrEnumerateSwapchainImages(d.handle, 0, &n, nullptr);
+        std::vector<XrSwapchainImageVulkanKHR> imgs(n, {XR_TYPE_SWAPCHAIN_IMAGE_VULKAN_KHR});
+        xrEnumerateSwapchainImages(d.handle, n, &n, (XrSwapchainImageBaseHeader*)imgs.data());
+        for (auto& im : imgs) d.images.push_back(im.image);
+        // One host-visible staging buffer per image: image i is only re-acquired after the compositor has read it,
+        // which is after the copy out of buffer i ran.
+        for (uint32_t i = 0; i < n; i++) {
+            VkBufferCreateInfo bci = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+            bci.size = (VkDeviceSize)grid * grid * bpp; bci.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+            bci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+            VkBuffer buf = VK_NULL_HANDLE; VkDeviceMemory mem = VK_NULL_HANDLE; void* map = nullptr;
+            VK_CHECK(vkCreateBuffer(app.device, &bci, nullptr, &buf));
+            VkMemoryRequirements mr; vkGetBufferMemoryRequirements(app.device, buf, &mr);
+            VkMemoryAllocateInfo mai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+            mai.allocationSize = mr.size;
+            mai.memoryTypeIndex = FindMemoryType(app, mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+            VK_CHECK(vkAllocateMemory(app.device, &mai, nullptr, &mem));
+            VK_CHECK(vkBindBufferMemory(app.device, buf, mem, 0));
+            VK_CHECK(vkMapMemory(app.device, mem, 0, VK_WHOLE_SIZE, 0, &map));
+            app.depthBufs[eye].push_back(buf); app.depthMems[eye].push_back(mem); app.depthMaps[eye].push_back(map);
+        }
+    }
+    app.depthGrid = grid;
+    LOG_INFO("depth grid: depth swapchains %ux%u format %lld, %zu images per eye, near %.1f far %.0f",
+             grid, grid, (long long)fmt, app.depthSwapchains[0].images.size(), kDepthNear, kDepthFar);
+    return true;
+}
+
+static void DestroyDepthSwapchains(App& app)
+{
+    for (uint32_t eye = 0; eye < VIEW_COUNT; eye++) {
+        for (size_t i = 0; i < app.depthBufs[eye].size(); i++) {
+            vkDestroyBuffer(app.device, app.depthBufs[eye][i], nullptr);
+            vkFreeMemory(app.device, app.depthMems[eye][i], nullptr);
+        }
+        app.depthBufs[eye].clear(); app.depthMems[eye].clear(); app.depthMaps[eye].clear();
+        if (app.depthSwapchains[eye].handle) xrDestroySwapchain(app.depthSwapchains[eye].handle);
+        app.depthSwapchains[eye] = {};
+    }
+    app.depthGrid = 0;
+}
+
+// Acquire this frame's depth image for the eye and record the copy of the grid into it.
+static bool AcquireDepthGrid(App& app, uint32_t eye, VkCommandBuffer cmd, const std::vector<uint8_t>& q, uint16_t nearMm)
+{
+    Swapchain& d = app.depthSwapchains[eye];
+    uint32_t i = 0;
+    XrSwapchainImageAcquireInfo ai = {XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+    if (XR_FAILED(xrAcquireSwapchainImage(d.handle, &ai, &i))) return false;
+    XrSwapchainImageWaitInfo wi = {XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO}; wi.timeout = XR_INFINITE_DURATION;
+    if (XR_FAILED(xrWaitSwapchainImage(d.handle, &wi))) {   // acquired but not waited: it cannot be released, so stop
+        app.depthBroken = true; LOG_ERROR("depth grid: xrWaitSwapchainImage failed; depth off for this run"); return false;
+    }
+    const float nearM = nearMm / 1000.0f;
+    const size_t n = (size_t)d.width * d.height;
+    if (d.format == VK_FORMAT_D32_SFLOAT) {
+        float* out = (float*)app.depthMaps[eye][i];
+        for (size_t k = 0; k < n; k++) {
+            if (!q[k]) { out[k] = 1.0f; continue; }
+            const float z = std::max(kDepthNear, nearM * 255.0f / q[k]);
+            out[k] = std::min(1.0f, kDepthFar * (z - kDepthNear) / (z * (kDepthFar - kDepthNear)));
+        }
+    } else {
+        uint16_t* out = (uint16_t*)app.depthMaps[eye][i];
+        for (size_t k = 0; k < n; k++) {
+            if (!q[k]) { out[k] = 65535; continue; }
+            const float z = std::max(kDepthNear, nearM * 255.0f / q[k]);
+            out[k] = (uint16_t)(std::min(1.0f, kDepthFar * (z - kDepthNear) / (z * (kDepthFar - kDepthNear))) * 65535.0f + 0.5f);
+        }
+    }
+    VkImageMemoryBarrier b = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = d.images[i];
+    b.subresourceRange = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 1, 0, 1};
+    b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED; b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    b.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+    VkBufferImageCopy c = {};
+    c.imageSubresource = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1};
+    c.imageExtent = {d.width, d.height, 1};
+    vkCmdCopyBufferToImage(cmd, app.depthBufs[eye][i], d.images[i], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &c);
+    b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL; b.newLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT; b.dstAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT;
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+    return true;
+}
+
 static std::vector<char> LoadFile(const std::string& path)
 {
     std::ifstream f(path, std::ios::binary | std::ios::ate);
@@ -1607,6 +1737,36 @@ static void RenderFrame(App& app)
         {XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW});
     XrCompositionLayerProjection layer = {XR_TYPE_COMPOSITION_LAYER_PROJECTION};
     bool submitLayer = false;
+    // Positional reprojection: this frame's depth layer per eye (chained on projViews, so it lives to xrEndFrame).
+    XrCompositionLayerDepthInfoKHR depthInfo[VIEW_COUNT] = {{XR_TYPE_COMPOSITION_LAYER_DEPTH_INFO_KHR}, {XR_TYPE_COMPOSITION_LAYER_DEPTH_INFO_KHR}};
+    bool depthAcquired[VIEW_COUNT] = {false, false};
+    bool depthChained = false;
+    static std::vector<uint8_t> depthQ[VIEW_COUNT];
+    static uint32_t depthQGrid[VIEW_COUNT] = {0, 0};
+    static uint16_t depthQNear[VIEW_COUNT] = {250, 250};
+    bool depthFresh = false;
+    if (g_streamMode && app.hasDepthLayer && !app.depthBroken) {
+        // Fresh = both eyes have a grid of one size that arrived in the last 250 ms. A stale grid is worse than none:
+        // without depth the stamp falls back to the rotation-only warp below.
+        const int64_t nowNs = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        bool ok = true;
+        for (uint32_t eye = 0; eye < VIEW_COUNT; eye++) {
+            int64_t rx = 0; uint32_t fi = 0;
+            if (!g_stream.LatestDepthGrid(eye, depthQ[eye], depthQGrid[eye], depthQNear[eye], rx, fi) || nowNs - rx > 250000000) ok = false;
+        }
+        depthFresh = ok && depthQGrid[0] == depthQGrid[1] && depthQ[0].size() == (size_t)depthQGrid[0] * depthQGrid[0] &&
+                     depthQ[1].size() == depthQ[0].size();
+        if (depthFresh && app.depthGrid != depthQGrid[0]) {
+            if (app.depthGrid) DestroyDepthSwapchains(app);
+            if (!CreateDepthSwapchains(app, depthQGrid[0])) { DestroyDepthSwapchains(app); app.depthBroken = true; depthFresh = false; }
+        }
+        static bool lastFresh = false; static uint32_t freshFlips = 0;
+        if (depthFresh != lastFresh && freshFlips < 40) {
+            freshFlips++; lastFresh = depthFresh;
+            LOG_INFO("depth grid: %s (%ux%u); the stamp carries the %s eye position", depthFresh ? "fresh, chained" : "stale or absent, not chained",
+                     depthQGrid[0], depthQGrid[0], depthFresh ? "rendered" : "displayed");
+        }
+    }
     // Passthrough (2026-10-19): a server frame flagged alpha-blend is submitted with source alpha over the
     // headset's passthrough; the shader keys black to transparent. Opaque frames are unchanged.
     // The displayed frame's own flag (review L7), refreshed below when a new frame is taken.
@@ -1931,7 +2091,9 @@ static void RenderFrame(App& app)
                     const float rx = 1.0f - 2.0f * (qy * qy + qz * qz), ry = 2.0f * (qx * qy + qw * qz), rz = 2.0f * (qx * qz - qw * qy);
                     const float half = (g_sentIpd > 0.0f ? g_sentIpd : 0.063f) * 0.5f * (eye == 0 ? -1.0f : 1.0f);
                     layerPose[eye].position = {rpPos[0] + rx * half, rpPos[1] + ry * half + kStampYM, rpPos[2] + rz * half};
-                    if (kStampPosLive) layerPose[eye].position = views[eye].pose.position;
+                    // With depth chained the compositor warps translation itself, per pixel, so it needs the honest
+                    // rendered position; the displayed-position trick is only for the depth-less warp.
+                    if (kStampPosLive && !depthFresh) layerPose[eye].position = views[eye].pose.position;
                     layerPose[eye].orientation = {rpOri[0], rpOri[1], rpOri[2], rpOri[3]};
                 } else {
                     layerPose[eye] = views[eye].pose;
@@ -2098,6 +2260,26 @@ static void RenderFrame(App& app)
                     projViews[eye].subImage.imageRect.extent = {(int32_t)sc.width, (int32_t)sc.height};
                     projViews[eye].subImage.imageArrayIndex = 0;
                 }
+                if (depthFresh && cmdOpen && acquired[0] && acquired[1]) {
+                    bool all = true;
+                    for (uint32_t eye = 0; eye < VIEW_COUNT; eye++) {
+                        depthAcquired[eye] = AcquireDepthGrid(app, eye, app.frameCmd[app.frameSlot], depthQ[eye], depthQNear[eye]);
+                        all = all && depthAcquired[eye];
+                    }
+                    if (all) {
+                        for (uint32_t eye = 0; eye < VIEW_COUNT; eye++) {
+                            const Swapchain& d = app.depthSwapchains[eye];
+                            depthInfo[eye].subImage.swapchain = d.handle;
+                            depthInfo[eye].subImage.imageRect.offset = {0, 0};
+                            depthInfo[eye].subImage.imageRect.extent = {(int32_t)d.width, (int32_t)d.height};
+                            depthInfo[eye].subImage.imageArrayIndex = 0;
+                            depthInfo[eye].minDepth = 0.0f; depthInfo[eye].maxDepth = 1.0f;
+                            depthInfo[eye].nearZ = kDepthNear; depthInfo[eye].farZ = kDepthFar;
+                            projViews[eye].next = &depthInfo[eye];
+                        }
+                        depthChained = true;
+                    }
+                }
                 // One submission for the upload and both eyes, then hand the images to the
                 // runtime without waiting for the GPU (it synchronises on our queue).
                 if (cmdOpen) { EndFrameCommands(app); cmdOpen = false; }
@@ -2107,6 +2289,11 @@ static void RenderFrame(App& app)
                     XrSwapchainImageReleaseInfo ri = {XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
                     xrReleaseSwapchainImage(app.swapchains[eye].handle, &ri);
                 }
+                for (uint32_t eye = 0; eye < VIEW_COUNT; eye++) {
+                    if (!depthAcquired[eye]) continue;
+                    XrSwapchainImageReleaseInfo ri = {XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+                    xrReleaseSwapchainImage(app.depthSwapchains[eye].handle, &ri);
+                }
                 {
                     double ms = MsSince(compositorT0);
                     g_rt.eyes += ms; if (ms > g_rt.eyesMax) g_rt.eyesMax = ms;
@@ -2174,6 +2361,10 @@ static void RenderFrame(App& app)
     if (XR_FAILED(endRes)) {   // review 2026-10-21 (M3): a failed EndFrame is a vanished picture, so say so
