diff --git a/clients/steam-frame/tests/test_client_state.cpp b/clients/steam-frame/tests/test_client_state.cpp
new file mode 100644
index 0000000..16c0732
--- /dev/null
+++ b/clients/steam-frame/tests/test_client_state.cpp
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: BSL-1.0
+// Review 2026-10-21 close-out (patch 0016): the stream-mode decoder's state machine and the runtime-dir paths.
+//   - OpenStream refuses H.264 (M7)
+//   - the test clip, fed NAL by NAL as the network path does, decodes in stream mode
+//   - PeekLatestPts names the frame TakeLatest hands out next (M8)
+//   - ReconfigureStream / ResetStreamState forget the access unit and the ready frames, and decoding resumes (M5)
+//   - live-tuning files come from the runtime dir, never through a symlink; dumps never write through one (M11)
+#include "test_util.h"
+#include "video_decoder.h"
+#include "runtime_paths.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef TEST_ASSET_DIR
+#define TEST_ASSET_DIR "assets"
+#endif
+
+// Split an Annex-B elementary stream into NAL units, each with its own start code (as the server sends them).
+static std::vector<std::vector<uint8_t>> splitNals(const std::vector<uint8_t>& es)
+{
+    std::vector<size_t> starts;
+    for (size_t i = 0; i + 3 < es.size(); i++) {
+        if (es[i] == 0 && es[i + 1] == 0 && es[i + 2] == 1) { starts.push_back(i >= 1 && es[i - 1] == 0 ? i - 1 : i); i += 2; }
+    }
+    std::vector<std::vector<uint8_t>> nals;
+    for (size_t k = 0; k < starts.size(); k++) {
+        const size_t end = k + 1 < starts.size() ? starts[k + 1] : es.size();
+        nals.emplace_back(es.begin() + starts[k], es.begin() + end);
+    }
+    return nals;
+}
+
+static int hevcNalType(const std::vector<uint8_t>& nal)
+{
+    size_t sc = (nal.size() >= 4 && nal[2] == 0) ? 4 : 3;
+    return nal.size() > sc ? (nal[sc] >> 1) & 0x3f : -1;
+}
+
+// Feed NALs from `from`; returns the index after the n-th slice fed (each slice completes an access unit).
+static size_t feedFrames(VideoDecoder& dec, const std::vector<std::vector<uint8_t>>& nals, size_t from, int frames, int64_t& pts)
+{
+    int slices = 0;
+    size_t i = from;
+    for (; i < nals.size() && slices < frames; i++) {
+        dec.SubmitNal(nals[i].data(), nals[i].size(), pts);
+        if (hevcNalType(nals[i]) < 32) { slices++; pts += 13889; }
+    }
+    return i;
+}
+
+static void test_stream_decoder_state()
+{
+    SECTION("video_decoder: stream mode refuses H.264 (review M7)");
+    {
+        VideoDecoder h264;
+        CHECK(!h264.OpenStream(VideoDecoder::Codec::H264));
+    }
+
+    SECTION("video_decoder: stream mode decodes the clip NAL by NAL; peek == take; reconfigure resets (M5, M8)");
+    std::ifstream f(std::string(TEST_ASSET_DIR) + "/stereo_test.hevc", std::ios::binary);
+    std::vector<uint8_t> es((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    CHECK(es.size() > 1000);
+    const auto nals = splitNals(es);
+    CHECK(nals.size() > 20);
+    int paramSets = 0; for (const auto& n : nals) if (hevcNalType(n) >= 32) paramSets++;
+    CHECK(paramSets >= 3);   // VPS, SPS, PPS at least
+
+    setenv("FRAME_CLIENT_DECODE_POLL_MS", "0", 0);   // the software decoder needs no poll; keep the test quick
+    VideoDecoder dec;
+    CHECK(dec.OpenStream(VideoDecoder::Codec::H265));
+    CHECK(dec.QueueDepth() == 2);
+
+    // Feed until frames come out (x265 reorders, so a few access units go in before the first comes out).
+    int64_t pts = 1000000;
+    size_t at = 0;
+    std::vector<uint8_t> buf; int w = 0, h = 0; VideoDecoder::PixelLayout pl = VideoDecoder::PixelLayout::RGBA;
+    int64_t peekPts = -1, takePts = -1;
+    bool peeked = false, taken = false;
+    for (int round = 0; round < 12 && !taken; round++) {
+        at = feedFrames(dec, nals, at, 2, pts);
+        peeked = dec.PeekLatestPts(&peekPts);
+        if (peeked) { VideoDecoder::FrameTiming t; taken = dec.TakeLatest(buf, w, h, pl, &takePts, &t); }
+    }
+    CHECK(taken);
+    CHECK(peeked && peekPts == takePts);   // M8: the peek names the frame the take returns
+    CHECK(w == 1920 && h == 1080);
+    CHECK(pl == VideoDecoder::PixelLayout::NV12);
+    CHECK(buf.size() == (size_t)w * h * 3 / 2);
+
+    // Fill the ring past the queue depth without taking: the peek must still agree with the take (after catch-up).
+    at = feedFrames(dec, nals, at, 6, pts);
+    peeked = dec.PeekLatestPts(&peekPts);
+    VideoDecoder::FrameTiming t2;
+    taken = dec.TakeLatest(buf, w, h, pl, &takePts, &t2);
+    CHECK(peeked && taken && peekPts == takePts);
+    CHECK(t2.alphaKnown && !t2.alphaBlend);   // the submit record was found; this clip is opaque
+
+    // A lone parameter set waits for its slice in the access unit...
+    size_t vps = 0; while (vps < nals.size() && hevcNalType(nals[vps]) < 32) vps++;
+    dec.SubmitNal(nals[vps].data(), nals[vps].size(), pts);
+    CHECK(dec.PendingAccessUnitBytes() > 0);
+    // ...and a reconfigure forgets it along with the ready frames (M5).
+    CHECK(dec.ReconfigureStream(1920, 1080));
+    CHECK(dec.PendingAccessUnitBytes() == 0);
+    CHECK(!dec.PeekLatestPts(&peekPts));
+    CHECK(!dec.TakeLatest(buf, w, h, pl, &takePts, nullptr));
+    // The reopened decoder decodes from the start of the stream (parameter sets + IDR) again.
+    pts = 5000000; at = 0; taken = false;
+    for (int round = 0; round < 12 && !taken; round++) {
+        at = feedFrames(dec, nals, at, 2, pts);
+        taken = dec.TakeLatest(buf, w, h, pl, &takePts, nullptr);
+    }
+    CHECK(taken);
+    CHECK(takePts >= 5000000);   // no pts from before the reset leaks out
+    // ResetStreamState alone (the reconnect path) clears the ready frames too.
+    at = feedFrames(dec, nals, at, 4, pts);
+    dec.ResetStreamState();
+    CHECK(!dec.TakeLatest(buf, w, h, pl, &takePts, nullptr));
+    CHECK(dec.PendingAccessUnitBytes() == 0);
+    dec.Close();
+}
+
+static bool isSymlink(const std::string& p) { struct stat st; return lstat(p.c_str(), &st) == 0 && S_ISLNK(st.st_mode); }
+static bool isRegular(const std::string& p) { struct stat st; return lstat(p.c_str(), &st) == 0 && S_ISREG(st.st_mode); }
+static std::string slurp(const std::string& p) { std::ifstream f(p); return std::string((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>()); }
+
+static void test_runtime_paths()
+{
+    SECTION("runtime_paths: tuning files from the runtime dir, no symlinks; dumps never through a symlink (review M11)");
+    char tmpl[] = "/tmp/frame-client-test-XXXXXX";
+    char* dir = mkdtemp(tmpl);
+    CHECK(dir != nullptr);
+    if (!dir) return;
+    const std::string d = dir;
+    setenv("XDG_RUNTIME_DIR", dir, 1);
+    CHECK(frame_paths::RuntimeDir() == d);
+    CHECK(frame_paths::TuningPath("frame-predict-ms") == d + "/frame-predict-ms");
+    CHECK(frame_paths::DumpPath("frame-dump.bin") == d + "/frame-dump.bin");
+
+    // A tuning file in the runtime dir is read.
+    { std::ofstream o(d + "/frame-predict-ms"); o << "33.5\n"; }
+    FILE* tf = frame_paths::OpenTuning("frame-predict-ms");
+    CHECK(tf != nullptr);
+    if (tf) { float v = 0; CHECK(fscanf(tf, "%f", &v) == 1 && v > 33.4f && v < 33.6f); fclose(tf); }
+    // A symlink under the name is not followed.
+    { std::ofstream o(d + "/target"); o << "99\n"; }
+    CHECK(symlink((d + "/target").c_str(), (d + "/frame-stamp-lead-ms").c_str()) == 0);
+    CHECK(frame_paths::OpenTuning("frame-stamp-lead-ms") == nullptr);
+    // Absent in the runtime dir: our own /dev/shm file is the fallback (the frame-stream tooling's path).
+    const std::string shmName = "frame-client-test-" + std::to_string((long)getpid());
+    const std::string shmPath = "/dev/shm/" + shmName;
+    { std::ofstream o(shmPath); o << "off\n"; }
+    FILE* sf = frame_paths::OpenTuning(shmName.c_str());
+    CHECK(sf != nullptr);
+    if (sf) { char line[16] = {0}; CHECK(fgets(line, sizeof line, sf) && strncmp(line, "off", 3) == 0); fclose(sf); }
+    unlink(shmPath.c_str());
+    CHECK(frame_paths::OpenTuning(shmName.c_str()) == nullptr);
+
+    // A dump at a name that is a symlink: the link goes, a fresh regular file takes its place, the target is untouched.
+    const std::string dumpLink = d + "/frame_client_eye0.rgba";
+    CHECK(symlink((d + "/target").c_str(), dumpLink.c_str()) == 0);
+    CHECK(isSymlink(dumpLink));
+    FILE* df = frame_paths::CreateDump(dumpLink);
+    CHECK(df != nullptr);
+    if (df) { fputs("dump", df); fclose(df); }
+    CHECK(isRegular(dumpLink) && !isSymlink(dumpLink));
+    CHECK(slurp(d + "/target") == "99\n");
+    CHECK(slurp(dumpLink) == "dump");
+    struct stat st; CHECK(stat(dumpLink.c_str(), &st) == 0 && (st.st_mode & 0777) == 0600);
+    // A second dump at the same name replaces it (a stale dump is not an obstacle).
+    df = frame_paths::CreateDump(dumpLink);
+    CHECK(df != nullptr);
+    if (df) { fputs("again", df); fclose(df); }
+    CHECK(slurp(dumpLink) == "again");
+
+    unlink((d + "/frame-predict-ms").c_str()); unlink((d + "/frame-stamp-lead-ms").c_str());
+    unlink((d + "/target").c_str()); unlink(dumpLink.c_str()); rmdir(dir);
+    unsetenv("XDG_RUNTIME_DIR");
+}
+
+void test_client_state()
+{
+    test_stream_decoder_state();
+    test_runtime_paths();
+}
