diff --git a/clients/steam-frame/src/runtime_paths.h b/clients/steam-frame/src/runtime_paths.h
new file mode 100644
index 0000000..967a1c0
--- /dev/null
+++ b/clients/steam-frame/src/runtime_paths.h
@@ -0,0 +1,75 @@
+// Frame VR client — where the live-tuning files and the debug dumps live
+// SPDX-License-Identifier: BSL-1.0
+//
+// Review 2026-10-21 (M11): the live-tuning files (frame-predict-ms, frame-passthrough, frame-stamp-lead-ms) sat in
+// world-writable /dev/shm, so any local user could steer the wearer's prediction horizon, stamp lead and passthrough
+// geometry, and the debug dumps were fopen("wb") on fixed /tmp names, which write through a planted symlink. Both now
+// live in the per-user runtime directory ($XDG_RUNTIME_DIR, else /run/user/<uid>; mode 0700). The old /dev/shm name is
+// still read as a fallback, but only when that file is a regular file owned by this user, so the frame-stream tooling
+// that writes it over ssh keeps working and nobody else's file is honoured.
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace frame_paths {
+
+// $XDG_RUNTIME_DIR, else /run/user/<uid> when it exists, else "" (the callers fall back to /dev/shm or /tmp).
+inline std::string RuntimeDir()
+{
+    if (const char* x = getenv("XDG_RUNTIME_DIR")) if (*x) return x;
+    const std::string p = "/run/user/" + std::to_string((unsigned long)getuid());
+    struct stat st;
+    if (stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) return p;
+    return "";
+}
+
+// Where a live-tuning file called `name` is looked for first (where the tooling should write it).
+inline std::string TuningPath(const char* name)
+{
+    const std::string dir = RuntimeDir();
+    return (dir.empty() ? std::string("/dev/shm") : dir) + "/" + name;
+}
+
+// Open a live-tuning file for reading: <runtime dir>/<name>, else /dev/shm/<name>. Regular files owned by this user
+// only (O_NOFOLLOW + fstat), so a symlink or another user's file under either name is ignored. nullptr when absent.
+inline FILE* OpenTuning(const char* name)
+{
+    const std::string candidates[2] = {TuningPath(name), std::string("/dev/shm/") + name};
+    for (int i = 0; i < 2; i++) {
+        if (i == 1 && candidates[1] == candidates[0]) break;
+        const int fd = open(candidates[i].c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+        if (fd < 0) continue;
+        struct stat st;
+        if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_uid != getuid()) { close(fd); continue; }
+        FILE* f = fdopen(fd, "r");
+        if (!f) close(fd);
+        return f;
+    }
+    return nullptr;
+}
+
+// Where a debug dump called `name` goes: the runtime directory, else /tmp.
+inline std::string DumpPath(const char* name)
+{
+    const std::string dir = RuntimeDir();
+    return (dir.empty() ? std::string("/tmp") : dir) + "/" + name;
+}
+
+// Create a dump file for writing at an explicit path: whatever carried the name is unlinked (a stale dump, or a
+// planted symlink - never written through), then a fresh regular file is created O_EXCL | O_NOFOLLOW, mode 0600.
+// nullptr with errno set when it cannot be created.
+inline FILE* CreateDump(const std::string& path)
+{
+    unlink(path.c_str());
+    const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd < 0) return nullptr;
+    FILE* f = fdopen(fd, "wb");
+    if (!f) close(fd);
+    return f;
+}
+
+} // namespace frame_paths
