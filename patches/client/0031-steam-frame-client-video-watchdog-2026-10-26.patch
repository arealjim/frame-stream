@@ -37,6 +37,8 @@
 #include <string>
 #include <vector>
 #include <thread>
+#include <atomic>
+#include <memory>
 #include <unistd.h>
 
 #define LOG_INFO(fmt, ...) fprintf(stderr, "[INFO] " fmt "\n", ##__VA_ARGS__)
@@ -2297,6 +2299,27 @@ int main(int argc, char** argv)
     // by hand. frame-stream down stops it at any point.
     const double kReconnectS = getenv("FRAME_CLIENT_RECONNECT_S") ? atof(getenv("FRAME_CLIENT_RECONNECT_S")) : 5.0;
     constexpr double kReconnectGiveUpS = 600.0;
+    // Video watchdog (frame-lab C10, 2026-10-26): about 4 starts in 11 froze on the first frame - the receive thread
+    // stopped reading while the server sent at full rate. FRAME_CLIENT_VIDEO_STALL_S seconds (default 2; 0 = off) with
+    // no access unit and datagrams unread in the video socket reconnect (StreamConnection::VideoStalled). Disconnect
+    // joins the receive thread, which may be the stuck one, so a deadman exits with status 4 when it has not returned
+    // in 2.5 s (discovery's 1 s receive timeout bounds a healthy one); a second stall within 15 s of a stall reconnect
+    // exits 4 too, for a fresh decoder. The launcher's unit restarts the client on status 4 and on no other.
+    const double kStallS = getenv("FRAME_CLIENT_VIDEO_STALL_S") ? atof(getenv("FRAME_CLIENT_VIDEO_STALL_S")) : 2.0;
+    static constexpr int kStuckExit = 4;
+    std::chrono::steady_clock::time_point lastStallAt{};
+    auto disconnectOrExit = [](const char* why) {
+        auto done = std::make_shared<std::atomic<bool>>(false);
+        std::thread([done, why] {
+            std::this_thread::sleep_for(std::chrono::milliseconds(2500));
+            if (done->load()) return;
+            LOG_ERROR("disconnect after %s did not return in 2.5 s: the receive thread is stuck; exiting with status %d for a restart", why, kStuckExit);
+            fflush(stdout); fflush(stderr); _exit(kStuckExit);
+        }).detach();
+        g_stream.Disconnect();
+        done->store(true);
+    };
+    if (g_streamMode) LOG_INFO("video watchdog: %s", kStallS > 0 ? "on - reconnect after FRAME_CLIENT_VIDEO_STALL_S with no video and data unread, exit 4 if stuck" : "off (FRAME_CLIENT_VIDEO_STALL_S=0)");
     if (g_streamMode) LOG_INFO("reconnect: %s", kReconnectS > 0 ? "on - when the server announces again, the link closes, or no first video arrives (FRAME_CLIENT_RECONNECT_S)" : "off (FRAME_CLIENT_RECONNECT_S=0)");
     std::chrono::steady_clock::time_point searchingSince{};
     uint32_t reconnects = 0;
@@ -2314,7 +2337,18 @@ int main(int argc, char** argv)
         if (exitAsked && std::chrono::steady_clock::now() - exitAskedAt > std::chrono::seconds(3)) { LOG_INFO("no EXITING within 3 s; leaving the loop"); break; }
         if (g_streamMode && kReconnectS > 0 && !exitAsked) {
             const char* why = nullptr;
-            if (!g_stream.Reconnecting() && g_stream.Lost(kReconnectS, &why)) {
+            std::string stall;
+            if (!g_stream.Reconnecting() && g_stream.VideoStalled(kStallS, &stall)) {
+                const bool again = lastStallAt.time_since_epoch().count() != 0 && MsSince(lastStallAt) < 15000.0;
+                LOG_ERROR("video stalled: %s; %s (reconnect %u)", stall.c_str(),
+                          again ? "the second stall within 15 s: exiting with status 4 for a fresh decoder" : "looking for the server again", ++reconnects);
+                if (again) { fflush(stdout); fflush(stderr); _exit(kStuckExit); }
+                lastStallAt = std::chrono::steady_clock::now();
+                disconnectOrExit("a video stall");
+                searchingSince = std::chrono::steady_clock::now();
+                g_poseEpoch++;
+                if (!g_stream.StartReconnect(&g_decoder)) LOG_ERROR("could not restart discovery; staying disconnected on the last frame");
+            } else if (!g_stream.Reconnecting() && g_stream.Lost(kReconnectS, &why)) {
                 LOG_ERROR("stream lost: %s; looking for the server again (reconnect %u)", why ? why : "?", ++reconnects);
                 g_stream.Disconnect();
                 searchingSince = std::chrono::steady_clock::now();
