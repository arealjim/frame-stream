+++ b/clients/steam-frame/src/stream_connection.cpp
@@ -148,6 +148,25 @@ bool StreamConnection::Lost(double firstVideoS, const char** reason) const
     return false;
 }
 
+bool StreamConnection::VideoStalled(double stallS, std::string* detail) const
+{
+    if (stallS <= 0.0 || !connected_.load() || !net_) return false;
+    const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    const int64_t lastFrame = net_->GetLastCompletedFrameReceiveTimeNs();
+    if (lastFrame <= connectedAtNs_.load() || now - lastFrame < (int64_t)(stallS * 1e9)) return false;
+    const int unread = net_->PendingVideoBytes();
+    if (unread <= 0) return false;
+    if (detail) {
+        const int64_t loop = net_->GetReceiveLoopNs();
+        char b[200];
+        snprintf(b, sizeof(b), "no access unit for %.1f s with %d bytes unread in the video socket; receive loop last ran %s",
+                 (now - lastFrame) / 1e9, unread, loop ? (std::to_string((now - loop) / 1000000) + " ms ago").c_str() : "never");
+        *detail = b;
+    }
+    return true;
+}
+
 bool StreamConnection::WireUp(protocol::ServerAnnounce srv, const char* ip, VideoDecoder* decoder)
 {
     srv.serverName[sizeof(srv.serverName) - 1] = 0;   // review L4: printed with %s below; the wire need not terminate it
