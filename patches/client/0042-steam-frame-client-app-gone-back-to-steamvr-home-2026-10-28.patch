         if (exitAsked && std::chrono::steady_clock::now() - exitAskedAt > std::chrono::seconds(3)) { LOG_INFO("no EXITING within 3 s; leaving the loop"); break; }
+        if (g_streamMode && g_running && !exitAsked) {
+            // The marker also comes from xrEndSession, and an app may end one session and begin another: look for
