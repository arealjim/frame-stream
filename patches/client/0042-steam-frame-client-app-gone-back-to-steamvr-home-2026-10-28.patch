diff --git a/clients/steam-frame/src/stream_connection.cpp b/clients/steam-frame/src/stream_connection.cpp
index 4fd6954..7996461 100644
--- a/clients/steam-frame/src/stream_connection.cpp
+++ b/clients/steam-frame/src/stream_connection.cpp
@@ -148,6 +148,21 @@ bool StreamConnection::Lost(double firstVideoS, const char** reason) const
     return false;
 }
 
+bool StreamConnection::AppGone(double idleS, const char** reason) const
+{
+    if (!connected_.load() || !net_) return false;
+    if (net_->StreamEnded()) { if (reason) *reason = "the server says the app quit"; return true; }
+    if (idleS <= 0.0) return false;
+    const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    const int64_t lastFrame = net_->GetLastCompletedFrameReceiveTimeNs();
+    if (lastFrame <= connectedAtNs_.load() || now - lastFrame < (int64_t)(idleS * 1e9)) return false;
+    if (reason) *reason = "no video since the app's last frame for FRAME_CLIENT_APP_GONE_S (the app stopped or crashed)";
+    return true;
+}
+
+bool StreamConnection::Ended() const { return connected_.load() && net_ && net_->StreamEnded(); }
+
 bool StreamConnection::VideoStalled(double stallS, std::string* detail) const
 {
     if (stallS <= 0.0 || !connected_.load() || !net_) return false;
