@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: BSL-1.0
+// CPU mirror of yuvToRgb709() in shaders/sample.frag — BT.709, limited (video) range,
+// 8-bit NV12 in, 8-bit RGB out. Keep the constants identical to the shader's.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+struct Rgb8 { uint8_t r, g, b; };
+
+inline Rgb8 yuvToRgb709(uint8_t y8, uint8_t cb8, uint8_t cr8)
+{
+    const float y  = y8 / 255.0f, cb = cb8 / 255.0f, cr = cr8 / 255.0f;
+    const float yl = (y  - 16.0f / 255.0f) * (255.0f / 219.0f);
+    const float b  = (cb - 128.0f / 255.0f) * (255.0f / 224.0f);
+    const float r  = (cr - 128.0f / 255.0f) * (255.0f / 224.0f);
+    auto to8 = [](float v) {
+        return (uint8_t)std::clamp((int)(std::clamp(v, 0.0f, 1.0f) * 255.0f + 0.5f), 0, 255);
+    };
+    return { to8(yl + 1.5748f * r), to8(yl - 0.18733f * b - 0.46813f * r), to8(yl + 1.8556f * b) };
+}
