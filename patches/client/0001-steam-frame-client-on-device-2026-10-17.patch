Subject: [PATCH 13/21] steam-frame client: send the head velocity
 (XrSpaceVelocity) in every tracking packet

The server predicts the head pose by its measured horizon only from the packet velocity fields, and the client
never filled them: worn 2026-10-18 the Mac logged head_ang_vel=no lin_speed=0.000 for a moving head, so the scene
was rendered at the sampled pose with no prediction, 34 ms behind the compositor overlays in translation. Logs the
validity flags whenever they change.
---
 clients/steam-frame/src/main.cpp | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/clients/steam-frame/src/main.cpp b/clients/steam-frame/src/main.cpp
index 927e301..fd00100 100644
--- a/clients/steam-frame/src/main.cpp
+++ b/clients/steam-frame/src/main.cpp
@@ -1181,12 +1181,34 @@ static void FillHeadTracking(App& app, XrTime t, const XrView* views,
     // applies its own IPD to derive the stereo pair, so a half-IPD
     // offset here would skew what it renders. Fall back to view[0].
     XrPosef head = views[0].pose;
-    XrSpaceLocation hl = {XR_TYPE_SPACE_LOCATION};
+    // Head velocity (stage space) rides along: the server predicts the pose by its measured
+    // horizon ONLY from these fields, and they were never filled (worn 2026-10-18 the Mac read
+    // head_ang_vel=no lin_speed=0.000 for a moving head: no prediction at all, the scene 34 ms
+    // behind the compositor's overlays in translation = "extra parallax when I move").
+    XrSpaceVelocity hv = {XR_TYPE_SPACE_VELOCITY};
+    XrSpaceLocation hl = {XR_TYPE_SPACE_LOCATION, &hv};
     if (app.viewSpace &&
         XR_SUCCEEDED(xrLocateSpace(app.viewSpace, app.stageSpace, t, &hl)) &&
         (hl.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) &&
         (hl.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT)) {
         head = hl.pose;
+        if (hv.velocityFlags & XR_SPACE_VELOCITY_LINEAR_VALID_BIT) {
+            pkt.headLinearVelocity[0] = hv.linearVelocity.x;
+            pkt.headLinearVelocity[1] = hv.linearVelocity.y;
+            pkt.headLinearVelocity[2] = hv.linearVelocity.z;
+        }
+        if (hv.velocityFlags & XR_SPACE_VELOCITY_ANGULAR_VALID_BIT) {
+            pkt.headAngularVelocity[0] = hv.angularVelocity.x;
+            pkt.headAngularVelocity[1] = hv.angularVelocity.y;
+            pkt.headAngularVelocity[2] = hv.angularVelocity.z;
+        }
+        static uint64_t velFlagsSeen = ~0ull;
+        if (hv.velocityFlags != velFlagsSeen) {
+            velFlagsSeen = hv.velocityFlags;
+            LOG_INFO("head velocity from the runtime: linear=%s angular=%s",
+                     (hv.velocityFlags & XR_SPACE_VELOCITY_LINEAR_VALID_BIT) ? "valid" : "none",
+                     (hv.velocityFlags & XR_SPACE_VELOCITY_ANGULAR_VALID_BIT) ? "valid" : "none");
+        }
     }
     pkt.headPosition[0] = head.position.x;
     pkt.headPosition[1] = head.position.y;
