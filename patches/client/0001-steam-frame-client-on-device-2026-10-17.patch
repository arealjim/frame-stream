From 463315a3998cfb23316910ca7d270408b4851ef9 Mon Sep 17 00:00:00 2001
From: arealjim <6187715+arealjim@users.noreply.github.com>
Date: Sat, 17 Oct 2026 16:26:33 +0000
Subject: [PATCH 03/21] steam-frame client: resend ClientConnect until the
 first video packet arrives

ClientConnect is one UDP datagram and the server only starts encoding once it
arrives, so one lost packet meant no session at all while the server kept
answering discovery (seen 2026-10-17 over a tailnet). Resend until the first
video packet or render pose is in: first retry at 500 ms (measured send to
first decoded frame is about 220 ms), then +250 ms per try, 5 sends, then a
clear error. The arrival check runs right before each send because the server
rebuilds its encoder on every ClientConnect it receives.

FRAME_CLIENT_TEST_DROP_CONNECT=<n> swallows the first n sends so the resend
path can be exercised on a real link. Tested on the Frame: n=1 recovers at
500 ms (answered after 2 sends), n=5 ends in the error after 5 sends.

---
 clients/steam-frame/src/stream_connection.cpp | 57 ++++++++++++++++++-
 clients/steam-frame/src/stream_connection.h   | 11 +++-
 2 files changed, 66 insertions(+), 2 deletions(-)

diff --git a/clients/steam-frame/src/stream_connection.cpp b/clients/steam-frame/src/stream_connection.cpp
index 56a6c2e..fbb3900 100644
--- a/clients/steam-frame/src/stream_connection.cpp
+++ b/clients/steam-frame/src/stream_connection.cpp
@@ -15,6 +15,7 @@
 #include <atomic>
 #include <chrono>
 #include <cstdio>
+#include <cstdlib>
 #include <cstring>
 #include <thread>
 
@@ -28,8 +29,24 @@ StreamConnection::StreamConnection()
 
 StreamConnection::~StreamConnection() { Disconnect(); delete net_; delete tracker_; }
 
+bool StreamConnection::SendClientConnect(const protocol::ClientConnect& cc, int attempt)
+{
+    if (testDropConnects_ > 0) {
+        testDropConnects_--;
+        LOG_INF("ClientConnect send %d swallowed (FRAME_CLIENT_TEST_DROP_CONNECT)", attempt);
+        return true;
+    }
+    if (send(controlSocket_, &cc, sizeof(cc), 0) < 0) {
+        LOG_ERR("ClientConnect send %d failed", attempt);
+        return false;
+    }
+    return true;
+}
+
 bool StreamConnection::Connect(VideoDecoder* decoder, int timeoutMs)
 {
+    if (connectRetry_.joinable()) { stopRetry_ = true; connectRetry_.join(); }
+    if (const char* s = getenv("FRAME_CLIENT_TEST_DROP_CONNECT")) testDropConnects_ = atoi(s);
     std::atomic<bool> found{false};
     protocol::ServerAnnounce srv{};
     char ip[64] = {};
@@ -130,10 +147,46 @@ bool StreamConnection::Connect(VideoDecoder* decoder, int timeoutMs)
                             protocol::CLIENT_CAPABILITY_FOVEATION_CENTER |
                             protocol::CLIENT_CAPABILITY_FEC_INTERLEAVED;
     strncpy(cc.deviceName, "FrameClient", sizeof(cc.deviceName) - 1);
-    if (send(controlSocket_, &cc, sizeof(cc), 0) < 0) { LOG_ERR("ClientConnect send failed"); return false; }
+    if (!SendClientConnect(cc, 1)) return false;
 
     LOG_INF("connected — ClientConnect sent, receiving video");
     connected_ = true;
+
+    // ClientConnect is a single UDP datagram and the server only starts encoding once it
+    // arrives, so one lost packet meant no session at all: the server kept answering discovery
+    // while the client sat forever with no video (seen 2026-10-17 over a tailnet). Resend until
+    // the first video packet or render pose is in, up to kConnectSends. The server rebuilds its
+    // encoder on EVERY ClientConnect it receives, so a resend that lands after it already
+    // answered costs a glitch: the arrival check runs right before each send, the first resend
+    // waits 500 ms (measured send -> first decoded frame: ~220 ms) and later ones back off.
+    stopRetry_ = false;
+    connectRetry_ = std::thread([this, cc] {
+        constexpr int kConnectSends = 5;
+        int waitMs = 500;
+        int sends = 1;
+        auto answered = [this] {
+            return net_->GetPacketsReceived() > 0 || net_->GetLatestRenderPose().valid;
+        };
+        while (true) {
+            for (int slept = 0; slept < waitMs && !stopRetry_; slept += 20)
+                std::this_thread::sleep_for(std::chrono::milliseconds(20));
+            if (stopRetry_) return;
+            if (answered()) {
+                LOG_INF("ClientConnect answered after %d send%s (%u video packets in)", sends,
+                        sends == 1 ? "" : "s", net_->GetPacketsReceived());
+                return;
+            }
+            if (sends >= kConnectSends) {
+                LOG_ERR("no video after %d ClientConnect sends; the server is not answering "
+                        "this client", sends);
+                return;
+            }
+            LOG_INF("no video %d ms after ClientConnect send %d; resending (%d/%d)", waitMs,
+                    sends, sends + 1, kConnectSends);
+            SendClientConnect(cc, ++sends);
+            waitMs += 250;
+        }
+    });
     return true;
 }
 
@@ -231,6 +284,8 @@ void StreamConnection::SendKeyframeRequest(uint32_t reasonFlags, uint32_t detail
 void StreamConnection::Disconnect()
 {
     connected_ = false;
+    stopRetry_ = true;
+    if (connectRetry_.joinable()) connectRetry_.join();
     if (net_) net_->Stop();
     if (tracker_) tracker_->Disconnect();
     if (controlSocket_ >= 0) { close(controlSocket_); controlSocket_ = -1; }
