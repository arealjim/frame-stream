+void NetworkReceiver::PunchVideoPath()
+{
+    if (!haveVideoServer_ || videoSocket_ < 0)
+    {
+        return;
+    }
+    const int64_t now = SteadyClockNowNs();
+    constexpr int64_t kPunchIntervalNs = 5LL * 1000 * 1000 * 1000;
+    if (lastPunchNs_ != 0 && now - lastPunchNs_ < kPunchIntervalNs)
+    {
+        return;
+    }
+    lastPunchNs_ = now;
+    const uint8_t punch = 0;  // content is irrelevant; the server never reads its video socket
+    sendto(videoSocket_, &punch, sizeof(punch), 0, (const sockaddr*)&videoServer_,
+           sizeof(videoServer_));
+    if (packetsReceived_.load() == 0)
+    {
+        LOGI("Video path: punched %s:%u from the video socket", inet_ntoa(videoServer_.sin_addr),
+             (unsigned)ntohs(videoServer_.sin_port));
+    }
+}
