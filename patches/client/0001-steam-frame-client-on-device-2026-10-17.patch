+bool VideoDecoder::PackPlanesToNv12(const uint8_t* const* data, const int* linesize, int avPixFmt,
+                                    int width, int height, std::vector<uint8_t>& out)
+{
+    if (width <= 0 || height <= 0) return false;
+    const int cw = (width + 1) / 2, ch = (height + 1) / 2;
+    const size_t lumaBytes = (size_t)width * height;
+    const size_t chromaRow = (size_t)cw * 2;
+    if (avPixFmt == AV_PIX_FMT_NV12) {
+        out.resize(lumaBytes + chromaRow * ch);
+        uint8_t* dst = out.data();
+        for (int r = 0; r < height; r++, dst += width) memcpy(dst, data[0] + (size_t)r * linesize[0], width);
+        for (int r = 0; r < ch; r++, dst += chromaRow) memcpy(dst, data[1] + (size_t)r * linesize[1], chromaRow);
+        return true;
+    }
+    if (avPixFmt == AV_PIX_FMT_YUV420P) {
+        out.resize(lumaBytes + chromaRow * ch);
+        uint8_t* dst = out.data();
+        for (int r = 0; r < height; r++, dst += width) memcpy(dst, data[0] + (size_t)r * linesize[0], width);
+        for (int r = 0; r < ch; r++) {
+            const uint8_t* u = data[1] + (size_t)r * linesize[1];
+            const uint8_t* v = data[2] + (size_t)r * linesize[2];
+            for (int c = 0; c < cw; c++) { *dst++ = u[c]; *dst++ = v[c]; }
+        }
+        return true;
+    }
+    return false;
+}
