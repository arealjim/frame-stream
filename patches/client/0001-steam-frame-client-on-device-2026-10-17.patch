 void VideoDecoder::SubmitNal(const uint8_t* data, size_t size, int64_t ptsUs)
+{
+    const auto t0 = std::chrono::steady_clock::now();
+    const uint64_t framesBefore = decodedFrames_;
+    submitNalImpl(data, size, ptsUs);
+    const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    decodeMsSum_ += ms;
+    if (ms > decodeMsMax_) decodeMsMax_ = ms;
+    if (++decodeCalls_ % 300 == 0) {
+        LOG_INF("decode: %u NALs avg %.2f ms max %.2f ms, %llu frames out (last 300: %llu)",
+                (unsigned)decodeCalls_, decodeMsSum_ / 300.0, decodeMsMax_,
+                (unsigned long long)decodedFrames_,
+                (unsigned long long)(decodedFrames_ - decodedFramesAtLog_));
+        decodeMsSum_ = 0; decodeMsMax_ = 0; decodedFramesAtLog_ = decodedFrames_;
+    }
+    (void)framesBefore;
+}
