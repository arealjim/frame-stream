From db754dd80fa1eee569ddf98b7c4f3741d43e9cb8 Mon Sep 17 00:00:00 2001
From: arealjim <6187715+arealjim@users.noreply.github.com>
Date: Mon, 19 Oct 2026 11:49:26 +0000
Subject: [PATCH 21/21] steam-frame client: send the real IPD upstream (the
 server rendered 63 mm for every wear)

The server derives both eyes from the head pose with its own separation and the
TrackingPacket ipd field was never filled, so every wear rendered at the runtime
default of 63.0 mm ("InputManager: Using default FOV/IPD"). Worn, 2026-10-19: the
streamed world moves more with real head translation than the WayVR keyboard and the
difference persists, which is stereo depth from a wrong separation against parallax
from the true one. The separation of the two xrLocateViews poses is sent when it is
plausible (45 to 85 mm), 0 otherwise; one log line names the value.

---
 clients/steam-frame/src/main.cpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/clients/steam-frame/src/main.cpp b/clients/steam-frame/src/main.cpp
index 8cfa52f..488eb39 100644
--- a/clients/steam-frame/src/main.cpp
+++ b/clients/steam-frame/src/main.cpp
@@ -1236,6 +1236,25 @@ static void FillHeadTracking(App& app, XrTime t, const XrView* views,
     pkt.eyeFov[1] = views[0].fov.angleRight;
     pkt.eyeFov[2] = views[0].fov.angleUp;
     pkt.eyeFov[3] = views[0].fov.angleDown;
+    // IPD (2026-10-19). The server derives the two eyes from the head pose with ITS OWN eye separation, and
+    // this field was never filled, so every wear so far rendered at the runtime's 63 mm default (Mac log
+    // "InputManager: Using default FOV/IPD ... IPD=63.0mm", never a "Quest IPD=" line). Worn, the streamed
+    // world moves more with real head translation than the WayVR keyboard, and the difference persists rather
+    // than catching up - stereo depth from the wrong separation against parallax from the true one. The two
+    // view poses from xrLocateViews are the headset's real eyes, whatever space they are located in; off the
+    // head they can be invalid, so an implausible separation sends 0 (= the server's default) instead.
+    {
+        const float dx = views[1].pose.position.x - views[0].pose.position.x;
+        const float dy = views[1].pose.position.y - views[0].pose.position.y;
+        const float dz = views[1].pose.position.z - views[0].pose.position.z;
+        const float sep = sqrtf(dx * dx + dy * dy + dz * dz);
+        pkt.ipd = (sep > 0.045f && sep < 0.085f) ? sep : 0.0f;
+        static bool ipdLogged = false;
+        if (!ipdLogged && pkt.ipd > 0.0f) {
+            ipdLogged = true;
+            LOG_INFO("IPD from xrLocateViews: %.1f mm, sent upstream (the server rendered 63.0 mm until now)", pkt.ipd * 1000.0f);
+        }
+    }
 }
 
 static void RenderFrame(App& app)
