+
+bool VideoDecoder::ReconfigureStream(int width, int height)
+{
+    // Called once the server announce tells us the encoded size, before the first NAL.
+    // The software decoders learn the size from the bitstream; the V4L2 wrapper must know
+    // it at open, so the codec is reopened with the size pre-set.
+    if (!streamMode_ || width <= 0 || height <= 0) return false;
+    if (width == expectedW_ && height == expectedH_ && codec_) return true;
+    expectedW_ = width;
+    expectedH_ = height;
+    closeInternal();
+    streamMode_ = true;
+    if (!openCodecOnly(streamCodecId_)) { closeInternal(); return false; }
+    LOG_INF("stream decoder reopened for %dx%d", width, height);
     return true;
 }
 
