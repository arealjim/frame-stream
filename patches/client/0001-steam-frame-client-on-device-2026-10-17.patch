+    REQUIRE(harness.deliveredFrames[0] == vps.ExpectedBytes());
+    REQUIRE(harness.deliveredFrames[1] == idr.ExpectedBytes());
+    REQUIRE(harness.deliveredFrames[2] == p5.ExpectedBytes());
