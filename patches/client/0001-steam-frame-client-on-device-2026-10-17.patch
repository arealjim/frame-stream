+// Mirror of yuvToRgb709Full(): BT.709 matrix, full range (no 16-235 / 16-240 scaling).
+inline Rgb8 yuvToRgb709Full(uint8_t y8, uint8_t cb8, uint8_t cr8)
+{
+    const float y  = y8 / 255.0f, cb = cb8 / 255.0f, cr = cr8 / 255.0f;
+    const float b  = cb - 128.0f / 255.0f;
+    const float r  = cr - 128.0f / 255.0f;
+    auto to8 = [](float v) {
+        return (uint8_t)std::clamp((int)(std::clamp(v, 0.0f, 1.0f) * 255.0f + 0.5f), 0, 255);
+    };
+    return { to8(y + 1.5748f * r), to8(y - 0.18733f * b - 0.46813f * r), to8(y + 1.8556f * b) };
