+// SPDX-License-Identifier: BSL-1.0
+// The NV12 path: the decoder's plane packing and the shader's BT.709 limited-range
+// conversion (through its CPU mirror, tests/yuv_rgb.h).
+#include "test_util.h"
+#include "video_decoder.h"
+#include "yuv_rgb.h"
+
+extern "C" {
+#include <libavutil/pixfmt.h>
+}
+
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+static bool near(Rgb8 c, int r, int g, int b, int tol)
+{
+    return std::abs((int)c.r - r) <= tol && std::abs((int)c.g - g) <= tol && std::abs((int)c.b - b) <= tol;
+}
+
+void test_yuv()
+{
+    SECTION("yuv: BT.709 limited range maps the video-range anchors");
+    CHECK(near(yuvToRgb709(16, 128, 128), 0, 0, 0, 0));        // video black
+    CHECK(near(yuvToRgb709(235, 128, 128), 255, 255, 255, 0)); // video white
+    CHECK(near(yuvToRgb709(126, 128, 128), 128, 128, 128, 1)); // mid grey: (126-16)/219 = 0.502
+    CHECK(near(yuvToRgb709(0, 128, 128), 0, 0, 0, 0));         // below black clamps
+    CHECK(near(yuvToRgb709(255, 128, 128), 255, 255, 255, 0)); // above white clamps
+    // BT.709 pure red: Y = 16 + 219*0.2126 = 62.6, Cb = 128 - 224*0.1146 = 102.3, Cr = 128 + 224*0.5 = 240
+    CHECK(near(yuvToRgb709(63, 102, 240), 255, 0, 0, 3));
+    // BT.709 pure blue: Y = 16 + 219*0.0722 = 31.8, Cb = 240, Cr = 128 - 224*0.0722/1.5748 = 117.7
+    CHECK(near(yuvToRgb709(32, 240, 118), 0, 0, 255, 3));
+
+    SECTION("yuv: NV12 planes are packed tightly, strides dropped");
+    {
+        const int w = 6, h = 4, cw = 3, ch = 2;
+        const int ls[2] = {16, 16};  // padded rows, as hevc_v4l2m2m hands them out
+        std::vector<uint8_t> y(ls[0] * h), uv(ls[1] * ch);
+        for (int r = 0; r < h; r++) for (int c = 0; c < w; c++) y[r * ls[0] + c] = (uint8_t)(r * 10 + c);
+        for (int r = 0; r < ch; r++) for (int c = 0; c < cw * 2; c++) uv[r * ls[1] + c] = (uint8_t)(100 + r * 10 + c);
+        const uint8_t* data[2] = {y.data(), uv.data()};
+        std::vector<uint8_t> out;
+        CHECK(VideoDecoder::PackPlanesToNv12(data, ls, AV_PIX_FMT_NV12, w, h, out));
+        CHECK(out.size() == (size_t)(w * h + cw * 2 * ch));
+        bool ok = out.size() == (size_t)(w * h + cw * 2 * ch);
+        for (int r = 0; ok && r < h; r++) for (int c = 0; c < w; c++) ok = ok && out[r * w + c] == (uint8_t)(r * 10 + c);
+        for (int r = 0; ok && r < ch; r++) for (int c = 0; c < cw * 2; c++) ok = ok && out[w * h + r * cw * 2 + c] == (uint8_t)(100 + r * 10 + c);
+        CHECK(ok);
+    }
+
+    SECTION("yuv: planar 4:2:0 (the software decoder) is interleaved into NV12");
+    {
+        const int w = 4, h = 2, cw = 2, ch = 1;
+        const int ls[3] = {8, 4, 4};
+        std::vector<uint8_t> y(ls[0] * h, 7), u(ls[1] * ch), v(ls[2] * ch);
+        u[0] = 10; u[1] = 11; v[0] = 20; v[1] = 21;
+        const uint8_t* data[3] = {y.data(), u.data(), v.data()};
+        std::vector<uint8_t> out;
+        CHECK(VideoDecoder::PackPlanesToNv12(data, ls, AV_PIX_FMT_YUV420P, w, h, out));
+        CHECK(out.size() == (size_t)(w * h + cw * 2 * ch));
+        CHECK(out.size() == 12 && out[0] == 7 && out[8] == 10 && out[9] == 20 && out[10] == 11 && out[11] == 21);
+    }
+
+    SECTION("yuv: other pixel formats are refused (the RGBA path takes them)");
+    {
+        const int ls[1] = {4};
+        std::vector<uint8_t> px(16);
+        const uint8_t* data[1] = {px.data()};
+        std::vector<uint8_t> out;
+        CHECK(!VideoDecoder::PackPlanesToNv12(data, ls, AV_PIX_FMT_RGBA, 1, 1, out));
+    }
