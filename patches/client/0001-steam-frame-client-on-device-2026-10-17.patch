From 0bb4d3a182be4c7844072e41384c3872001ea91e Mon Sep 17 00:00:00 2001
From: arealjim <6187715+arealjim@users.noreply.github.com>
Date: Sat, 17 Oct 2026 19:06:44 +0000
Subject: [PATCH 07/21] steam-frame: measured latency report; honour a
 full-range stream

The latency report the server feeds its adaptive bitrate was half a picture:
the decode CALL time as "decode", the eye pass as "compositor", zero for
receive-to-submit and displayed age. Every field is now measured per access
unit - received, avcodec_send_packet, frame out, picked up by the render
thread, both eyes released - averaged over 72 presented frames; displayed
frame age counts repaints; stale reuses and render-pose fallbacks are
counted; mode is Pose. A "client pipeline:" log line every fourth report.

Range: the shader converts BT.709 full range when the frame says so or
FRAME_CLIENT_FULL_RANGE=1, for a server that skips its video-range
conversion (encoder_full_range). hevc_v4l2m2m reports the range as unknown
whatever the VUI carries (measured), so the override is the working path;
the decoder log line says what it saw and what was chosen. CPU mirror and
tests for the full-range matrix.

---
 clients/steam-frame/shaders/sample.frag       | 12 +++-
 clients/steam-frame/src/main.cpp              | 69 ++++++++++++++++---
 clients/steam-frame/src/stream_connection.cpp | 10 +--
 clients/steam-frame/src/stream_connection.h   |  5 +-
 clients/steam-frame/src/video_decoder.cpp     | 35 +++++++++-
 clients/steam-frame/src/video_decoder.h       | 20 +++++-
 clients/steam-frame/tests/test_yuv.cpp        |  9 +++
 clients/steam-frame/tests/yuv_rgb.h           | 12 ++++
 8 files changed, 148 insertions(+), 24 deletions(-)

diff --git a/clients/steam-frame/shaders/sample.frag b/clients/steam-frame/shaders/sample.frag
index 36f4718..6b5f492 100644
--- a/clients/steam-frame/shaders/sample.frag
+++ b/clients/steam-frame/shaders/sample.frag
@@ -17,6 +17,7 @@ layout(push_constant) uniform Push {
     vec2 eyeSizeRatio;   // optimized/aligned padding compensation
     int  foveated;       // 0 = plain SBS sampling
     int  nv12;           // 1 = binding 0 is luma, binding 1 chroma; convert here
+    int  fullRange;      // 1 = the stream signals full range (encoder_full_range): no 16-235 scaling
 } pc;
 
 // Axis-aligned foveated-encoding forward map (matches oxrsys / ALVR AADT).
@@ -66,11 +67,20 @@ vec3 yuvToRgb709(float y, float cb, float cr) {
                       yl + 1.8556 * b), 0.0, 1.0);
 }
 
+// Same matrix, full range (Y 0-255, C centred on 128 with no 224 scaling): what a
+// VideoToolbox rtvc/software session writes from BGRA when the server skips its
+// conversion (encoder_full_range). CPU mirror: tests/yuv_rgb.h yuvToRgb709Full.
+vec3 yuvToRgb709Full(float y, float cb, float cr) {
+    float b = cb - 128.0 / 255.0;
+    float r = cr - 128.0 / 255.0;
+    return clamp(vec3(y + 1.5748 * r, y - 0.18733 * b - 0.46813 * r, y + 1.8556 * b), 0.0, 1.0);
+}
+
