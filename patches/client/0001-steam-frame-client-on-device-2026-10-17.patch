+        LOG_INF("access units: %s", parserHold_ ? "through av_parser, which holds each frame until the next arrives (FRAME_CLIENT_PARSER_HOLD)"
+                                                 : "assembled here, each slice sent to the decoder in the call that brought it");
+    }
+    if (submitCalls_ % 900 == 0)
+        LOG_INF("access units: %llu of %llu submits sent their own frame to the decoder in the same call, %llu a call later",
