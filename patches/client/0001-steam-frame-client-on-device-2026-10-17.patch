     if (pc.nv12 == 0) return texture(uVideo, uv).rgb;
     float y = texture(uVideo, uv).r;
     vec2 c = texture(uChroma, uv).rg;
-    return yuvToRgb709(y, c.x, c.y);
+    return pc.fullRange != 0 ? yuvToRgb709Full(y, c.x, c.y) : yuvToRgb709(y, c.x, c.y);
 }
 
