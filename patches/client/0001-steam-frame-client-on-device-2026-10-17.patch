From 1dc1ef0abd76ea599fec597ff0c64c4eb0d48a0f Mon Sep 17 00:00:00 2001
From: arealjim <6187715+arealjim@users.noreply.github.com>
Date: Sat, 17 Oct 2026 15:18:26 +0000
Subject: [PATCH 02/21] steam-frame client: keyframe-on-drop + render-pose
 tolerance match (fix view shake)

- request an IDR (KEYFRAME_REASON_FRAME_LOSS) when the receiver abandons a frame,
  so a lossy link does not stay corrupted until the next 2s keyframe (cut smearing)
- match a decoded frame to its render pose by nearest-within-7ms instead of exact
  microsecond equality: hardware (v4l2m2m) PTS rounding missed ~22% of frames, and a
  missed frame was presented with a STALE pose that SteamVR reprojected into a shake;
  miss rate measured 22% -> 0 after the change
- on a match miss, fall back to the newest render pose, never a frozen cached one

---
 clients/steam-frame/src/NetworkReceiver.cpp   | 35 ++++++++++++++-----
 clients/steam-frame/src/NetworkReceiver.h     |  4 +++
 clients/steam-frame/src/main.cpp              | 25 +++++++++----
 clients/steam-frame/src/stream_connection.cpp | 10 ++++++
 clients/steam-frame/src/stream_connection.h   |  3 ++
 5 files changed, 63 insertions(+), 14 deletions(-)

diff --git a/clients/steam-frame/src/NetworkReceiver.cpp b/clients/steam-frame/src/NetworkReceiver.cpp
index 571be22..33e23c2 100644
--- a/clients/steam-frame/src/NetworkReceiver.cpp
+++ b/clients/steam-frame/src/NetworkReceiver.cpp
@@ -274,6 +274,7 @@ void NetworkReceiver::WireAssemblerCallbacks()
             // Send NACK for missing packets (server may retransmit from cache)
             SendNack(frame.frameIndex, frame.totalPackets, frame.packetReceived);
 
+            needKeyframe_.store(true);
             uint32_t dropped = framesDropped_.fetch_add(1) + 1;
             if (dropped <= 5 || dropped % 100 == 0)
             {
@@ -527,21 +528,39 @@ bool NetworkReceiver::TakeRenderPoseForPresentationTimeUs(int64_t presentationTi
 {
     std::lock_guard<std::mutex> lock(renderPoseMutex_);
 
+    // Match the render pose to the decoded frame by presentation time. An exact match is ideal,
+    // but a hardware decoder (v4l2m2m) can hand back a PTS rounded a microsecond off what the
+    // server stamped, so an equality test missed ~22% of frames — and a missed frame was then
+    // presented with a STALE pose, which SteamVR reprojects wrongly: that is the view shake.
+    // Take the nearest pose within half a frame interval (72 Hz -> 13.89 ms, tolerance ~7 ms).
+    constexpr int64_t kMatchToleranceUs = 7000;
