 }
 
+// NV12 -> RGB, BT.709 limited range: what the stream's VUI says it is (the server
+// signals BT.709 primaries/matrix and video range, EncoderSessionColor.h). The
+// decoded planes arrive untouched from the decoder; this is the only conversion.
+// CPU mirror + test: tests/yuv_rgb.h (keep the two in sync).
+vec3 yuvToRgb709(float y, float cb, float cr) {
+    float yl = (y  - 16.0 / 255.0) * (255.0 / 219.0);
+    float b  = (cb - 128.0 / 255.0) * (255.0 / 224.0);
+    float r  = (cr - 128.0 / 255.0) * (255.0 / 224.0);
+    return clamp(vec3(yl + 1.5748 * r,
+                      yl - 0.18733 * b - 0.46813 * r,
+                      yl + 1.8556 * b), 0.0, 1.0);
+}
+
+vec3 sampleVideo(vec2 uv) {
+    if (pc.nv12 == 0) return texture(uVideo, uv).rgb;
+    float y = texture(uVideo, uv).r;
+    vec2 c = texture(uChroma, uv).rg;
+    return yuvToRgb709(y, c.x, c.y);
+}
