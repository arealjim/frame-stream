+
+    // Frame-native buttons: one boolean action per input component, read per hand.
+    struct FrameButton {
+        const char* component;      // e.g. "a/click", "dpad_up/touch"
+        int hand;                   // 0 left, 1 right, -1 both
+        uint32_t bit;               // ButtonFlags bit (for a /touch component: its bit in touchState)
+        uint32_t bitRight;          // bit for the right hand when hand == -1
+        bool touch;
+        XrAction action;
+    };
+    bool frameController_ = false;
+    FrameButton* frameButtons_ = nullptr;
+    int frameButtonCount_ = 0;
+    // Which hands SteamVR currently reports on the Frame profile; re-read on
+    // XR_TYPE_EVENT_DATA_INTERACTION_PROFILE_CHANGED (ProfileChanged()) and once a second.
+    bool frameProfileActive_[2] = {false, false};
+    XrPath frameProfilePath_ = XR_NULL_PATH;
+    int profilePollFrames_ = 0;
+    void RefreshProfiles();
 
     bool handTracking_ = false;
     XrHandTrackerEXT handTracker_[2] = {XR_NULL_HANDLE, XR_NULL_HANDLE};
diff --git a/common/protocol/include/oxrsys/protocol/Protocol.h b/common/protocol/include/oxrsys/protocol/Protocol.h
