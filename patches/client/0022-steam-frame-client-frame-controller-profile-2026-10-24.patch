 }
 
+void XrInput::RefreshProfiles()
+{
+    for (int h = 0; h < 2; h++) {
+        XrInteractionProfileState st = {XR_TYPE_INTERACTION_PROFILE_STATE};
+        if (XR_FAILED(xrGetCurrentInteractionProfile(session_, handPath_[h], &st))) continue;
+        const bool frame = frameProfilePath_ != XR_NULL_PATH && st.interactionProfile == frameProfilePath_;
+        static XrPath logged[2] = {XR_NULL_PATH, XR_NULL_PATH};
+        static bool loggedOnce[2] = {false, false};
+        if (!loggedOnce[h] || st.interactionProfile != logged[h]) {
+            loggedOnce[h] = true;
+            logged[h] = st.interactionProfile;
+            char name[XR_MAX_PATH_LENGTH] = "none";
+            uint32_t n = 0;
+            if (st.interactionProfile != XR_NULL_PATH)
+                xrPathToString(instance_, st.interactionProfile, sizeof(name), &n, name);
+            LOG_INF("%s hand interaction profile: %s", h ? "right" : "left", name);
+        }
+        frameProfileActive_[h] = frame;
+    }
+}
+
+// The Touch emulation's meaning of the Frame's buttons, as SteamVR's own remap gives it
+// (frame_controller_remapping.json, oculus_touch layout): A = A, B = B|X|Y, X = d-pad down,
+// Y = the other three directions. Keeps a server that knows only Touch working unchanged.
+static uint32_t TouchCompatBits(uint32_t m)
+{
+    using namespace protocol;
+    uint32_t out = 0;
+    if (m & BUTTON_FRAME_A) out |= BUTTON_A;
+    if (m & (BUTTON_FRAME_B | BUTTON_FRAME_X | BUTTON_FRAME_Y)) out |= BUTTON_B;
+    if (m & BUTTON_FRAME_DPAD_DOWN) out |= BUTTON_X;
+    if (m & (BUTTON_FRAME_DPAD_UP | BUTTON_FRAME_DPAD_LEFT | BUTTON_FRAME_DPAD_RIGHT)) out |= BUTTON_Y;
+    return out;
+}
+
 void XrInput::Update(XrTime displayTime, protocol::TrackingPacket& pkt)
 {
     if (!actionSet_) return;
 
+    if (frameController_ && --profilePollFrames_ < 0) {
+        RefreshProfiles();
+        profilePollFrames_ = 90;   // about once a second
+    }
+
     XrActiveActionSet active = {actionSet_, XR_NULL_PATH};
     XrActionsSyncInfo si = {XR_TYPE_ACTIONS_SYNC_INFO};
     si.countActiveActionSets = 1;
@@ -200,6 +333,27 @@ void XrInput::Update(XrTime displayTime, protocol::TrackingPacket& pkt)
             }
         }
 
+        // Aim pose: where the controller points. On the Frame it is ~40 degrees from the grip's -Z,
+        // so a ray built from the grip misses. Left zero when unavailable: the server falls back to grip.
+        float* aimPos[2] = {pkt.leftControllerAimPos, pkt.rightControllerAimPos};
+        float* aimRot[2] = {pkt.leftControllerAimRot, pkt.rightControllerAimRot};
+        gi.action = aimAction_;
+        XrActionStatePose as = {XR_TYPE_ACTION_STATE_POSE};
+        if (aimSpace_[h] && XR_SUCCEEDED(xrGetActionStatePose(session_, &gi, &as)) && as.isActive) {
+            XrSpaceLocation loc = {XR_TYPE_SPACE_LOCATION};
+            if (XR_SUCCEEDED(xrLocateSpace(aimSpace_[h], baseSpace_, displayTime, &loc)) &&
+                (loc.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) &&
+                (loc.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT)) {
+                aimPos[h][0] = loc.pose.position.x;
+                aimPos[h][1] = loc.pose.position.y;
+                aimPos[h][2] = loc.pose.position.z;
+                aimRot[h][0] = loc.pose.orientation.x;
+                aimRot[h][1] = loc.pose.orientation.y;
+                aimRot[h][2] = loc.pose.orientation.z;
+                aimRot[h][3] = loc.pose.orientation.w;
+            }
+        }
+
         auto getFloat = [&](XrAction a, float* out) {
             gi.action = a;
             XrActionStateFloat s = {XR_TYPE_ACTION_STATE_FLOAT};
@@ -223,6 +377,21 @@ void XrInput::Update(XrTime displayTime, protocol::TrackingPacket& pkt)
         if (getBool(primaryAction_)) pkt.buttonState |= primaryBit[h];
         if (getBool(secondaryAction_)) pkt.buttonState |= secondaryBit[h];
         if (*trig[h] > 0.6f) pkt.buttonState |= trigBit[h];
+
+        if (frameProfileActive_[h]) {
+            for (int i = 0; i < frameButtonCount_; i++) {
+                const FrameButton& fb = frameButtons_[i];
+                if (fb.hand != -1 && fb.hand != h) continue;
+                if (!getBool(fb.action)) continue;
+                const uint32_t bit = (fb.hand == -1 && h == 1) ? fb.bitRight : fb.bit;
+                (fb.touch ? pkt.touchState : pkt.buttonState) |= bit;
+            }
+        }
+    }
+    if (frameProfileActive_[0] || frameProfileActive_[1]) {
+        pkt.controllerProfile = protocol::CONTROLLER_PROFILE_VALVE_FRAME;
+        pkt.buttonState |= TouchCompatBits(pkt.buttonState);
+        pkt.touchState |= TouchCompatBits(pkt.touchState);
     }
 
     // Eye gaze: locate the gaze pose; forward direction = -Z rotated by the pose.
@@ -322,6 +491,7 @@ void XrInput::Destroy()
     for (int h = 0; h < 2; h++) {
         if (handTracker_[h] && pfnDestroyHandTracker_) pfnDestroyHandTracker_(handTracker_[h]);
         if (poseSpace_[h]) xrDestroySpace(poseSpace_[h]);
+        if (aimSpace_[h]) xrDestroySpace(aimSpace_[h]);
     }
     if (gazeSpace_) xrDestroySpace(gazeSpace_);
     if (actionSet_) xrDestroyActionSet(actionSet_);
diff --git a/clients/steam-frame/src/xr_input.h b/clients/steam-frame/src/xr_input.h
