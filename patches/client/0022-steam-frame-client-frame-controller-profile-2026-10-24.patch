+    // The Frame's own profile. Through the Touch emulation SteamVR folds right B, X and Y into one
+    // button and three of the left d-pad's four directions into another, and drops the bumper into
+    // the trigger; bound natively, every input arrives on its own. SteamVR prefers a native binding,
+    // so with this one suggested the Touch bindings above go idle on the Frame.
+    if (frameController) {
+        using namespace protocol;
+        static FrameButton buttons[] = {
+            {"a/click", 1, BUTTON_FRAME_A, 0, false, XR_NULL_HANDLE},
+            {"a/touch", 1, BUTTON_FRAME_A, 0, true, XR_NULL_HANDLE},
+            {"b/click", 1, BUTTON_FRAME_B, 0, false, XR_NULL_HANDLE},
+            {"b/touch", 1, BUTTON_FRAME_B, 0, true, XR_NULL_HANDLE},
+            {"x/click", 1, BUTTON_FRAME_X, 0, false, XR_NULL_HANDLE},
+            {"x/touch", 1, BUTTON_FRAME_X, 0, true, XR_NULL_HANDLE},
+            {"y/click", 1, BUTTON_FRAME_Y, 0, false, XR_NULL_HANDLE},
+            {"y/touch", 1, BUTTON_FRAME_Y, 0, true, XR_NULL_HANDLE},
+            {"menu/click", 1, BUTTON_FRAME_RIGHT_MENU, 0, false, XR_NULL_HANDLE},
+            {"menu/touch", 1, BUTTON_FRAME_RIGHT_MENU, 0, true, XR_NULL_HANDLE},
+            {"dpad_up/click", 0, BUTTON_FRAME_DPAD_UP, 0, false, XR_NULL_HANDLE},
+            {"dpad_up/touch", 0, BUTTON_FRAME_DPAD_UP, 0, true, XR_NULL_HANDLE},
+            {"dpad_down/click", 0, BUTTON_FRAME_DPAD_DOWN, 0, false, XR_NULL_HANDLE},
+            {"dpad_down/touch", 0, BUTTON_FRAME_DPAD_DOWN, 0, true, XR_NULL_HANDLE},
+            {"dpad_left/click", 0, BUTTON_FRAME_DPAD_LEFT, 0, false, XR_NULL_HANDLE},
+            {"dpad_left/touch", 0, BUTTON_FRAME_DPAD_LEFT, 0, true, XR_NULL_HANDLE},
+            {"dpad_right/click", 0, BUTTON_FRAME_DPAD_RIGHT, 0, false, XR_NULL_HANDLE},
+            {"dpad_right/touch", 0, BUTTON_FRAME_DPAD_RIGHT, 0, true, XR_NULL_HANDLE},
+            {"view/click", 0, BUTTON_MENU, 0, false, XR_NULL_HANDLE},
+            {"view/touch", 0, BUTTON_MENU, 0, true, XR_NULL_HANDLE},
+            {"bumper/click", -1, BUTTON_LEFT_BUMPER, BUTTON_RIGHT_BUMPER, false, XR_NULL_HANDLE},
+            {"bumper/touch", -1, BUTTON_LEFT_BUMPER, BUTTON_RIGHT_BUMPER, true, XR_NULL_HANDLE},
+            {"squeeze/click", -1, BUTTON_LEFT_GRIP, BUTTON_RIGHT_GRIP, false, XR_NULL_HANDLE},
+            {"squeeze/touch", -1, BUTTON_LEFT_GRIP, BUTTON_RIGHT_GRIP, true, XR_NULL_HANDLE},
+            {"trigger/click", -1, BUTTON_LEFT_TRIGGER, BUTTON_RIGHT_TRIGGER, false, XR_NULL_HANDLE},
+            {"trigger/touch", -1, BUTTON_LEFT_TRIGGER, BUTTON_RIGHT_TRIGGER, true, XR_NULL_HANDLE},
+            {"thumbstick/click", -1, BUTTON_LEFT_THUMBSTICK, BUTTON_RIGHT_THUMBSTICK, false, XR_NULL_HANDLE},
+            {"thumbstick/touch", -1, BUTTON_LEFT_THUMBSTICK, BUTTON_RIGHT_THUMBSTICK, true, XR_NULL_HANDLE},
+        };
+        const char* handName[2] = {"left", "right"};
+        std::vector<std::string> paths;   // keeps the strings alive until the suggest call
+        std::vector<std::pair<XrAction, size_t>> pending;
+        bool ok = true;
+        for (FrameButton& fb : buttons) {
+            char name[XR_MAX_ACTION_NAME_SIZE];
+            snprintf(name, sizeof(name), "frame_%s", fb.component);
+            for (char* c = name; *c; c++) if (*c == '/') *c = '_';
+            if (!mkAction(name, XR_ACTION_TYPE_BOOLEAN_INPUT, &fb.action)) { ok = false; break; }
+            for (int h = 0; h < 2; h++) {
+                if (fb.hand != -1 && fb.hand != h) continue;
+                paths.push_back(std::string("/user/hand/") + handName[h] + "/input/" + fb.component);
+                pending.push_back({fb.action, paths.size() - 1});
+            }
+        }
+        if (ok) {
+            std::vector<XrActionSuggestedBinding> b = {
+                B(poseAction_, "/user/hand/left/input/grip/pose"),
+                B(poseAction_, "/user/hand/right/input/grip/pose"),
+                B(aimAction_, "/user/hand/left/input/aim/pose"),
+                B(aimAction_, "/user/hand/right/input/aim/pose"),
+                B(triggerAction_, "/user/hand/left/input/trigger/value"),
+                B(triggerAction_, "/user/hand/right/input/trigger/value"),
+                B(squeezeAction_, "/user/hand/left/input/squeeze/value"),
+                B(squeezeAction_, "/user/hand/right/input/squeeze/value"),
+                B(thumbAction_, "/user/hand/left/input/thumbstick"),
+                B(thumbAction_, "/user/hand/right/input/thumbstick"),
+            };
+            for (const auto& pa : pending) b.push_back(B(pa.first, paths[pa.second].c_str()));
+            XrInteractionProfileSuggestedBinding sb = {XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+            sb.interactionProfile = frameProfilePath_ = path(instance, kFrameProfile);
+            sb.countSuggestedBindings = (uint32_t)b.size();
+            sb.suggestedBindings = b.data();
+            const XrResult r = xrSuggestInteractionProfileBindings(instance, &sb);
+            if (XR_SUCCEEDED(r)) {
+                frameController_ = true;
+                frameButtons_ = buttons;
+                frameButtonCount_ = (int)(sizeof(buttons) / sizeof(buttons[0]));
+            } else {
+                LOG_ERR("Frame controller bindings refused (%d): staying on the Touch emulation", (int)r);
+            }
+        } else {
+            LOG_ERR("Frame controller actions not created: staying on the Touch emulation");
+        }
+    }
+
     XrSessionActionSetsAttachInfo ai = {XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO};
     ai.countActionSets = 1;
     ai.actionSets = &actionSet_;
@@ -123,6 +214,8 @@ bool XrInput::Init(XrInstance instance, XrSession session, XrSpace baseSpace,
         sci.subactionPath = handPath_[h];
         sci.poseInActionSpace.orientation.w = 1.0f;
